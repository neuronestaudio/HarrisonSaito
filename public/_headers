# Cloudflare Pages / Netlify response headers.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Fingerprinted build output is immutable.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Media is content-addressed by filename in practice — long cache, and a rename
# is the invalidation mechanism.
/img/*
  Cache-Control: public, max-age=31536000, immutable

/video/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# HTML revalidates so content edits go live immediately.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
