---
/**
 * /rts-coaching (was /workshop until 11 Nov 2026; 301 in vercel.json) — the three-seat room. Where the ads land, and the lead magnet.
 *
 * Dion, 25 Sep 2026: the twelve weeks are the thing we sell and the thing
 * nobody cold will buy off a page. So the ads go here instead — an in-person
 * workshop for three people, the three being the point: small enough to be
 * honest in, small enough that you actually meet him. The page sells a seat,
 * and only a seat. The twelve weeks are mentioned as what the room is a
 * taste of, and never pitched.
 *
 * Second cut, same day. "Way too easy": the seat is applied for now, with one
 * optional line in their words, and a call before it is confirmed. "Land them
 * from the six squares onwards": the page opens on the ink — his gi portrait,
 * the title, and the same "who this is for" panel as the home page with the
 * workshop's own six (WhoFor.astro) — then the pills, then the room itself,
 * then who is holding it, the words, the answers, and the application last.
 *
 * Bare (no nav, no footer): one way in, one way through, one thing to do.
 * Every word is src/data/workshop.ts, where what is not yet known (date,
 * length, price) is null and renders as "to be confirmed" rather than a guess.
 *
 * Indexable, unlike /lp/: it duplicates nothing, and someone who saw the ad
 * and searched for it should find it.
 */
import Base from '../layouts/Base.astro';
import MoShell from '../components/MoShell.astro';
import DiscoveryFunnel from '../components/DiscoveryFunnel.astro';
import GainPills from '../components/GainPills.astro';
import TestimonyFilms from '../components/TestimonyFilms.astro';
import { src, srcset } from '../lib/images';
import { forYouIcon } from '../lib/morel-icons';
import { PROOF, SITE } from '../data/site';
import { graph, personSchema, localBusinessSchema } from '../lib/seo';
import { DETAILS, WHEN_LINE, HERO, EXPLAIN, MOMENTS, GAINS_INTRO, ROOM, WHO, ANSWERS, APPLY, FORM } from '../data/workshop';

const title = 'Private Coaching — 1:1 with Harrison Saito | Chatswood, Sydney';
const description =
  '1:1 Private Coaching with Harrison Saito: forty-five minutes on one relationship and one recent moment. Pause, recognise, choose. $60, with a full refund if it is not for you by the end. Chatswood, Sydney.';
const schema = graph(personSchema(), localBusinessSchema());
---

<Base title={title} description={description} path="/rts-coaching" image="/img/workshop-og-v1.webp" schema={schema} bare>
  <MoShell modal={false}>
    <!-- ============ THE FOLD: him, the room, the way in ============ -->
    <section class="section section--dark on-dark ws-hero" data-section="ws-hero">
      <div class="wide ws-hero__grid">
        <div class="ws-hero__copy">
          <p class="eyebrow ws-hero__eyebrow">{HERO.eyebrow}</p>
          <h1 set:html={HERO.title} />
          <p class="lede ws-hero__lede">{HERO.lede}</p>
          <div class="ws-hero__ctas">
            <a class="btn btn--filled btn--wide" href={HERO.cta.href} data-track="cta_click" data-track-label={`Workshop — ${HERO.cta.label} (hero)`}>{HERO.cta.label}</a>
            <div class="ws-hero__links">
              <a class="ws-hero__more" href={HERO.more.href}>{HERO.more.label}<span aria-hidden="true">↓</span></a>
              <a class="ws-hero__more" href="/testimonials" data-track="cta_click" data-track-label="Private coaching — How it felt (hero)">How it felt, in their words<span aria-hidden="true">→</span></a>
            </div>
          </div>
          <p class="ws-when"><span class="ws-when__dot" aria-hidden="true"></span>{WHEN_LINE}</p>
        </div>
        <figure class="ws-hero__portrait ws-hero__film reveal reveal--fade">
          <video src={HERO.film.src} poster={HERO.film.poster} aria-label={HERO.film.title} controls preload="none" playsinline data-track-film="ws-involved"></video>
        </figure>
      </div>
    </section>

    <!-- ============ RECOGNITION: the everyday moments ============ -->
    <section class="section section--white ws-moments" id="who-benefits" data-section="ws-moments">
      <div class="wide ws-moments__grid">
        <header class="ws-head">
          <p class="eyebrow">{MOMENTS.eyebrow}</p>
          <h2 class="reveal" set:html={MOMENTS.title} />
        </header>
        <ul class="ws-facts ws-facts--moments reveal">
          {MOMENTS.list.map((m) => (
            <li>
              <Fragment set:html={forYouIcon(m.icon)} />
              <span>{m.text}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============ THE SECOND FILM: you can't change what happens ============ -->
    <section class="section section--dark on-dark ws-film" data-section="ws-explain">
      <div class="wide">
        <header class="ws-head ws-head--film">
          <h2 class="reveal" set:html={EXPLAIN.title} />
          <p class="lede reveal">{EXPLAIN.lead}</p>
        </header>
        <div class="ws-film__frame reveal reveal--fade">
          <video src={EXPLAIN.film.src} poster={EXPLAIN.film.poster} aria-label={EXPLAIN.film.title} controls preload="none" playsinline data-track-film="ws-explain"></video>
        </div>
      </div>
    </section>

    <!-- ============ THE PILLS: what people walk away with ============ -->
    <section class="section section--bg4 ws-gains" data-section="ws-gains">
      <div class="wide">
        <header class="ws-head ws-head--split">
          <div>
            <p class="eyebrow">{GAINS_INTRO.eyebrow}</p>
            <h2 class="reveal" set:html={GAINS_INTRO.title} />
          </div>
          <p class="fs-sm ws-lede reveal reveal--left">{GAINS_INTRO.lede}</p>
        </header>
        <p class="ws-more reveal"><a href={GAINS_INTRO.more.href} data-track="cta_click" data-track-label="Workshop — testimonials link">{GAINS_INTRO.more.label}<span aria-hidden="true"> →</span></a></p>
        <GainPills />
      </div>
    </section>

    <!-- ============ WHAT HAPPENS IN THE ROOM ============ -->
    <section class="section section--white ws-room" id="room" data-section="ws-room">
      <div class="wide ws-room__layout">
        <div class="ws-room__photos ws-bento reveal reveal--fade">
          {ROOM.photos.map((ph) => (
            <img
              class={`ws-bento__${ph.cell}`}
              src={`/img/${ph.slug}-${ph.w}.webp`}
              srcset={srcset(ph.slug) || undefined}
              sizes="(max-width: 900px) 46vw, 18vw"
              alt={ph.alt}
              width="800"
              height="1066"
              loading="lazy"
              decoding="async"
              style={`object-position:${ph.pos}`}
            />
          ))}
        </div>

        <div class="ws-room__body">
          <header class="ws-head">
            <p class="eyebrow">{ROOM.eyebrow}</p>
            <h2 class="reveal" set:html={ROOM.title} />
            <p class="fs-sm ws-lede reveal">{ROOM.lede}</p>
          </header>

          <ol class="ws-moves" data-stagger>
            {ROOM.movements.map((m) => (
              <li class="ws-move reveal">
                <p class="ws-move__key"><span>{m.n}</span> {m.key}</p>
                <h3>{m.title}</h3>
                <p>{m.body}</p>
                {m.his && (
                  <blockquote class="ws-his">
                    <p>“{m.his.quote}”</p>
                    <cite>{m.his.source}</cite>
                  </blockquote>
                )}
              </li>
            ))}
          </ol>

          <div class="ws-leave reveal">
            <p class="ws-leave__lead">{ROOM.leave.lead}</p>
            <p class="fs-sm ws-leave__body">{ROOM.leave.body}</p>
            <p class="ws-leave__eg">{ROOM.leave.exampleLabel}</p>
            <dl class="ws-leave__ex">
              {ROOM.leave.example.map((e) => <div><dt>{e.label}</dt><dd>{e.text}</dd></div>)}
            </dl>
          </div>

          <ul class="ws-facts reveal">
            {ROOM.facts.map((f) => <li>{f}</li>)}
          </ul>

          <div class="ws-room__foot reveal">
            <p class="fs-xs ws-note">{ROOM.note}</p>
            <a class="btn btn--filled btn--wide" href="#apply" data-track="cta_click" data-track-label="Workshop — Apply for a session (room)">{HERO.cta.label}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ WHO IS HOLDING THE ROOM ============ -->
    <section class="section section--dark on-dark ws-who" data-section="ws-who">
      <div class="wide ws-who__grid">
        <figure class="ws-who__portrait reveal reveal--fade">
          <img
            src={src(WHO.portrait)}
            srcset={srcset(WHO.portrait) || undefined}
            sizes="(max-width: 900px) 100vw, 40vw"
            alt={WHO.portraitAlt}
            width="768"
            height="960"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="ws-who__text">
          <p class="eyebrow">{WHO.eyebrow}</p>
          <h2 class="reveal" set:html={WHO.title} />
          <ul class="ws-creds reveal">
            {WHO.lines.map((l) => <li>{l}</li>)}
          </ul>
          <div class="deets__row lp-proofrow reveal">
            {PROOF.map((p) => <span class="pill">{p.value}</span>)}
          </div>
          <blockquote class="ws-his ws-his--dark reveal">
            <p>“{WHO.his.quote}”</p>
            <cite>{WHO.his.source}</cite>
          </blockquote>
          <p class="fs-sm ws-who__after reveal">{WHO.his.after}</p>
        </div>
      </div>
    </section>

    <!-- ============ IN THEIR WORDS: the two films, who he is and what he teaches ============ -->
    <TestimonyFilms eyebrow="In their words" />

    <!-- ============ STRAIGHT ANSWERS ============ -->
    <section class="section section--bg4 ws-faq" data-section="ws-faq">
      <div class="wide ws-faq__grid">
        <header class="ws-head">
          <p class="eyebrow">Straight answers</p>
          <h2 class="reveal">Before you <mark>apply.</mark></h2>
        </header>
        <div class="faq__list reveal reveal--fade">
          {ANSWERS.map((f, i) => (
            <details class="faq__item" open={i === 0 ? true : undefined}>
              <summary>
                <span>{f.q}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path class="faq__v" d="M12 5v14"/><path d="M5 12h14"/></svg>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ THE APPLICATION ============ -->
    <section class="section section--dark on-dark ws-apply" id="apply" data-section="ws-apply">
      <div class="wide ws-apply__grid">
        <div class="ws-apply__copy">
          <p class="eyebrow">{APPLY.eyebrow}</p>
          <h2 class="reveal" set:html={APPLY.title} />
          <p class="fs-sm ws-apply__body reveal">{APPLY.body}</p>
        </div>
        <div class="ws-apply__form">
          <DiscoveryFunnel />
        </div>
      </div>
    </section>

    <footer class="section section--flush lp-foot">
      <div class="wide">
        <p class="fs-xs">&copy; {new Date().getFullYear()} Harrison Saito · {SITE.locality}, {SITE.region}</p>
        <nav class="deets__row" aria-label="Legal">
          <a href="/privacy">Privacy Policy</a>
          <a href="/terms">Terms</a>
          <a href="/">Full site</a>
        </nav>
      </div>
    </footer>
  </MoShell>
</Base>

<style>
  /* ---- the fold ---------------------------------------------------------
     Ink, him in the gi to the right, the words and the way in to the left.
     The six squares continue the same ground directly underneath. */
  .ws-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(3rem, 6vw, 5.5rem) clamp(2rem, 4vw, 3.5rem);
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }
  .ws-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(70% 60% at 78% 20%, rgba(218, 162, 79, 0.2) 0%, rgba(218, 162, 79, 0.06) 45%, rgba(218, 162, 79, 0) 78%);
  }
  .ws-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.6rem, 4vw, 4.5rem);
    align-items: center;
  }
  .ws-hero__eyebrow { color: rgba(252, 250, 248, 0.82); }
  .ws-hero :global(h1) { font-size: clamp(2.3rem, 1.4rem + 3.2vw, 4.4rem); line-height: 1.04; max-width: 18ch; margin: 0 0 var(--sp-40); }
  .ws-hero :global(h1 mark) { background: var(--grad-text-dark); background-clip: text; -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  /* the first three headings read in sentence case, not capitals (client: "too salesy and screaming") */
  .ws-hero :global(h1), .ws-moments :global(h2), .ws-head--film :global(h2) { text-transform: none; letter-spacing: -0.01em; }
  .ws-hero__lede { max-width: 52ch; margin: 0 0 var(--sp-50); color: rgba(252, 250, 248, 0.86); }
  .ws-hero__ctas { display: flex; flex-direction: column; align-items: flex-start; gap: 1.3rem; margin-bottom: var(--sp-50); }
  .ws-hero__links { display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem 2.2rem; }
  .ws-hero__more {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    color: #f2c275;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid rgba(242, 194, 117, 0.42);
    padding-bottom: 2px;
  }
  .ws-hero__more:hover { color: #fcfaf8; border-color: #fcfaf8; }
  .ws-hero__portrait {
    margin: 0;
    justify-self: end;
    width: min(100%, 460px);
    aspect-ratio: 2 / 3;
    border-radius: 26px;
    overflow: hidden;
    border: 1px solid rgba(242, 194, 117, 0.3);
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.55);
    background: #1c1714;
  }
  .ws-hero__portrait img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; display: block; }

  .ws-when {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0.55rem 0.95rem 0.55rem 0.8rem;
    border: 1px solid rgba(242, 194, 117, 0.35);
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 700;
    color: #f2c275;
    background: rgba(20, 16, 13, 0.35);
  }
  .ws-when__dot { width: 8px; height: 8px; border-radius: 50%; background: #f2c275; box-shadow: 0 0 0 4px rgba(242, 194, 117, 0.18); flex: none; }

  /* ---- heads ---- */
  .ws-head { max-width: 900px; margin-bottom: clamp(1.6rem, 3vw, 3rem); }
  .ws-head :global(h2) { margin: 0; max-width: 22ch; }
  .ws-head--split {
    max-width: none;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(1rem, 4vw, 4rem);
    align-items: end;
  }
  .ws-lede { margin: 0; color: var(--fg4); max-width: 50ch; }

  /* ---- the room: four movements ---- */
  .ws-moves { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(14px, 2vw, 30px); }
  .ws-move { border-top: 2px solid var(--fg1); padding-top: clamp(14px, 1.6vw, 22px); min-width: 0; }
  .ws-room__layout { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  /* bento: two columns, six rows. a = wide lead, b = tall, c + d = a stacked pair, e = wide close */
  .ws-bento { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(6, clamp(120px, 15vw, 200px)); gap: clamp(8px, 1vw, 14px); }
  .ws-bento img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 18px; box-shadow: 0 24px 50px -30px rgba(20, 16, 13, 0.55); }
  .ws-bento__a { grid-column: 1 / 3; grid-row: 1 / 3; }
  .ws-bento__b { grid-column: 1; grid-row: 3 / 5; }
  .ws-bento__c { grid-column: 2; grid-row: 3; }
  .ws-bento__d { grid-column: 2; grid-row: 4; }
  .ws-bento__e { grid-column: 1 / 3; grid-row: 5 / 7; }
  .ws-room__body .ws-head { margin-bottom: clamp(1.2rem, 2.4vw, 2rem); }
  .ws-room__body .ws-head :global(h2) { max-width: none; }
  .ws-room__body .ws-lede { margin: 0.9rem 0 0; }
  .ws-room__body .ws-moves { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.6rem) clamp(1.2rem, 2.4vw, 2rem); }
  @media (min-width: 901px) { .ws-room__photos { position: sticky; top: 96px; } }
  @media (max-width: 900px) {
    .ws-room__layout { grid-template-columns: 1fr; }
    .ws-room__photos { max-width: 30rem; }
  }
  @media (max-width: 520px) {
    .ws-room__body .ws-moves { grid-template-columns: 1fr; }
  }
  .ws-move__key { margin: 0 0 0.7rem; font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold-deep); }
  .ws-move__key span { color: var(--fg4); margin-right: 0.4em; }
  .ws-move :global(h3) { margin: 0 0 0.6rem; font-size: calc(var(--fs-md) * 0.92); line-height: 1.15; }
  .ws-move > p:not(.ws-move__key) { margin: 0; color: var(--fg3); font-size: var(--fs-xs); }

  .ws-his {
    margin: 1.1rem 0 0;
    padding: 0.9rem 1rem 0.9rem 1.1rem;
    border-left: 2px solid var(--primary);
    background: var(--bg2);
    border-radius: 0 14px 14px 0;
  }
  .ws-his p { margin: 0 0 0.35rem; font-family: var(--font-accent); font-size: var(--fs-sm); line-height: 1.3; color: var(--fg1); }
  .ws-his cite { font-style: normal; font-size: 0.78rem; font-weight: 700; color: var(--fg4); letter-spacing: 0.02em; }
  .ws-his--dark { background: rgba(255, 255, 255, 0.05); border-left-color: #f2c275; }
  .ws-his--dark p { color: #fcfaf8; }
  .ws-his--dark cite { color: rgba(252, 250, 248, 0.6); }

  .ws-facts {
    list-style: none;
    margin: clamp(1.6rem, 3vw, 2.6rem) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .ws-facts li {
    padding: 9px 16px;
    border: 1px solid rgba(176, 121, 50, 0.32);
    border-radius: 100px;
    background: var(--bg2);
    font-family: var(--font-base);
    font-size: clamp(0.78rem, 0.72rem + 0.22vw, 0.95rem);
    font-weight: 700;
    color: var(--fg1);
  }

  .ws-room__foot {
    margin-top: clamp(1.6rem, 3vw, 2.8rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    border-top: 1px solid rgba(20, 16, 13, 0.1);
    padding-top: clamp(1.2rem, 2.4vw, 2rem);
  }
  .ws-note { margin: 0; color: var(--fg4); max-width: 60ch; }
  .ws-note--center { margin: clamp(1rem, 2vw, 1.8rem) auto 0; text-align: center; }

  /* ---- who: portrait beside the verified lines ---- */
  .ws-who__grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: clamp(1.4rem, 4vw, 4.5rem);
    align-items: center;
  }
  .ws-who__portrait { margin: 0; border-radius: 24px; overflow: hidden; aspect-ratio: 4 / 5; }
  .ws-who__portrait img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 12%; display: block; }
  .ws-who__text :global(h2) { margin: 0 0 1rem; }
  .ws-creds { list-style: none; margin: 0 0 1.2rem; padding: 0; display: grid; gap: 0.8rem; }
  .ws-creds li { padding-left: 1.2rem; position: relative; color: rgba(252, 250, 248, 0.86); font-size: var(--fs-xs); line-height: 1.55; }
  .ws-creds li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 7px; height: 7px; border-radius: 50%; background: #daa24f; }
  .ws-who__after { margin: 1rem 0 0; color: rgba(252, 250, 248, 0.78) !important; max-width: 48ch; }

  /* ---- the faces: four people, named, under the head ---- */
  .ws-faces {
    list-style: none;
    margin: 0 0 clamp(14px, 1.8vw, 24px);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(10px, 1.4vw, 18px);
    max-width: 880px;
  }
  .ws-face { min-width: 0; }
  .ws-face img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 18px;
    border: 1px solid rgba(20, 16, 13, 0.08);
  }
  .ws-face p { margin: 0.55rem 0 0; display: grid; gap: 1px; font-family: var(--font-base); font-size: 0.86rem; line-height: 1.25; }
  .ws-face p span { color: var(--fg4); font-size: 0.78rem; }
  .ws-faces__note { margin: 0 0 clamp(16px, 2vw, 26px); }

  .ws-more { margin: clamp(10px, 1.4vw, 18px) 0 clamp(16px, 2vw, 26px); }
  .ws-more a { font-weight: 700; color: var(--gold-deep); text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; }
  .ws-more a:hover { color: var(--fg1); }
  .ws-film { padding-block: clamp(2.4rem, 5vw, 4.5rem); }
  .ws-head--film { max-width: 900px; margin-inline: auto; text-align: center; }
  .ws-head--film :global(h2) { margin: 0 auto 0.8rem; max-width: 24ch; }
  .ws-head--film :global(.lede) { margin: 0; color: rgba(252, 250, 248, 0.8); }
  .ws-hero__film { aspect-ratio: 16 / 9; width: 100%; max-width: 760px; }
  .ws-hero__film video { width: 100%; height: 100%; display: block; object-fit: cover; }
  .ws-moments__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(1.4rem, 4vw, 4rem); align-items: center; }
  .ws-moments__grid .ws-head { margin-bottom: 0; }
  .ws-facts--moments { margin: 0; flex-direction: column; align-items: flex-start; }
  /* the recognition pills wear a badge mark, the same drawn-on set as the home page's cards */
  .ws-facts--moments { gap: 12px; }
  .ws-facts--moments li { display: inline-flex; align-items: center; gap: 12px; padding: 11px 20px 11px 14px; background: rgba(255, 255, 255, 0.55); font-size: clamp(0.9rem, 0.82rem + 0.3vw, 1.08rem); }
  .ws-facts--moments li :global(.fy__icon) { width: 28px; height: 28px; flex: none; color: var(--gold-deep); }
