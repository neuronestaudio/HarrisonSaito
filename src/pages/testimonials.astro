---
/**
 * Testimonials — all eleven.
 *
 * These also feed Review + AggregateRating schema from lib/seo.ts, which is
 * where the rich-result eligibility the old site had no chance at comes from.
 *
 * 18 Sep 2026: rebuilt in the site's design system (MoShell). The filter
 * buttons are gone: with eleven testimonies, two labelled sections say the
 * same thing without a control to press, and every word is on the page for a
 * reader and for search.
 */
import Base from '../layouts/Base.astro';
import MoShell from '../components/MoShell.astro';
import { TESTIMONIALS } from '../data/site';
import { INTERVIEWS } from '../data/interviews';

/* On camera (Dion, 2 Oct: "all the testimonies we used"): everyone filmed —
   the clients' own phone testimonies, Alex Wei's interview, and the four
   sitters of the 9 Sep shoot — word for word from the transcripts
   (interviews.ts `said`; D:\CLIENTS\HARRISON\_testimonies-drive
amed). */
const ORDER = ['Alex Wei', 'Harshil Dave', 'Nico Roudier', 'Jeremy Yap', 'Aiden Jacobs', 'Shehab Khan', 'Lorenzo Ambrose', 'Maksim Belchenko', 'John', 'Andrew', 'James', 'Jake'];
const ROLE: Record<string, string> = {
  'Alex Wei': 'Navy officer · karate, four years', 'Harshil Dave': 'Martial arts student', 'Nico Roudier': 'Martial arts student',
  'Jeremy Yap': 'Karate student', 'Aiden Jacobs': 'Martial arts student, Shinbukan', 'Shehab Khan': 'Martial arts student',
  'Lorenzo Ambrose': 'Martial arts student', 'Maksim Belchenko': 'Martial arts student', John: 'Coaching · consultant, 55',
  Andrew: 'Coaching · drummer', James: 'Coaching · construction', Jake: 'Coaching · musician',
};
/* A face for every voice (Dion, 2 Oct: "a portrait from each of those"):
   a still from each person's own clip (Alex: his tile of the call only), cut
   by D:\CLIENTS\HARRISON\_testimonies-drive/named/portraits; the four
   9 Sep sitters keep their shoot crops. */
const FACE: Record<string, string> = {
  'Alex Wei': '/img/faces/face-alex-v1-160.webp', 'Harshil Dave': '/img/faces/face-harshil-v1-160.webp',
  'Nico Roudier': '/img/faces/face-nico-v1-160.webp', 'Jeremy Yap': '/img/faces/face-jeremy-v1-160.webp',
  'Aiden Jacobs': '/img/faces/face-aiden-v1-160.webp', 'Shehab Khan': '/img/faces/face-shehab-v1-160.webp',
  'Lorenzo Ambrose': '/img/faces/face-lorenzo-v1-160.webp', 'Maksim Belchenko': '/img/faces/face-maksim-v1-160.webp',
  John: '/img/face-john-v1-320.webp', Andrew: '/img/face-andrew-v1-320.webp', James: '/img/face-james-v1-320.webp', Jake: '/img/face-jake-v1-320.webp',
};
const FILMED = ORDER.map((n) => INTERVIEWS.find((v) => v.name === n)).filter(Boolean).map((v) => ({
  face: FACE[v!.name],
  name: v!.name,
  context: `${ROLE[v!.name] ?? v!.role} · on camera`,
  quote: v!.said.join(' … ').replace(/^\s*([a-z])/, (m) => m.toUpperCase()),
}));
import { graph, localBusinessSchema, breadcrumbSchema } from '../lib/seo';

const title = 'Testimonials — Coaching, Martial Arts & HSC | Harrison Saito';
const description =
  'Eleven testimonials from coaching clients, martial arts students, HSC students and parents across Sydney — Chatswood High, Cammeraygal, St Pius X and Brigidine College St Ives.';

const groups = [
  {
    id: 'filmed',
    label: 'On camera',
    heading: 'In their own <mark>voices.</mark>',
    list: FILMED,
    video: true,
  },
  {
    id: 'adults',
    label: 'Coaching & Martial Arts',
    heading: 'From the people I’ve <mark>worked with.</mark>',
    list: TESTIMONIALS.filter((t) => t.category === 'adults'),
  },
  {
    id: 'youth',
    label: 'HSC & Parents',
    heading: 'From students <mark>and their parents.</mark>',
    list: TESTIMONIALS.filter((t) => t.category === 'youth'),
  },
];

const schema = graph(
  localBusinessSchema(),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Testimonials', url: '/testimonials' },
  ])
);
---

<Base title={title} description={description} path="/testimonials" schema={schema}>
  <MoShell modal={false}>
    <!-- ============ HERO ============ -->
    <section class="inner-hero on-dark" style="background-image:url(/img/dark-dojo.webp)" data-section="hero">
      <div class="wide">
        <p class="eyebrow">Testimonials</p>
        <h1>In their <mark>words.</mark></h1>
        <p class="lede accent">
          {FILMED.length} on camera, and {TESTIMONIALS.length} in writing — from coaching, martial arts,
          HSC mentoring and parents. Names and schools included, because
          unattributed praise is worth nothing.
        </p>
      </div>
    </section>

    {groups.map((g, i) => (
      <section class={`section ${i % 2 ? 'section--bg4' : 'section--white'}`} id={g.id} data-section={`voices-${g.id}`}>
        <div class="wide">
          <div class="sec-head">
            <div>
              <p class="eyebrow">{g.label}</p>
              <h2 class="reveal" set:html={g.heading} />
            </div>
            <p class="fs-xs thread__count">{g.list.length} {g.list.length === 1 ? 'voice' : 'voices'}</p>
          </div>

          {'video' in g && g.video && (
            <figure class="tfilm reveal">
              <video src="/video/testimonials-combo-v1.mp4" poster="/img/wall/wall-combo-v2-720.webp" controls preload="none" playsinline></video>
              <figcaption class="fs-xs">The combined testimonial, 68 seconds.</figcaption>
            </figure>
          )}
          <div class="tlist" data-stagger>
            {g.list.map((t) => (
              <blockquote class="reveal">
                <p>“{t.quote}”</p>
                <cite class:list={[{ 'cite--face': 'face' in t && t.face }]}>
                  {'face' in t && t.face && <img class="tface" src={t.face} alt={`${t.name}, from his testimony`} width="56" height="56" loading="lazy" decoding="async" />}
                  <span class="tname">{t.name}<span>{t.context}</span></span>
                </cite>
              </blockquote>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- ============ CLOSE ============ -->
    <section class="section section--dark on-dark close" data-section="close">
      <div class="content text-center">
        <h2 class="reveal">Ready to <mark>start?</mark></h2>
        <p class="fs-md close__sub reveal">
          No pitch. No pressure. Just a conversation about where you are and what you're looking for.
        </p>
        <div class="close__ctas reveal">
          <a class="btn btn--filled btn--wide" href="/book" data-track="cta_click" data-track-label="Testimonials — Book" data-track-section="close">Start the conversation</a>
          <a class="btn btn--outline btn--wide" href="/apply" data-track="cta_click" data-track-label="Testimonials — Apply" data-track-section="close">Apply for Return to Self</a>
        </div>
      </div>
    </section>
  </MoShell>
</Base>

<style>
  .cite--face { display: flex; align-items: center; gap: 14px; }
  .tface { flex: none; width: 56px; height: 56px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px var(--bg1), 0 0 0 3px rgba(218, 162, 79, 0.55); }
  :global(.mo .tlist cite .tname) { display: block; font-weight: 700; color: inherit; }
  :global(.mo .tlist cite .tname > span) { display: block; font-weight: 500; color: var(--fg4); }
  .tfilm { width: min(360px, 100%); margin: 0 auto var(--sp-60); }
  .tfilm video { width: 100%; aspect-ratio: 9 / 16; border-radius: 20px; background: #14100d; display: block; box-shadow: 0 30px 60px -30px rgba(20, 16, 13, 0.5); }
  .tfilm figcaption { text-align: center; margin-top: 10px; color: var(--fg4); }
</style>
