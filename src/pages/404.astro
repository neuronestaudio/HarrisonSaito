---
/**
 * 404.
 *
 * Closes audit finding H8: the legacy site returned HTTP 200 for every URL,
 * including ones that had never existed, which wasted crawl budget and let
 * junk get indexed. This page is served with a real 404 status by the host
 * (see public/_redirects and vercel.json).
 *
 * 18 Sep 2026: rebuilt in the site's design system (MoShell).
 */
import Base from '../layouts/Base.astro';
import MoShell from '../components/MoShell.astro';
import { NAV } from '../data/site';

const title = 'Page not found | Harrison Saito';
const description = 'That page does not exist. Here is where to go instead.';
---

<Base title={title} description={description} path="/404" noindex>
  <MoShell modal={false}>
    <section class="inner-hero inner-hero--short on-dark" style="background-image:url(/img/ink-wash.webp)" data-section="hero">
      <div class="wide">
        <p class="eyebrow">404</p>
        <h1>This page <mark>isn’t here.</mark></h1>
        <p class="lede accent">
          The circle is deliberately left open in Zen. This gap is just a broken link. Try one of
          these instead.
        </p>
      </div>
    </section>

    <section class="section section--white" data-section="elsewhere">
      <div class="wide">
        <p class="eyebrow">Everywhere else</p>
        <ol class="avenues" data-stagger>
          <li class="reveal">
            <a class="avenue" href="/">
              <span class="avenue__n">01</span>
              <span class="avenue__body"><strong>Home</strong><span>The walk, and the whole picture</span></span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </li>
          {NAV.map((item, i) => (
            <li class="reveal">
              <a class="avenue" href={item.href}>
                <span class="avenue__n">0{i + 2}</span>
                <span class="avenue__body"><strong>{item.label}</strong><span>{item.href}</span></span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </li>
          ))}
        </ol>

        <div class="core__cta reveal">
          <a class="btn btn--filled btn--wide" href="/book" data-track="cta_click" data-track-label="404 — Book">Start the conversation</a>
          <a class="btn btn--outline btn--wide" href="/">Back to home</a>
        </div>
      </div>
    </section>
  </MoShell>
</Base>
