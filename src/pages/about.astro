---
/**
 * The story.
 *
 * On naming: the URL stays /about because that is what people type, what
 * Google expects, and what the audit's multi-page structure depends on; the
 * <title> stays keyword-bearing for the same reason. But nothing on the page
 * says "About" — the nav reads "The Story", and the page opens on his name.
 *
 * "About Him" was never an option: every word on this site is first person
 * ("My father was a war-survivor…"). Third person would break the voice on the
 * one page where the voice is the product.
 *
 * 18 Sep 2026: rebuilt in the site's design system (MoShell). The seven
 * chapters are the same seven, word for word (CHAPTERS in src/data/site.ts) —
 * they were a 3D book that turned leaf by leaf (Book.astro, kept in the tree);
 * they are now seven spreads down the page, which reads the same on a phone as
 * on a desk and needs nothing to be dragged. The film hero, the film carousel
 * and the calligraphy washes came off with it.
 */
import Base from '../layouts/Base.astro';
import MoShell from '../components/MoShell.astro';
import { CHAPTERS, CREDENTIALS, FILMS, SITE } from '../data/site';
import { PLAY_ICON } from '../lib/morel-icons';
import { graph, personSchema, localBusinessSchema, breadcrumbSchema } from '../lib/seo';

const title = 'About Harrison Saito | Teacher, 2nd Dan Karate, Coach — Sydney';
const description =
  'Son of a Japanese war survivor, martial artist and Buddhist monk. High school teacher, 2nd Dan black belt and coach in Chatswood, Sydney. The story behind Return to Self, in seven chapters.';

/* The ones that carry a clean still of their own; the rest of the archive is
   on /media, where it belongs. */
const films = FILMS.filter((f) => f.featured && f.still).slice(0, 3);

const schema = graph(
  personSchema(),
  localBusinessSchema(),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'The Story', url: '/about' },
  ])
);
---

<Base title={title} description={description} path="/about" schema={schema}>
  <MoShell>
    <!-- ============ COVER ============ -->
    <section class="inner-hero on-dark" style="background-image:url(/img/portrait-shoji.webp)" data-section="cover">
      <div class="wide">
        <p class="eyebrow">The Story · In seven chapters</p>
        <h1>Harrison <mark>Saito</mark></h1>
        <p class="lede accent">
          My father was a war-survivor from post-WW2 Japan, a martial artist, and a Buddhist monk. He
          gave me discipline. He also gave me the wound. This is what I did with both.
        </p>
        <p class="fs-xs inner-hero__meta">Educator · Martial Artist · Coach — Chatswood, Sydney</p>
      </div>
    </section>

    <!-- ============ THE SEVEN CHAPTERS ============ -->
    <section class="section section--flush chapters" data-section="chapters">
      <div class="wide">
        {CHAPTERS.map((c, i) => (
          <article class={`cols cols--center chapter${i % 2 ? ' chapter--flip' : ''}`}>
            <div class="chapter__text reveal">
              <p class="eyebrow chapter__mark">
                <span class="chapter__kanji" lang="ja">{c.kanji}</span>
                <span>{c.romaji} — {c.caption}</span>
              </p>
              <h2>{c.title}</h2>
              {c.body.map((p) => <p class="fs-xs">{p}</p>)}
              {c.credential && <p class="pill chapter__credential">{c.credential}</p>}
            </div>
            <div
              class="chapter__plate reveal reveal--left"
              style={`--bg:url(/img/${c.image}.webp)`}
              role="img"
              aria-label={c.imageAlt}
            >
              <span class="chapter__number" lang="ja" aria-hidden="true">{c.number}</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ============ THE SHORT VERSION ============ -->
    <section class="section section--bg4" data-section="credentials">
      <div class="wide">
        <header class="core__head">
          <p class="eyebrow">The Short Version</p>
          <h2 class="reveal">Trained, qualified, <mark>still practising.</mark></h2>
        </header>

        <div class="numbers" data-stagger>
          {CREDENTIALS.map((c) => (
            <div class="reveal">
              <p class="numbers__value"><mark><strong>{c.value}</strong></mark></p>
              <p>{c.label}</p>
            </div>
          ))}
        </div>

        <div class="cols cols--top creds__detail reveal">
          <p class="fs-xs">
            I teach in a New South Wales high school, which means I am inside the HSC system rather
            than commenting on it from outside. I hold a Master of Teaching (Secondary) and a Bachelor
            of Commerce, and I have been coaching in one form or another for more than a decade.
          </p>
          <p class="fs-xs">
            In karate I am a 2nd Dan black belt. That matters here less as a credential than as a
            method: the dojo is where I learned that discipline without honesty just builds a better
            shell, and it is the same room where I eventually took mine apart.
          </p>
        </div>
      </div>
    </section>

    <!-- ============ THE ARCHIVE ============ -->
    <section class="section section--white films" data-section="archive">
      <div class="wide">
        <div class="sec-head">
          <div>
            <p class="eyebrow">The Archive</p>
            <h2 class="reveal">Twenty-one <mark>films.</mark></h2>
            <p class="fs-sm">
              Five threads — the son, the teacher, the practitioner, the poet and the voice. Most of
              it is not a showreel; it is the work itself, filmed as it happened.
            </p>
          </div>
          <a class="btn btn--outline" href="/media">Open the full archive</a>
        </div>

        <div class="films__grid" data-stagger>
          {films.map((f) => (
            <a class="film js-video reveal" href={`https://www.youtube.com/watch?v=${f.id}`} data-video={f.id} style={`background-image:url(/img/${f.still}.webp)`}>
              <div class="film__inner">
                <div>
                  <span class="pill">{f.duration ?? 'Film'}</span>
                  <h3>{f.title}</h3>
                </div>
                <Fragment set:html={PLAY_ICON} />
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CLOSE ============ -->
    <section class="section section--dark on-dark close" data-section="close">
      <div class="close__enso" aria-hidden="true"><img src="/img/logo-light-512.webp" alt="" width="320" height="320" loading="lazy" /></div>
      <div class="content text-center">
        <h2 class="reveal"><mark>Reach out.</mark></h2>
        <p class="fs-md close__sub reveal">
          No pitch. No pressure. Just a conversation about where you are and what you’re looking for.
        </p>
        <div class="close__ctas reveal">
          <a class="btn btn--filled btn--wide" href="/book" data-track="cta_click" data-track-label="About — Book" data-track-section="close">Start a Conversation</a>
          <a class="btn btn--outline btn--wide" href={`mailto:${SITE.email}`} data-track="cta_click" data-track-label="About — Email" data-track-section="close">Email Instead</a>
        </div>
      </div>
    </section>
  </MoShell>
</Base>
