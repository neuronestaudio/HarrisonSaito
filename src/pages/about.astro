---
/**
 * The story — presented as a book.
 *
 * On naming: the URL stays /about because that is what people type, what
 * Google expects, and what the audit's multi-page structure depends on; the
 * <title> stays keyword-bearing for the same reason. But nothing on the page
 * says "About" — the nav reads "The Story", and the page opens on a book cover
 * carrying his name. That gives the "the page should just be his name" instinct
 * its proper home without paying for it in search.
 *
 * "About Him" was never an option: every word on this site is first person
 * ("My father was a war-survivor…"). Third person would break the voice on the
 * one page where the voice is the product.
 */
import Base from '../layouts/Base.astro';
import Calligraphy from '../components/Calligraphy.astro';
import Book from '../components/Book.astro';
import FilmHero from '../components/FilmHero.astro';
import BrandMark from '../components/BrandMark.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import Enso from '../components/Enso.astro';
import { CREDENTIALS, VIDEO_IDS, SITE, CHAPTERS } from '../data/site';
import { graph, personSchema, localBusinessSchema, breadcrumbSchema } from '../lib/seo';

const title = 'About Harrison Saito | Teacher, 2nd Dan Karate, Coach — Sydney';
const description =
  'Son of a Japanese war survivor, martial artist and Buddhist monk. High school teacher, 2nd Dan black belt and coach in Chatswood, Sydney. The story behind Return to Self, in seven chapters.';

const schema = graph(
  personSchema(),
  localBusinessSchema(),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'The Story', url: '/about' },
  ])
);
---

<Base title={title} description={description} path="/about" schema={schema}>
  {/* ----------------------------------------------------------- the film */}
  <FilmHero />

  {/* ---------------------------------------------------------- the cover */}
  <section class="cover section--deep" id="story" data-section="cover">
    <Calligraphy set="story" scale={1.35} seed={6} words={['INHERITANCE', 'GRIEF']} />

    <div class="container cover__inner">
      <div class="cover__mark" data-reveal>
        <BrandMark variant="light" size={92} />
      </div>

      <p class="cover__label" data-reveal>In Seven Chapters</p>

      <p class="cover__name" data-reveal>
        <span class="split-line"><span>Harrison</span></span>
        <span class="split-line"><span class="cover__name-em">Saito</span></span>
      </p>

      <p class="cover__sub" data-reveal>
        Educator · Martial Artist · Coach — Chatswood, Sydney
      </p>

      <div class="cover__rule" data-reveal aria-hidden="true"></div>

      <p class="cover__standfirst" data-reveal>
        My father was a war-survivor from post-WW2 Japan, a martial artist, and a Buddhist monk. He
        gave me discipline. He also gave me the wound. This is what I did with both.
      </p>

      <p class="cover__prompt" data-reveal>
        <span aria-hidden="true">↓</span> Scroll to open
      </p>
    </div>
  </section>

  {/* ----------------------------------------------------------- the book */}
  <section class="section section--ink book-section" data-section="book">
    <div class="container container--wide">
      <Book />
    </div>
  </section>

  {/* ------------------------------------------------------ credentials */}
  <section class="section" data-section="credentials">
    <div class="container">
      <header class="creds__head" data-reveal>
        <p class="eyebrow">The Short Version</p>
        <h2 class="display-l">Trained, qualified, still practising.</h2>
      </header>

      <div class="creds" data-reveal-stagger="90">
        {
          CREDENTIALS.map((c) => (
            <div class="cred">
              <span class="cred__value">{c.value}</span>
              <span class="cred__label">{c.label}</span>
            </div>
          ))
        }
      </div>

      <div class="creds__detail prose" data-reveal>
        <p>
          I teach in a New South Wales high school, which means I am inside the HSC system rather
          than commenting on it from outside. I hold a Master of Teaching (Secondary) and a Bachelor
          of Commerce, and I have been coaching in one form or another for more than a decade.
        </p>
        <p>
          In karate I am a 2nd Dan black belt. That matters here less as a credential than as a
          method: the dojo is where I learned that discipline without honesty just builds a better
          shell, and it is the same room where I eventually took mine apart.
        </p>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ films */}
  <section class="section section--ink" data-section="film">
    <div class="container container--narrow">
      <header data-reveal>
        <p class="eyebrow">Chapter Two, On Film</p>
        <h2 class="display-m film__head">A father &amp; son talk &amp; heal.</h2>
        <p class="lede film__lede">
          The conversation that sits underneath everything else on this site.
        </p>
      </header>

      <div class="film__stack" data-reveal-stagger="130">
        <div>
          <YouTubeFacade id={VIDEO_IDS.fatherSon} title="My father and I" label="Father & Son" />
        </div>
        <div>
          <YouTubeFacade
            id={VIDEO_IDS.poemTrauma}
            title="Trauma, love and beyond"
            label="Poetry"
            description="“There's some challenges we just couldn't face…”"
          />
        </div>
      </div>

      <div class="film__more" data-reveal>
        <a class="btn btn--ghost" href="/media">The Full Archive — {CHAPTERS.length}+ Films</a>
      </div>
    </div>
  </section>

  {/* -------------------------------------------------------------- CTA */}
  <section class="section section--warm close" data-section="close">
    <div class="close__enso" aria-hidden="true"><Enso opacity={0.2} variant="dark" /></div>
    <div class="container container--narrow text-center" data-reveal>
      <h2 class="display-l">If something here resonated, reach out.</h2>
      <p class="lede close__sub">
        No pitch. No pressure. Just a conversation about where you are and what you're looking for.
      </p>
      <div class="close__ctas">
        <a class="btn btn--lg" href="/book" data-track="cta_click" data-track-label="About — Book"
          >Start a Conversation</a
        >
        <a
          class="btn btn--lg btn--ghost"
          href={`mailto:${SITE.email}`}
          data-track="cta_click"
          data-track-label="About — Email">Email Instead</a
        >
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- cover ---- */
  .cover {
    position: relative;
    min-height: auto;
    display: flex;
    align-items: center;
    padding-block: clamp(7rem, 15vh, 10rem) clamp(4rem, 8vw, 6rem);
    overflow: clip;
  }

  /* The cover is a flex container, so .container would otherwise shrink to its
     content and be centred by its own auto margins — pulling the type off the
     left edge every other page aligns to. */
  .cover > .container { width: 100%; }

  .cover__inner { position: relative; z-index: 1; max-width: 48rem; }

  .cover__mark { width: 92px; margin-bottom: clamp(2rem, 4vw, 3rem); opacity: 0.95; }

  .cover__label {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.25rem;
  }

  .cover__name {
    font-size: clamp(3.2rem, 13vw, 9rem);
    font-weight: 300;
    line-height: 0.98;
    color: oklch(95% 0.005 60);
  }
  .cover__name-em { font-style: italic; color: var(--gold-light); }

  .cover__sub {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    font-size: var(--step-0);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-ink-faint);
  }

  .cover__rule {
    width: 4rem;
    height: 2px;
    background: var(--gold);
    margin-block: clamp(1.75rem, 4vw, 2.75rem);
  }

  .cover__standfirst {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-style: italic;
    font-weight: 300;
    line-height: 1.5;
    color: var(--text-on-ink-muted);
    max-width: 34ch;
  }

  .cover__prompt {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-on-ink-faint);
  }
  .cover__prompt span { color: var(--gold); }

  /* ---- book ---- */
  .book-section { padding-block: clamp(3rem, 7vw, 6rem); }

  /* ---- credentials ---- */
  .creds__head { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .creds {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--rule);
  }
  .cred { display: grid; gap: 0.35rem; }
  .cred__value {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 300;
    line-height: 1;
    color: var(--gold-deep);
  }
  .cred__label {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    color: var(--text-on-paper-faint);
  }
  .creds__detail { margin-top: clamp(2rem, 4vw, 3rem); max-width: 58ch; }

  /* ---- film ---- */
  .film__head { margin-bottom: 1rem; }
  .film__lede { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .film__stack { display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .film__more { margin-top: clamp(2rem, 4vw, 3rem); text-align: center; }

  /* ---- close ---- */
  .close { position: relative; }
  .close__enso {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    transform: translate(-50%, -50%);
    width: clamp(16rem, 34vw, 30rem);
    pointer-events: none;
    z-index: 0;
  }
  .close__sub { margin: 1.5rem auto 0; max-width: 44ch; }
  .close__ctas {
    margin-top: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  @media (min-width: 900px) {
    .creds { grid-template-columns: repeat(4, 1fr); }
  }
</style>
