---
/**
 * Contact.
 *
 * Audit finding M9: the legacy site's only contact route was WhatsApp, which
 * quietly excluded anyone who doesn't use it — including a fair number of the
 * parents this business depends on. Email, phone and a form now sit alongside
 * it, with WhatsApp kept because it genuinely converts well.
 *
 * 18 Sep 2026: rebuilt in the site's design system (MoShell). The four-step
 * form is unchanged — it is the lead path into GoHighLevel — and it keeps the
 * dark band it was drawn for.
 */
import Base from '../layouts/Base.astro';
import MoShell from '../components/MoShell.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE, WHATSAPP } from '../data/site';
import { graph, localBusinessSchema, breadcrumbSchema } from '../lib/seo';

const title = 'Contact Harrison Saito | Chatswood, Sydney';
const description =
  'Get in touch with Harrison Saito — men’s life coaching and HSC mentoring in Chatswood, Sydney. Email, phone, WhatsApp or send a message.';

const schema = graph(
  localBusinessSchema(),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Contact', url: '/contact' },
  ])
);
---

<Base title={title} description={description} path="/contact" schema={schema}>
  <MoShell modal={false}>
    <section class="inner-hero inner-hero--short on-dark" style="background-image:url(/img/about-shoji.webp)" data-section="hero">
      <div class="wide">
        <p class="eyebrow">Contact</p>
        <h1>Get in <mark>touch.</mark></h1>
        <p class="lede accent">
          No pitch. No pressure. Just a conversation about where you are and what you're looking for.
        </p>
      </div>
    </section>

    <section class="section section--dark on-dark" data-section="contact">
      <div class="wide cols cols--top formgrid">
        <div class="formgrid__aside">
          <dl class="deets">
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${SITE.email}`} data-track="cta_click" data-track-label="Contact — email">{SITE.email}</a></dd>
            </div>
            <div>
              <dt>Phone</dt>
              <dd><a href={`tel:${SITE.phone}`} data-track="cta_click" data-track-label="Contact — phone">{SITE.phoneDisplay}</a></dd>
            </div>
            <div>
              <dt>WhatsApp</dt>
              <dd><a href={WHATSAPP.general} target="_blank" rel="noopener noreferrer" data-track="cta_click" data-track-label="Contact — WhatsApp">Message on WhatsApp</a></dd>
            </div>
            <div>
              <dt>Based in</dt>
              <dd>{SITE.locality}, {SITE.region} — and online Australia-wide</dd>
            </div>
            <div>
              <dt>Social</dt>
              <dd class="deets__row">
                <a href={SITE.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
                <a href={SITE.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>
              </dd>
            </div>
          </dl>

          <p class="fs-xs crisis">
            This is coaching, not therapy, diagnosis or emergency care. If you are in crisis, please
            contact <a href="tel:131114">Lifeline on 13 11 14</a> or call 000.
          </p>
        </div>

        <div class="formgrid__form">
          <LeadForm
            formId="general-contact"
            submitLabel="Send"
            eventName="contact"
            successHeading="Message sent."
            successBody="I'll reply personally, usually within a day."
          />
        </div>
      </div>
    </section>
  </MoShell>
</Base>
