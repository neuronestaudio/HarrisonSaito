---
/**
 * HSC & youth mentoring — the second SEO track.
 *
 * The legacy site's old indexed title, "Youth Mentor & Inner Transformational
 * Coach Sydney", ranked better than anything the Manus rebuild shipped (audit
 * H3). This page goes after that intent properly: HSC English tutoring, youth
 * mentoring, Chatswood and Sydney's North Shore — which is also a local-pack
 * query, so the schema carries LocalBusiness.
 *
 * Written to be read by a parent as much as a student. Off the header nav
 * since 6 Sep (Dion: the site sells men's coaching), but kept and indexed —
 * it is the track that already ranks.
 *
 * 18 Sep 2026: rebuilt in the site's design system (MoShell), copy unchanged.
 */
import Base from '../layouts/Base.astro';
import MoShell from '../components/MoShell.astro';
import { OFFERS, VIDEO_IDS, TESTIMONIALS } from '../data/site';
import { PLAY_ICON } from '../lib/morel-icons';
import {
  graph,
  serviceSchema,
  localBusinessSchema,
  breadcrumbSchema,
  faqSchema,
  videoSchema,
} from '../lib/seo';

const title = 'HSC English Tutor & Youth Mentor | Chatswood, Sydney — Harrison Saito';
const description =
  'HSC English tutoring and youth mentoring in Chatswood, Sydney, from a practising high school teacher. Confidence, clarity and performance under pressure.';

const offers = OFFERS.filter((o) => o.audience === 'youth');
const voices = TESTIMONIALS.filter((t) => t.category === 'youth');

const PILLARS = [
  {
    glyph: '声',
    title: 'A voice of their own',
    body: 'English stops being a subject to survive and becomes a way of thinking. Students learn to hold a position and argue it — which is a life skill wearing an exam costume.',
  },
  {
    glyph: '静',
    title: 'A settled nervous system',
    body: 'Breath, attention and pressure are trainable. The same regulation work that makes a martial artist calm under contact makes a student calm in an exam room.',
  },
  {
    glyph: '続',
    title: 'Discipline that holds',
    body: 'Consistency beats intensity. We build a way of working the student can actually sustain through Year 12 rather than a burst that collapses by trials.',
  },
];

const faqs = [
  {
    q: 'What year groups do you take?',
    a: 'Mainly Years 10 to 12, with a focus on HSC English. I also mentor younger students where the work is more about confidence and self-regulation than content.',
  },
  {
    q: 'Is this tutoring or mentoring?',
    a: 'Both, and deliberately so. Content coaching gets marks up; the mentoring is what makes those marks survive exam pressure. Most students need the second more than the first.',
  },
  {
    q: 'Are you an actual teacher?',
    a: 'Yes. I am a practising high school teacher with a Master of Teaching (Secondary), so I know the syllabus, the markers and the system from the inside.',
  },
  {
    q: 'Where do sessions run?',
    a: 'In person around Chatswood and Sydney’s North Shore, or online. Students have come from Chatswood High, Cammeraygal, St Pius X and Brigidine College St Ives, among others.',
  },
  {
    q: 'My child is anxious about the HSC. Can you help with that?',
    a: 'That is most of the work. The HSC is a pressure test for how a young person handles stress, organises their thinking and finds their voice. I coach the nervous system alongside the essays.',
  },
];

const schema = graph(
  localBusinessSchema(),
  serviceSchema({
    name: 'HSC English Tutoring & Youth Mentoring',
    serviceType: 'Tutoring and youth mentoring',
    description,
    url: '/hsc-tutoring',
  }),
  faqSchema(faqs),
  videoSchema({
    id: VIDEO_IDS.visionYouth,
    title: 'My vision for the youth (made in 2024)',
  }),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'HSC & Youth Mentoring', url: '/hsc-tutoring' },
  ])
);
---

<Base title={title} description={description} path="/hsc-tutoring" schema={schema}>
  <MoShell>
    <!-- ============ HERO ============ -->
    <section class="inner-hero on-dark" style="background-image:url(/img/karate-group.webp)" data-section="hero">
      <div class="wide">
        <p class="eyebrow">For Youth · Chatswood, Sydney</p>
        <h1>Building <mark>the person.</mark></h1>
        <p class="lede accent">
          HSC English tutoring and mentoring in Chatswood — from a practising high school teacher.
        </p>
        <p class="inner-hero__ctas">
          <a class="btn btn--filled btn--wide" href="/book?service=hsc" data-track="cta_click" data-track-label="HSC hero — Book a session">Book a session</a>
          <a class="btn btn--outline btn--wide is-white" href="#pricing">How it works</a>
        </p>
      </div>
    </section>

    <!-- ============ THE APPROACH ============ -->
    <section class="section section--flush" data-section="approach">
      <div class="wide cols cols--center problem">
        <div class="problem__text">
          <p class="fs-md">
            I've coached youth for over a decade. I know how they work. They don't need more pressure.
            They don't need another adult telling them what to do. They need to feel safe, a regulated
            nervous system, and they need to believe in themselves.
          </p>
          <p class="fs-xs">
            My approach goes beyond content. I help students build the confidence to think
            independently, the discipline to show up consistently, and the self-awareness to manage the
            anxiety that comes with high-stakes performance.
          </p>
          <p class="fs-xs">
            The HSC is not just an exam. It's a pressure test for how your child handles stress,
            organises their thinking, and finds their voice under pressure. I know the system from the
            inside, as a high school teacher, and as someone who has walked beside hundreds of students
            through it.
          </p>
        </div>
        <div class="problem__plate reveal reveal--left" style="--bg:url(/img/karate-group.webp)" role="img" aria-label="Harrison Saito teaching a group of young students in a dojo"></div>
      </div>
    </section>

    <!-- ============ WHAT CHANGES ============ -->
    <section class="section section--bg4 core" data-section="pillars">
      <div class="wide">
        <header class="core__head">
          <p class="eyebrow">What Changes</p>
          <h2 class="reveal">Marks are the <mark>by-product.</mark></h2>
        </header>

        <div class="core__grid" data-stagger>
          {PILLARS.map((p) => (
            <article class="phase-card reveal">
              <span class="phase-card__kanji" lang="ja" aria-hidden="true">{p.glyph}</span>
              <h3>{p.title}</h3>
              <p class="fs-xs">{p.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ HOW IT WORKS ============ -->
    <section class="section section--flush" id="pricing" data-section="offers">
      <div class="wide">
        <div class="family__head">
          <p class="eyebrow">Mentoring</p>
          <h2 class="reveal">How it <mark>works.</mark></h2>
          <p class="fs-sm">
            Sessions are one-to-one, with no lock-in packages. Tell me where your child is at and we
            will work out what they actually need.
          </p>
        </div>

        <div class="family__grid family__grid--one" data-stagger>
          {offers.map((offer) => (
            <a class="program-card reveal" href={offer.href} style="--bg:url(/img/youth-tutoring.webp)" data-track="cta_click" data-track-label={`Offer — ${offer.name}`}>
              <span class="pill">{offer.commitment}</span>
              <div class="lockup lockup--md"><span>{offer.name}</span></div>
              <p>{offer.description}</p>
              <span class="btn btn--filled btn--wide">{offer.cta}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ THE STUDENTS ============ -->
    <section class="section section--dark on-dark quote-band" data-section="voice">
      <div class="quote-band__wash" aria-hidden="true" style="background-image:url(/img/ink-wash.webp)"></div>
      <div class="content text-center reveal reveal--fade">
        <p class="quote-band__text accent">
          "You're like Oogway from Kung Fu Panda… Very wise. Very nonchalant. Lot of aura."
        </p>
        <p class="fs-xs quote-band__by">— Harrison's students</p>
      </div>
    </section>

    <!-- ============ FILM ============ -->
    <section class="section section--white films" data-section="film">
      <div class="wide">
        <div class="sec-head">
          <div>
            <p class="eyebrow">My Vision for Youth</p>
            <h2 class="reveal">What school <mark>could be.</mark></h2>
          </div>
          <a class="btn btn--outline" href="/media">All films</a>
        </div>

        <a class="film film--feature js-video reveal" href={`https://www.youtube.com/watch?v=${VIDEO_IDS.visionYouth}`} data-video={VIDEO_IDS.visionYouth} style="background-image:url(/img/youth-tutoring.webp)">
          <div class="film__inner">
            <div>
              <span class="pill">Vision</span>
              <h3>My vision for the youth (made in 2024)</h3>
            </div>
            <Fragment set:html={PLAY_ICON} />
          </div>
        </a>
      </div>
    </section>

    <!-- ============ IN THEIR WORDS ============ -->
    <section class="section section--bg4" data-section="testimonials">
      <div class="wide">
        <div class="sec-head">
          <div>
            <p class="eyebrow">From students and parents</p>
            <h2 class="reveal">In their <mark>words.</mark></h2>
          </div>
          <a class="btn btn--outline" href="/testimonials">Read them all</a>
        </div>

        <div class="tlist" data-stagger>
          {voices.map((t) => (
            <blockquote class="reveal">
              <p>“{t.quote}”</p>
              <cite>{t.name}<span>{t.context}</span></cite>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ STRAIGHT ANSWERS ============ -->
    <section class="section section--white faq" id="faq" data-section="faq">
      <div class="wide faq__cols">
        <header class="faq__head">
          <p class="eyebrow">For Parents</p>
          <h2 class="reveal">Straight <mark>answers.</mark></h2>
          <a class="btn btn--outline btn--wide reveal" href="/contact" data-track="cta_click" data-track-label="HSC FAQ — Ask">Ask a question first</a>
        </header>
        <div class="faq__list reveal reveal--fade">
          {faqs.map((f, i) => (
            <details class="faq__item" open={i === 0 ? true : undefined}>
              <summary>
                <span>{f.q}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path class="faq__v" d="M12 5v14"/><path d="M5 12h14"/></svg>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CLOSE ============ -->
    <section class="section section--dark on-dark close" data-section="close">
      <div class="close__enso" aria-hidden="true"><img src="/img/logo-light-512.webp" alt="" width="320" height="320" loading="lazy" /></div>
      <div class="content text-center">
        <h2 class="reveal">Book a <mark>first session.</mark></h2>
        <p class="fs-md close__sub reveal">
          Tell me where your child is at and what you're hoping changes. We'll go from there.
        </p>
        <div class="close__ctas reveal">
          <a class="btn btn--filled btn--wide" href="/book?service=hsc" data-track="cta_click" data-track-label="HSC — Book session" data-track-section="close">Book a Session</a>
          <a class="btn btn--outline btn--wide" href="/contact" data-track="cta_click" data-track-label="HSC — Ask a question" data-track-section="close">Ask a Question First</a>
        </div>
      </div>
    </section>
  </MoShell>
</Base>
