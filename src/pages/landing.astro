---
/**
 * /landing — the landing page.
 *
 * Two URLs, one page. Once / was the portfolio and /landing the same page
 * dropped at the door; the door is gone (17 Sep 2026), so both render the
 * walk (FrameHero), its pause on "Who this is for", and the harrison-saito-morel
 * page underneath (MorelHome). The URL is kept for the ads that point here, and
 * GA4 still sees two landing pages for clean ad reporting. /enter was the old
 * name and redirects here.
 *
 * noindex + out of the sitemap: it is the same content as /, and the canonical
 * points home so no duplicate-content signal is created.
 */
import Base from '../layouts/Base.astro';
import FrameHero from '../components/FrameHero.astro';
import MorelHome from '../components/MorelHome.astro';
import { VIDEO_IDS } from '../data/site';
import { graph, personSchema, localBusinessSchema, websiteSchema, videoSchema } from '../lib/seo';

const title = 'Return to Self | Harrison Saito — Chatswood, Sydney';
const description =
  'Men’s life coaching and HSC English mentoring in Chatswood, Sydney. Karate, Buddhism and structured inner work with a 2nd Dan black belt and high school teacher. Return to Self — 12-week programme.';

const schema = graph(
  personSchema(),
  localBusinessSchema(),
  websiteSchema(),
  videoSchema({
    id: VIDEO_IDS.sbsWorldNews,
    title: 'SBS World News',
    description: 'SBS World News interview about youth and adult mental health.',
  })
);
---

<Base title={title} description={description} path="/" schema={schema} noindex>
  <FrameHero />
  <MorelHome />
</Base>
