---
/**
 * /landing — where the ads point.
 *
 * The same page as /, kept at its own URL so GA4 and Meta still see a distinct
 * landing page for clean ad reporting, and so the campaign links keep working.
 * It used to drop the visitor at the film's locked door; the door is gone
 * (see StraightHero.astro), so there is nothing left to skip to — the frame is
 * the first screen for everyone.
 *
 * noindex + out of the sitemap: it is the same content as /, and the canonical
 * points home so no duplicate-content signal is created. /enter was the old
 * name and redirects here.
 */
import Base from '../layouts/Base.astro';
import StraightHero from '../components/StraightHero.astro';
import LandingSections from '../components/LandingSections.astro';
import { VIDEO_IDS } from '../data/site';
import { graph, personSchema, localBusinessSchema, websiteSchema, videoSchema } from '../lib/seo';

const title = 'Return to Self | Harrison Saito — Chatswood, Sydney';
const description =
  'Men’s life coaching and HSC English mentoring in Chatswood, Sydney. Karate, Buddhism and structured inner work with a 2nd Dan black belt and high school teacher. Return to Self — 12-week programme.';

const schema = graph(
  personSchema(),
  localBusinessSchema(),
  websiteSchema(),
  videoSchema({
    id: VIDEO_IDS.sbsWorldNews,
    title: 'SBS World News',
    description: 'SBS World News interview about youth and adult mental health.',
  })
);
---

<Base title={title} description={description} path="/" schema={schema} noindex>
  <StraightHero />
  <LandingSections />
</Base>
