---
/**
 * Return to Self application.
 *
 * The two-step application funnel the campaign playbook calls for: qualifying
 * questions first, contact details last, form embedded in the fold. This is the
 * real conversion event Meta optimises against — not an untracked WhatsApp tap.
 *
 * 18 Sep 2026: rebuilt in the site's design system (MoShell), form untouched.
 */
import Base from '../layouts/Base.astro';
import MoShell from '../components/MoShell.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE, WHATSAPP, PHASES } from '../data/site';
import { graph, breadcrumbSchema, localBusinessSchema } from '../lib/seo';

const title = 'Apply — Return to Self | Harrison Saito';
const description =
  'Apply for Return to Self, a 12-week coaching program for men built on karate, Buddhism and honest inner work. Three taps and a name, no obligation.';

const schema = graph(
  localBusinessSchema(),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: "Men's Coaching", url: '/mens-coaching' },
    { name: 'Apply', url: '/apply' },
  ])
);
---

<Base title={title} description={description} path="/apply" schema={schema}>
  <MoShell modal={false}>
    <section class="inner-hero inner-hero--short on-dark" style="background-image:url(/img/dark-dojo.webp)" data-section="hero">
      <div class="wide">
        <p class="eyebrow">Return to Self</p>
        <h1>Apply for the <mark>program.</mark></h1>
        <p class="lede accent">
          12 weeks. Three phases. I take a small number of men at a time, so this starts with an
          application rather than a checkout — and with a conversation, not a pitch.
        </p>
      </div>
    </section>

    <section class="section section--dark on-dark" data-section="apply">
      <div class="wide cols cols--top formgrid">
        <div class="formgrid__aside">
          <ol class="facts facts--phases">
            {PHASES.map((p) => (
              <li>
                <span class="chapter__kanji" lang="ja" aria-hidden="true">{p.kanji}</span>
                <span><strong>{p.name}</strong><span>{p.weeks}</span></span>
              </li>
            ))}
          </ol>

          <p class="fs-xs crisis">
            This is coaching, not therapy, diagnosis or emergency care. If you are in crisis, please
            contact <a href="tel:131114">Lifeline on 13 11 14</a>.
          </p>

          <p class="fs-xs">
            Would rather just message?
            <a href={WHATSAPP.instagram} target="_blank" rel="noopener noreferrer" data-track="cta_click" data-track-label="Apply — WhatsApp fallback">WhatsApp me</a>
            or email<br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
        </div>

        <div class="formgrid__form">
          <LeadForm
            formId="return-to-self-application"
            preset="programme"
            submitLabel="Send application"
            eventName="lead"
            eventValue={3600}
            successHeading="Application received."
            successBody="I read every one of these myself. Expect a reply within two business days — usually a call, if you left a number."
          />
        </div>
      </div>
    </section>
  </MoShell>
</Base>
