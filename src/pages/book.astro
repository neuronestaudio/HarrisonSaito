---
/**
 * Discovery chat / session booking.
 *
 * The audit's Phase 1 item 3 asks for a calendar booking alongside the
 * application. A booking embed (Cal.com / Calendly) drops in via
 * PUBLIC_BOOKING_URL; until that is configured the request form below is the
 * conversion path, and it fires the same Schedule event either way.
 *
 * 18 Sep 2026: rebuilt in the site's design system (MoShell), form untouched.
 */
import Base from '../layouts/Base.astro';
import MoShell from '../components/MoShell.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE, WHATSAPP } from '../data/site';
import { graph, breadcrumbSchema, localBusinessSchema } from '../lib/seo';

const title = 'Book a Discovery Chat | Harrison Saito — Chatswood, Sydney';
const description =
  'Book a no-pressure conversation about coaching or HSC mentoring with Harrison Saito. In person around Chatswood and Sydney’s North Shore, or online Australia-wide.';

const bookingUrl = import.meta.env.PUBLIC_BOOKING_URL ?? '';

const FACTS = [
  { t: 'Around 30 minutes', s: 'Enough to work out whether this fits' },
  { t: 'In person or online', s: "Chatswood and Sydney's North Shore, or anywhere in Australia" },
  { t: 'Free', s: 'The first conversation costs nothing' },
];

const schema = graph(
  localBusinessSchema(),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Book a Chat', url: '/book' },
  ])
);
---

<Base title={title} description={description} path="/book" schema={schema}>
  <MoShell modal={false}>
    <section class="inner-hero inner-hero--short on-dark" style="background-image:url(/img/dark-dojo.webp)" data-section="hero">
      <div class="wide">
        <p class="eyebrow">Start Here</p>
        <h1>Book a <mark>conversation.</mark></h1>
        <p class="lede accent">
          No pitch. No pressure. Just a conversation about where you are and what you're looking for.
        </p>
      </div>
    </section>

    <section class="section section--dark on-dark" data-section="book">
      <div class="wide cols cols--top formgrid">
        <div class="formgrid__aside">
          <ul class="facts">
            {FACTS.map((f) => (
              <li><strong>{f.t}</strong><span>{f.s}</span></li>
            ))}
          </ul>

          <p class="eyebrow facts__label">Prefer to reach me directly?</p>
          <div class="deets__row">
            <a href={`mailto:${SITE.email}`} data-track="cta_click" data-track-label="Book — email">{SITE.email}</a>
            <a href={`tel:${SITE.phone}`} data-track="cta_click" data-track-label="Book — phone">{SITE.phoneDisplay}</a>
            <a href={WHATSAPP.general} target="_blank" rel="noopener noreferrer" data-track="cta_click" data-track-label="Book — WhatsApp">WhatsApp</a>
          </div>
        </div>

        <div class="formgrid__form">
          {bookingUrl ? (
            <div class="book__embed">
              <iframe src={bookingUrl} title="Booking calendar" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
          ) : (
            <LeadForm
              formId="discovery-chat"
              submitLabel="Request a time"
              eventName="schedule"
              successHeading="Request received."
              successBody="I'll come back to you with a couple of times that work, usually within a day."
            />
          )}
        </div>
      </div>
    </section>
  </MoShell>
</Base>
