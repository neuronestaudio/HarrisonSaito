---
/**
 * Discovery chat / session booking.
 *
 * The audit's Phase 1 item 3 asks for a calendar booking alongside the
 * application. A booking embed (Cal.com / Calendly) drops in via
 * PUBLIC_BOOKING_URL; until that is configured the request form below is the
 * conversion path, and it fires the same Schedule event either way.
 *
 * 18 Sep 2026: rebuilt in the site's design system (MoShell), form untouched.
 */
import Base from '../layouts/Base.astro';
import MoShell from '../components/MoShell.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE, WHATSAPP } from '../data/site';
import { graph, breadcrumbSchema, localBusinessSchema } from '../lib/seo';

const title = 'Book a Discovery Chat | Harrison Saito — Chatswood, Sydney';
const description =
  'Book a no-pressure conversation about coaching or HSC mentoring with Harrison Saito. In person around Chatswood and Sydney’s North Shore, or online Australia-wide.';

const bookingUrl = import.meta.env.PUBLIC_BOOKING_URL ?? '';

/* Dion, 30 Sep: "take out about half an hour… take out the free… based in
   Middle Cove, Sydney's North Shore — so when they land on this page it's
   really just the four-step questionnaire." One line of where, and the form. */
const FACTS = [
  { t: 'Based in Middle Cove', s: "Sydney's North Shore, or online anywhere in Australia" },
];

/* The direct routes, as marks without words (same ask): his own inbox
   (SITE.email — his Gmail, site-wide since 30 Sep), WhatsApp with the message
   written, LinkedIn. */
const DIRECT = [
  {
    label: 'Email Harrison',
    href: `mailto:${SITE.email}`,
    track: 'Book — email',
    external: false,
    /* an envelope */
    svg: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 7l8.5 6 8.5-6"/>',
  },
  {
    label: 'Message Harrison on WhatsApp',
    href: WHATSAPP.general,
    track: 'Book — WhatsApp',
    external: true,
    /* the bubble with its tail, and the handset inside it */
    svg: '<path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3z"/><path d="M9 8.5c-.6.7-.6 1.800 0 3 .9 1.700 2.300 3 4 3.700 1 .4 1.900.2 2.500-.500l-1.700-1.400-.9.600c-.8-.400-1.500-1.100-1.900-1.900l.6-.9z"/>',
  },
  {
    label: 'Harrison on LinkedIn',
    href: 'https://www.linkedin.com/in/harrison-saito',
    track: 'Book — LinkedIn',
    external: true,
    /* the square, and "in" */
    svg: '<rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M8 10.500v6"/><path d="M8 7.400v.2"/><path d="M12 16.500v-6"/><path d="M12 13.200a2.200 2.200 0 0 1 4.400 0v3.300"/>',
  },
];

const schema = graph(
  localBusinessSchema(),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Book a Chat', url: '/book' },
  ])
);
---

<Base title={title} description={description} path="/book" schema={schema}>
  <MoShell modal={false}>
    <section class="inner-hero inner-hero--short on-dark" style="background-image:url(/img/dark-dojo.webp)" data-section="hero">
      <div class="wide">
        <p class="eyebrow">Start Here</p>
        <h1>Start the <mark>conversation.</mark></h1>
        <p class="lede accent">
          No pitch. No pressure. Just a conversation about where you are and what you're looking for.
        </p>
      </div>
    </section>

    <section class="section section--dark on-dark" data-section="book">
      <div class="wide book__stack">
        <div class="formgrid__form">
          {bookingUrl ? (
            <div class="book__embed">
              <iframe src={bookingUrl} title="Booking calendar" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
          ) : (
            <LeadForm
              formId="discovery-chat"
              submitLabel="Request a time"
              eventName="schedule"
              successHeading="Request received."
              successBody="I'll come back to you with a couple of times that work, usually within a day."
            />
          )}
        </div>
        <div class="formgrid__aside book__after">
          <ul class="facts">
            {FACTS.map((f) => (
              <li><strong>{f.t}</strong><span>{f.s}</span></li>
            ))}
          </ul>

          <p class="eyebrow facts__label">Prefer to reach me directly?</p>
          <div class="deets__icons">
            {DIRECT.map((d) => (
              <a
                class="deets__icon"
                href={d.href}
                aria-label={d.label}
                title={d.label}
                target={d.external ? '_blank' : undefined}
                rel={d.external ? 'noopener noreferrer' : undefined}
                data-track="cta_click"
                data-track-label={d.track}
              >
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={d.svg} />
              </a>
            ))}
          </div>
        </div>

      </div>
    </section>
  </MoShell>
</Base>
