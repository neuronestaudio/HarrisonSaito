---
/**
 * Films & archive.
 *
 * Was a grid of eight thumbnails; now the full catalogue of twenty-one grouped
 * by facet — The Son, The Teacher, The Practitioner, The Poet, The Voice — so
 * the archive answers "who is this person" rather than just listing uploads.
 *
 * Deliberately excluded: eight "AQWMV" anime music videos from fifteen years
 * ago. They are still public on the channel, but they are teenage-era uploads
 * and do not belong next to a $3,600 coaching programme.
 *
 * 18 Sep 2026: rebuilt in the site's design system (MoShell). The dragging
 * carousel (FilmCarousel.astro, kept in the tree) is now a grid per thread —
 * the same twenty-one films, all of them reachable without a gesture. A film
 * with a clean still of its own gets a plate; the rest are plain cards, because
 * his YouTube thumbnails carry burned-in caption text that cheapens the page.
 */
import Base from '../layouts/Base.astro';
import MoShell from '../components/MoShell.astro';
import { FILMS, FACETS, SITE } from '../data/site';
import { PLAY_ICON } from '../lib/morel-icons';
import { graph, videoSchema, breadcrumbSchema, personSchema } from '../lib/seo';

const title = 'Films & Archive — SBS World News, Teaching & Practice | Harrison Saito';
const description =
  'Twenty-one films: SBS World News, a father and son healing on camera, full HSC teaching sessions, guided meditation and spoken poetry. The whole archive, grouped by facet.';

const schema = graph(
  personSchema(),
  ...FILMS.filter((f) => f.featured || f.facet === 'voice').map((f) =>
    videoSchema({ id: f.id, title: f.title, description: f.note })
  ),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Films', url: '/media' },
  ])
);

const threads = FACETS.map((facet) => ({ facet, films: FILMS.filter((f) => f.facet === facet.id) })).filter((t) => t.films.length);
---

<Base title={title} description={description} path="/media" schema={schema}>
  <MoShell>
    <!-- ============ HERO ============ -->
    <section class="inner-hero on-dark" style="background-image:url(/img/sbs-karate-2-v1.webp)" data-section="hero">
      <div class="wide">
        <p class="eyebrow">Films &amp; Archive</p>
        <h1>See the <mark>work.</mark></h1>
        <p class="lede accent">
          {FILMS.length} films across {FACETS.length} threads — the son, the teacher, the
          practitioner, the poet and the voice. Nothing here is a showreel; most of it is the work
          itself, filmed as it happened.
        </p>
      </div>
    </section>

    <!-- ============ THE THREADS ============ -->
    {threads.map(({ facet, films }) => (
      <section class="section section--white thread" id={facet.id} data-section={`films-${facet.id}`}>
        <div class="wide">
          <div class="sec-head">
            <div>
              <p class="eyebrow chapter__mark">
                <span class="chapter__kanji" lang="ja">{facet.kanji}</span>
                <span>{facet.romaji}</span>
              </p>
              <h2 class="reveal">{facet.label}</h2>
              <p class="fs-sm thread__blurb">{facet.blurb}</p>
            </div>
            <p class="fs-xs thread__count">{films.length} {films.length === 1 ? 'film' : 'films'}</p>
          </div>

          <div class="films__grid" data-stagger>
            {films.map((f) => (
              <a
                class={`film js-video reveal${f.still ? '' : ' film--plain'}`}
                href={`https://www.youtube.com/watch?v=${f.id}`}
                data-video={f.id}
                style={f.still ? `background-image:url(/img/${f.still}.webp)` : undefined}
              >
                <div class="film__inner">
                  <div>
                    <span class="pill">{f.duration ?? (f.external ? 'Elsewhere' : 'Film')}</span>
                    <h3>{f.title}</h3>
                    {f.note && <p class="fs-xs">{f.note}</p>}
                  </div>
                  <Fragment set:html={PLAY_ICON} />
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- ============ AS SEEN ON ============ -->
    <section class="section section--bg4" data-section="sbs">
      <div class="wide cols cols--center problem">
        <div class="problem__text">
          <p class="eyebrow">As Seen On</p>
          <h2 class="reveal">SBS World <mark>News.</mark></h2>
          <p class="fs-md">
            A national broadcast interview on youth and adult mental health, and on martial arts as a
            way into both.
          </p>
          <p class="fs-xs">
            Media enquiries and speaking:<br /><a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
        </div>
        <div class="problem__plate reveal reveal--left" style="--bg:url(/img/sbs-karate-v1.webp)" role="img" aria-label="Harrison Saito in his gi at the Shinbukan dojo, from the SBS World News segment that names him as a karate teacher"></div>
      </div>
    </section>

    <!-- ============ CLOSE ============ -->
    <section class="section section--dark on-dark close" data-section="close">
      <div class="content text-center">
        <h2 class="reveal">The work is the <mark>whole case.</mark></h2>
        <p class="fs-md close__sub reveal">
          If something in the archive landed, the next step is a conversation — not a pitch.
        </p>
        <div class="close__ctas reveal">
          <a class="btn btn--filled btn--wide" href="/book" data-track="cta_click" data-track-label="Films — Book" data-track-section="close">Start the conversation</a>
          <a class="btn btn--outline btn--wide" href="/mens-coaching" data-track="cta_click" data-track-label="Films — Coaching" data-track-section="close">See the program</a>
        </div>
      </div>
    </section>
  </MoShell>
</Base>
