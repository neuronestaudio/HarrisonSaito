---
/**
 * Media — films, interviews and guided practice.
 *
 * All seven videos now load as facades (audit H4). The legacy page mounted
 * every one of them as a live iframe on load.
 */
import Base from '../layouts/Base.astro';
import Calligraphy from '../components/Calligraphy.astro';
import YouTubeFacade from '../components/YouTubeFacade.astro';
import Picture from '../components/Picture.astro';
import { MEDIA, SITE } from '../data/site';
import { graph, videoSchema, breadcrumbSchema, personSchema } from '../lib/seo';

const title = 'Media — SBS World News, Films & Guided Practice | Harrison Saito';
const description =
  'Harrison Saito on SBS World News, plus short films on fatherhood and trauma, poetry, and a five-minute guided chakra meditation.';

const featured = MEDIA.find((m) => m.featured)!;
const rest = MEDIA.filter((m) => !m.featured);

const schema = graph(
  personSchema(),
  ...MEDIA.map((m) => videoSchema(m)),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Media', url: '/media' },
  ])
);
---

<Base title={title} description={description} path="/media" schema={schema}>
  <section class="section page-hero section--deep" data-section="hero">
    <Calligraphy set="close" scale={1.2} seed={8} words={['VOICE']} />

    <div class="container">
      <div data-reveal>
        <p class="eyebrow">Media</p>
        <h1 class="display-xl page-hero__title">
          <span class="split-line"><span>See the work.</span></span>
        </h1>
        <p class="lede page-hero__lede">
          Interviews, short films, poetry and guided practice.
        </p>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------- featured */}
  <section class="section" data-section="featured">
    <div class="container">
      <header class="feature__head" data-reveal>
        <p class="eyebrow">As Seen On</p>
        <h2 class="display-l">SBS World News.</h2>
        <p class="lede feature__lede">
          An interview about youth and adult mental health, broadcast nationally.
        </p>
      </header>

      <div class="feature__frame" data-reveal>
        <YouTubeFacade
          id={featured.id}
          title={featured.title}
          label={featured.label}
          description={featured.description}
        />
      </div>

      <div class="feature__still" data-reveal data-ink-reveal>
        <Picture
          slug="sbs-group"
          alt="Harrison Saito with the group featured in the SBS World News segment"
          sizes="(max-width: 900px) 100vw, 70vw"
          parallax={8}
        />
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- grid */}
  <section class="section section--ink" data-section="library">
    <div class="container">
      <header class="library__head" data-reveal>
        <p class="eyebrow">Everything Else</p>
        <h2 class="display-l">Films, poetry &amp; practice.</h2>
      </header>

      <div class="library" data-reveal-stagger="110">
        {
          rest.map((m) => (
            <div>
              <YouTubeFacade
                id={m.id}
                title={m.title}
                label={m.label}
                description={m.description}
                thumb="hq"
              />
            </div>
          ))
        }
      </div>

      <div class="library__more" data-reveal>
        <a
          class="btn btn--ghost"
          href={SITE.youtube}
          target="_blank"
          rel="noopener noreferrer"
          data-track="cta_click"
          data-track-label="Media — YouTube channel">View All on YouTube</a>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------------- CTA */}
  <section class="section section--warm" data-section="close">
    <div class="container container--narrow text-center" data-reveal>
      <h2 class="display-l">Want to talk?</h2>
      <p class="lede close__sub">
        No pitch. No pressure. Just a conversation about where you are and what you're looking for.
      </p>
      <div class="close__ctas">
        <a class="btn btn--lg" href="/book" data-track="cta_click" data-track-label="Media — Book">Start a Conversation</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    position: relative;
    padding-block: clamp(8rem, 18vh, 12rem) clamp(4rem, 9vw, 7rem);
    min-height: 52svh;
    display: flex;
    align-items: flex-end;
  }
  .page-hero__lede { margin-top: 1.5rem; max-width: 40ch; }

  .feature__head { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .feature__lede { margin-top: 1.25rem; max-width: 48ch; }
  .feature__frame { max-width: 62rem; }
  .feature__still {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    max-width: 62rem;
  }
  .feature__still :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .library__head { margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .library { display: grid; gap: clamp(1.75rem, 3.5vw, 3rem); }
  .library__more { margin-top: clamp(2.5rem, 5vw, 4rem); text-align: center; }

  .close__sub { margin: 1.5rem auto 0; max-width: 44ch; }
  .close__ctas { margin-top: 2.5rem; display: flex; justify-content: center; }

  @media (min-width: 760px) {
    .library { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1150px) {
    .library { grid-template-columns: repeat(3, 1fr); }
  }
</style>
