---
/**
 * Films & archive.
 *
 * Was a grid of eight thumbnails; now the full catalogue of twenty-one, in an
 * interactive carousel grouped by facet — The Son, The Teacher, The
 * Practitioner, The Poet, The Voice — so the archive answers "who is this
 * person" rather than just listing uploads.
 *
 * Deliberately excluded: eight "AQWMV" anime music videos from fifteen years
 * ago. They are still public on the channel, but they are teenage-era uploads
 * and do not belong next to a $3,600 coaching programme.
 */
import Base from '../layouts/Base.astro';
import Calligraphy from '../components/Calligraphy.astro';
import FilmCarousel from '../components/FilmCarousel.astro';
import Picture from '../components/Picture.astro';
import Enso from '../components/Enso.astro';
import { FILMS, FACETS, SITE } from '../data/site';
import { graph, videoSchema, breadcrumbSchema, personSchema } from '../lib/seo';

const title = 'Films & Archive — SBS World News, Teaching & Practice | Harrison Saito';
const description =
  'Twenty-one films: SBS World News, a father and son healing on camera, full HSC teaching sessions, guided meditation and spoken poetry. The whole archive, grouped by facet.';

const schema = graph(
  personSchema(),
  ...FILMS.filter((f) => f.featured || f.facet === 'voice').map((f) =>
    videoSchema({ id: f.id, title: f.title, description: f.note })
  ),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Films', url: '/media' },
  ])
);
---

<Base title={title} description={description} path="/media" schema={schema}>
  <section class="section page-hero section--deep" data-section="hero">
    <Calligraphy set="close" scale={1.2} seed={8} words={['VOICE']} />
    <div class="page-hero__enso" aria-hidden="true"><Enso opacity={0.14} /></div>

    <div class="container">
      <div data-reveal>
        <p class="eyebrow">Films &amp; Archive</p>
        <h1 class="display-xl page-hero__title">
          <span class="split-line"><span>See the work.</span></span>
        </h1>
        <p class="lede page-hero__lede">
          {FILMS.length} films across {FACETS.length} threads — the son, the teacher, the
          practitioner, the poet and the voice. Nothing here is a showreel; most of it is the work
          itself, filmed as it happened.
        </p>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------- carousel */}
  <section class="section section--ink" data-section="archive">
    <div class="container container--wide" data-reveal>
      <FilmCarousel />
    </div>
  </section>

  {/* ------------------------------------------------------------- still */}
  <section class="section" data-section="sbs">
    <div class="container">
      <div class="sbs">
        <div class="sbs__text" data-reveal>
          <p class="eyebrow">As Seen On</p>
          <h2 class="display-m">SBS World News.</h2>
          <p class="lede sbs__lede">
            A national broadcast interview on youth and adult mental health, and on martial arts as a
            way into both.
          </p>
          <p class="sbs__note">
            Media enquiries and speaking:
            <a class="link-underline" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
        </div>

        <div class="sbs__media" data-reveal data-ink-reveal>
          <Picture
            slug="sbs-group"
            alt="Harrison Saito with the group featured in the SBS World News segment"
            sizes="(max-width: 900px) 100vw, 48vw"
            parallax={9}
          />
        </div>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------------- CTA */}
  <section class="section section--warm" data-section="close">
    <div class="container container--narrow text-center" data-reveal>
      <h2 class="display-l">Want to talk?</h2>
      <p class="lede close__sub">
        No pitch. No pressure. Just a conversation about where you are and what you're looking for.
      </p>
      <div class="close__ctas">
        <a class="btn btn--lg" href="/book" data-track="cta_click" data-track-label="Films — Book"
          >Start a Conversation</a
        >
        <a
          class="btn btn--lg btn--ghost"
          href={SITE.youtube}
          target="_blank"
          rel="noopener noreferrer"
          data-track="cta_click"
          data-track-label="Films — YouTube channel">Subscribe on YouTube</a
        >
      </div>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    position: relative;
    padding-block: clamp(8rem, 18vh, 12rem) clamp(4rem, 9vw, 7rem);
    min-height: 55svh;
    display: flex;
    align-items: flex-end;
  }
  .page-hero__enso {
    position: absolute;
    inset-block-start: 40%;
    inset-inline-end: -5rem;
    width: clamp(18rem, 34vw, 32rem);
    pointer-events: none;
    z-index: 0;
  }
  .page-hero__lede { margin-top: 1.5rem; max-width: 56ch; }

  .sbs { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: center; }
  .sbs__lede { margin-top: 1.25rem; max-width: 44ch; }
  .sbs__note { margin-top: 1.75rem; font-size: var(--step--1); color: var(--text-on-paper-faint); }
  .sbs__media { overflow: hidden; aspect-ratio: 4 / 3; }
  .sbs__media :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .close__sub { margin: 1.5rem auto 0; max-width: 44ch; }
  .close__ctas {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  @media (min-width: 900px) {
    .sbs { grid-template-columns: 1fr 1fr; }
  }
</style>
