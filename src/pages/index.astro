---
/**
 * Home — the brand page.
 *
 * Audit finding H1: the legacy site was one URL carrying two unrelated
 * businesses, so it could rank for neither. Home now does one job — establish
 * who Harrison is and route the audiences — and the commercial detail lives
 * on its own pages where it can rank on its own terms.
 *
 * 17 Sep 2026: the hero is the walk through the house (FrameHero).
 * 18 Sep 2026: the walk pauses on the shut doors for "Who this is for", and the
 * page under it is the harrison-saito-morel build, whole (MorelHome).
 * 29 Sep 2026 (Dion, 28 Sep): the home page is his portfolio again. The walk
 * runs straight through — no gate here; the ads' landing pages keep theirs —
 * and under it the six doors (PortfolioHome). The twelve-week page it used to
 * be is /return-to-self, whole. The first build's sections are in git at 67111a0.
 */
import Base from '../layouts/Base.astro';
import FrameHero from '../components/FrameHero.astro';
import PortfolioHome from '../components/PortfolioHome.astro';
import { VIDEO_IDS } from '../data/site';
import { graph, personSchema, localBusinessSchema, websiteSchema, videoSchema } from '../lib/seo';

const title = 'Harrison Saito | Educator, Martial Artist, Coach — Chatswood, Sydney';
const description =
  'You can be good at life and still feel disconnected from yourself. Harrison Saito — teacher, 2nd Dan karate, coach — in Chatswood, Sydney: Return to Self, the workshop, 1:1 coaching, Shinbukan karate, HSC mentoring, and the work on film.';

const schema = graph(
  personSchema(),
  localBusinessSchema(),
  websiteSchema(),
  videoSchema({
    id: VIDEO_IDS.sbsWorldNews,
    title: 'SBS World News',
    description: 'SBS World News interview about youth and adult mental health.',
  })
);
---

<Base title={title} description={description} path="/" schema={schema}>
  <FrameHero gate={false} />
  <PortfolioHome />
</Base>
