---
/**
 * Home — the brand page.
 *
 * Audit finding H1: the legacy site was one URL carrying two unrelated
 * businesses, so it could rank for neither. Home now does one job — establish
 * who Harrison is and route the two audiences — and the commercial detail lives
 * on /mens-coaching and /hsc-tutoring where it can rank on its own terms.
 *
 * 17 Sep 2026: the hero is the walk through the house (FrameHero).
 * 18 Sep 2026: the walk pauses on the shut doors for "Who this is for", and the
 * page under it is the harrison-saito-morel build, whole (MorelHome). The
 * sections this page carried before are in git history at 67111a0.
 */
import Base from '../layouts/Base.astro';
import FrameHero from '../components/FrameHero.astro';
import MorelHome from '../components/MorelHome.astro';
import { VIDEO_IDS } from '../data/site';
import { graph, personSchema, localBusinessSchema, websiteSchema, videoSchema } from '../lib/seo';

const title = 'Harrison Saito | Life Coach & HSC Mentor — Chatswood, Sydney';
const description =
  'Principles built in a dojo, for men who have achieved a lot and still feel disconnected. Harrison Saito teaches the tools to regulate, rebuild self-worth and live by your own values in an overstimulated world. Return to Self: a 12-week program in Chatswood, Sydney and online.';

const schema = graph(
  personSchema(),
  localBusinessSchema(),
  websiteSchema(),
  videoSchema({
    id: VIDEO_IDS.sbsWorldNews,
    title: 'SBS World News',
    description: 'SBS World News interview about youth and adult mental health.',
  })
);
---

<Base title={title} description={description} path="/" schema={schema}>
  <FrameHero />
  <MorelHome />
</Base>
