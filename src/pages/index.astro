---
/**
 * Home — the landing.
 *
 * Audit finding H1: the legacy site was one URL carrying two unrelated
 * businesses, so it could rank for neither. Home does one job — establish who
 * Harrison is and route the reader — and the commercial detail lives on
 * /mens-coaching and /hsc-tutoring where it can rank on its own terms.
 *
 * 17 Sep: the intro film's landing, door and walk-through (RtsHero.astro,
 * still in the tree) are replaced by one held frame that pushes forward on
 * scroll, and the page under it is the harrison-saito-morel layout with the
 * diagnostic sections cut. See StraightHero.astro and LandingSections.astro.
 */
import Base from '../layouts/Base.astro';
import StraightHero from '../components/StraightHero.astro';
import LandingSections from '../components/LandingSections.astro';
import { VIDEO_IDS } from '../data/site';
import { graph, personSchema, localBusinessSchema, websiteSchema, videoSchema } from '../lib/seo';

const title = 'Harrison Saito | Men’s Life Coach & HSC Mentor — Chatswood, Sydney';
const description =
  'Men’s life coaching and HSC English mentoring in Chatswood, Sydney. Karate, Buddhism and structured inner work with a 2nd Dan black belt and high school teacher. Return to Self — 12-week programme.';

const schema = graph(
  personSchema(),
  localBusinessSchema(),
  websiteSchema(),
  videoSchema({
    id: VIDEO_IDS.sbsWorldNews,
    title: 'SBS World News',
    description: 'SBS World News interview about youth and adult mental health.',
  })
);
---

<Base title={title} description={description} path="/" schema={schema}>
  <StraightHero />
  <LandingSections />
</Base>
