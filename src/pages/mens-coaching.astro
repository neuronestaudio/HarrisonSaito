---
/**
 * Men's coaching — one of the two SEO tracks split out of the old single page.
 *
 * Audit H1/H3: the legacy site had one indexable URL titled "Educator, Martial
 * Artist, Coach" — zero search intent, no location — and two unrelated
 * businesses competing for it. This page targets men's life coaching in Sydney
 * on its own terms and carries the Return to Self programme in full.
 *
 * 18 Sep 2026: rebuilt in the site's design system (MoShell), the same one the
 * home page runs on. Every line of copy is the one this page already carried;
 * what went are the calligraphy washes, the drawn ensō, the coverflow and the
 * serif display face. The phases, the loop and the straight answers are the
 * same words in the system's cards.
 */
import Base from '../layouts/Base.astro';
import MoShell from '../components/MoShell.astro';
import { OFFERS, VIDEO_IDS, RETURN_LOOP, PHASES, TESTIMONIALS, PROOF } from '../data/site';
import { PLAY_ICON } from '../lib/morel-icons';
import {
  graph,
  serviceSchema,
  courseSchema,
  localBusinessSchema,
  breadcrumbSchema,
  faqSchema,
} from '../lib/seo';

const title = "Men's Life Coach Sydney | Return to Self — Harrison Saito";
const description =
  "Men's life coaching in Chatswood, Sydney. Return to Self is a 12-week programme using karate, Buddhism and structured inner work for men who are done performing.";

const offers = OFFERS.filter((o) => o.audience === 'adults');
/* Two of the eleven, whole — they are long, and a trimmed testimony is not
   one. The rest are on /testimonials. */
const voices = TESTIMONIALS.filter((t) => t.category === 'adults').slice(0, 2);

/** The plate and the lock-up each way in carries, in the system's card. */
const OFFER_ART: Record<string, { image: string; lockup: string[] }> = {
  'life-coaching': { image: '/img/karate-training.webp', lockup: ['One', 'To One'] },
  'return-to-self': { image: '/img/dark-dojo.webp', lockup: ['Return', 'To Self'] },
};

const faqs = [
  {
    q: 'Is this therapy?',
    a: 'No. This is coaching — a training framework for the inner world, built on martial arts, Buddhism and honest self-inquiry. It is not therapy, diagnosis or emergency care. If you are in crisis, contact Lifeline on 13 11 14.',
  },
  {
    q: 'Do I need martial arts experience?',
    a: 'No. Karate is used as a method for working with the nervous system, attention and pressure. Plenty of men arrive having never trained. The physical practice is adapted to the person in front of me.',
  },
  {
    q: 'How much does it cost?',
    a: 'We cover that on the first conversation, once I understand what you are actually carrying and whether I can help. I will not put you through a pitch to get to it — ask directly and I will answer directly.',
  },
  {
    q: 'Where do sessions happen?',
    a: 'In person around Chatswood and Sydney’s North Shore, or online Australia-wide.',
  },
  {
    q: 'How much do I have to disclose?',
    a: 'You are never required to disclose more than you choose, or to prove yourself through an exercise. The pacing is adapted to you.',
  },
];

const schema = graph(
  localBusinessSchema(),
  serviceSchema({
    name: "Men's Life Coaching",
    serviceType: 'Life coaching',
    description,
    url: '/mens-coaching',
  }),
  courseSchema(),
  faqSchema(faqs),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: "Men's Coaching", url: '/mens-coaching' },
  ])
);
---

<Base title={title} description={description} path="/mens-coaching" schema={schema}>
  <MoShell>
    <!-- ============ HERO ============ -->
    <section class="inner-hero on-dark" style="background-image:url(/img/dark-dojo.webp)" data-section="hero">
      <div class="wide">
        <p class="eyebrow">Men’s coaching · Chatswood, Sydney</p>
        <h1>You look like you’ve <mark>got it all together.</mark></h1>
        <p class="lede accent">
          But when you’re alone, really alone, you feel like something fundamental is missing.
        </p>
        <p class="inner-hero__ctas">
          <a class="btn btn--filled btn--wide" href="/book" data-track="cta_click" data-track-label="Mens hero — Book a discovery chat">Book a discovery chat</a>
          <a class="btn btn--outline btn--wide is-white" href="#return-to-self">What the twelve weeks contain</a>
        </p>
      </div>
    </section>

    <!-- ============ PROOF ============ -->
    <section class="section section--white" data-section="proof">
      <div class="wide">
        <div class="numbers numbers--three" data-stagger>
          {PROOF.map((p) => (
            <div class="reveal">
              <p class="numbers__value"><mark><strong>{p.value}</strong></mark></p>
              <p>{p.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ THE PROBLEM ============ -->
    <section class="section section--flush" data-section="problem">
      <div class="wide cols cols--center problem">
        <div class="problem__text">
          <p class="fs-md">
            People describe you as "solid." "Reliable." "Disciplined." They have no idea that
            underneath all of that, you're exhausted from performing a version of yourself that isn't
            even you.
          </p>
          <p class="fs-xs">
            You say yes when you mean no. You suppress your opinion to keep the peace. You overwork to
            earn approval you'll never feel. And underneath the performance, there's a simmering anger
            you can't quite name. Often connected to a father who demanded everything and gave you no
            room to be human.
          </p>
          <p class="fs-xs">
            You don't need more discipline. You don't need another book. You need someone who has been
            exactly where you are. Someone who built the shell, lived inside it for decades, and then
            dismantled it piece by piece.
          </p>
        </div>
        <div class="problem__plate reveal reveal--left" style="--bg:url(/img/karate-training.webp)" role="img" aria-label="Harrison Saito training karate, mid-stance, in a white gi with a black belt"></div>
      </div>
    </section>

    <!-- ============ THE PROGRAMME ============ -->
    <section class="section section--bg4 core" id="return-to-self" data-section="programme">
      <div class="wide">
        <header class="core__head">
          <p class="eyebrow">The Programme</p>
          <h2 class="reveal">Return to Self.</h2>
          <p class="fs-md core__lede reveal">
            For men who built the life that looks right, but feels hollow. Who sense the weight of
            something inherited, unspoken, unresolved. This is where that work begins.
          </p>
          <p class="fs-xs core__lede reveal">
            12 weeks. Three phases. This is not therapy. It is coaching: a training framework for the
            inner world, built on martial arts, Buddhism, and honest self-inquiry. Over 12 weeks, you
            learn to recognise inherited reactions earlier, separate them from your own values, and
            make choices you can stand behind.
          </p>
        </header>

        <div class="core__grid" data-stagger>
          {PHASES.map((ph) => (
            <article class="phase-card reveal">
              <span class="phase-card__kanji" lang="ja" aria-hidden="true">{ph.kanji}</span>
              <p class="phase-card__weeks">Phase {ph.number} · {ph.weeks}</p>
              <h3>{ph.name}</h3>
              <p class="fs-xs">{ph.blurb}</p>
              <p class="fs-xs phase-card__aim"><strong>{ph.aim}</strong></p>
              <p class="phase-card__romaji" aria-hidden="true">{ph.kanji} {ph.romaji} — {ph.kanjiMeaning}</p>
            </article>
          ))}
        </div>

        <!-- The classical frame the three phases actually follow. -->
        <div class="cols cols--top shuhari reveal">
          <div>
            <p class="eyebrow shuhari__label">守破離 — Shu · Ha · Ri</p>
            <p class="fs-xs">
              The three phases follow the classical budo model of learning: hold the form, break the
              form, transcend the form. It is the same arc a martial artist walks from white belt to
              black — applied inward.
            </p>
          </div>
          <div>
            <p class="eyebrow shuhari__label">Each phase uses the same Return Loop</p>
            <ol class="loop">
              {RETURN_LOOP.map((step) => <li>{step}</li>)}
            </ol>
          </div>
        </div>

        <p class="fs-xs core__note reveal">
          The exact pacing and exercises are adapted to the person in front of me. You are never
          required to disclose more than you choose or prove yourself through an exercise. This is
          coaching, not therapy, diagnosis or emergency care.
        </p>

        <div class="core__cta reveal">
          <a class="btn btn--filled btn--wide" href="/apply" data-track="cta_click" data-track-label="Mens programme — Apply">Apply for Return to Self</a>
          <a class="btn btn--outline btn--wide" href="/book" data-track="cta_click" data-track-label="Mens programme — Book discovery">Book a discovery chat</a>
        </div>
      </div>
    </section>

    <!-- ============ WAYS IN ============ -->
    <section class="section section--flush" id="pricing" data-section="offers">
      <div class="wide">
        <div class="family__head">
          <p class="eyebrow">Ways In</p>
          <h2 class="reveal">Two ways to <mark>work together.</mark></h2>
        </div>

        <div class="family__grid" data-stagger>
          {offers.map((offer) => (
            <a class="program-card reveal" href={offer.href} style={`--bg:${OFFER_ART[offer.id]?.image ? `url(${OFFER_ART[offer.id].image})` : 'none'}`} data-track="cta_click" data-track-label={`Offer — ${offer.name}`}>
              <span class="pill">{offer.commitment}</span>
              <div class="lockup lockup--md">{(OFFER_ART[offer.id]?.lockup ?? [offer.name]).map((w) => <span>{w}</span>)}</div>
              <p>{offer.description}</p>
              <span class="btn btn--filled btn--wide">{offer.cta}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ FILM ============ -->
    <section class="section section--white films" data-section="film">
      <div class="wide">
        <div class="sec-head">
          <div>
            <p class="eyebrow">Where This Comes From</p>
            <h2 class="reveal">A father &amp; son <mark>talk &amp; heal.</mark></h2>
          </div>
          <a class="btn btn--outline" href="/media">All films &amp; interviews</a>
        </div>

        <a class="film film--feature js-video reveal" href={`https://www.youtube.com/watch?v=${VIDEO_IDS.fatherSon}`} data-video={VIDEO_IDS.fatherSon} style="background-image:url(/img/father-son-still.webp)">
          <div class="film__inner">
            <div>
              <span class="pill">Father &amp; Son</span>
              <h3>My father and I</h3>
            </div>
            <Fragment set:html={PLAY_ICON} />
          </div>
        </a>
      </div>
    </section>

    <!-- ============ IN THEIR WORDS ============ -->
    <section class="section section--dark on-dark" data-section="testimonials">
      <div class="wide">
        <div class="sec-head">
          <div>
            <p class="eyebrow">From the men I’ve worked with</p>
            <h2 class="reveal">In their <mark>words.</mark></h2>
          </div>
          <a class="btn btn--outline" href="/testimonials">Read all eleven</a>
        </div>

        <div class="tlist tlist--dark" data-stagger>
          {voices.map((t) => (
            <blockquote class="reveal">
              <p>“{t.quote}”</p>
              <cite>{t.name}<span>{t.context}</span></cite>
            </blockquote>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ STRAIGHT ANSWERS ============ -->
    <section class="section section--white faq" id="faq" data-section="faq">
      <div class="wide faq__cols">
        <header class="faq__head">
          <p class="eyebrow">Before You Apply</p>
          <h2 class="reveal">Straight <mark>answers.</mark></h2>
          <p class="fs-sm faq__lede reveal">
            The questions men actually arrive with, answered before you have to ask.
          </p>
          <a class="btn btn--outline btn--wide reveal" href="/book" data-track="cta_click" data-track-label="Mens FAQ — Book">Book when you’re ready</a>
        </header>
        <div class="faq__list reveal reveal--fade">
          {faqs.map((f, i) => (
            <details class="faq__item" open={i === 0 ? true : undefined}>
              <summary>
                <span>{f.q}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path class="faq__v" d="M12 5v14"/><path d="M5 12h14"/></svg>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ CLOSE ============ -->
    <section class="section section--dark on-dark close" data-section="close">
      <div class="close__enso" aria-hidden="true"><img src="/img/logo-light-512.webp" alt="" width="320" height="320" loading="lazy" /></div>
      <div class="content text-center">
        <h2 class="reveal">If this feels close to <mark>what you’re carrying.</mark></h2>
        <p class="fs-md close__sub reveal">
          Start with an honest conversation. No pressure. We’ll work out whether the programme fits.
        </p>
        <div class="close__ctas reveal">
          <a class="btn btn--filled btn--wide" href="/apply" data-track="cta_click" data-track-label="Mens close — Apply" data-track-section="close">Apply for Return to Self</a>
          <a class="btn btn--outline btn--wide" href="/book" data-track="cta_click" data-track-label="Mens close — Book discovery" data-track-section="close">Book a Discovery Chat</a>
        </div>
      </div>
    </section>
  </MoShell>
</Base>
