---
/**
 * Campaign landing page — Return to Self.
 *
 * Audit Phase 1, item 5: "Don't send cold traffic to a 6-section homepage with
 * three offers." One avatar, one promise, one CTA, no navigation to leak
 * attention. The ad sets the expectation; this page has to meet it in the
 * first screen.
 *
 * noindex + excluded from the sitemap and robots.txt — it duplicates copy from
 * /mens-coaching and must never compete with it organically.
 *
 * 18 Sep 2026: rebuilt in the site's design system (MoShell), copy unchanged.
 * Still bare — no nav to leak attention — and the form is still in the fold.
 */
import Base from '../../layouts/Base.astro';
import MoShell from '../../components/MoShell.astro';
import LeadForm from '../../components/LeadForm.astro';
import { PHASES, TESTIMONIALS, PROOF, SITE } from '../../data/site';

const title = 'Return to Self — 12-Week Coaching for Men | Harrison Saito';
const description =
  'For men who built the life that looks right but feels hollow. A 12-week programme built on karate, Buddhism and honest inner work. Chatswood, Sydney and online.';

const proof = TESTIMONIALS.filter((t) => t.category === 'adults').slice(0, 2);

const POINTS = [
  'Three phases across 12 weeks — Separate, Return, Integrate',
  'Led by a 2nd Dan black belt and practising high school teacher',
  "In person around Sydney's North Shore, or online Australia-wide",
  'Coaching, not therapy — and I will tell you if it isn’t the right fit',
];

const INCLUDED = [
  { t: 'Weekly one-to-one sessions', b: "Twelve of them. In person around Sydney's North Shore, or online Australia-wide. Ninety minutes, not a rushed hour." },
  { t: 'Physical practice', b: 'Karate as method, not metaphor — breath, stance, pressure. Adapted to you. No experience needed, and no belt to earn.' },
  { t: 'The Return Loop', b: 'Pause. Recognise. Separate. Choose. Practise. One repeatable move you take into the week, not a folder of worksheets.' },
  { t: 'Between-session contact', b: 'You are not left alone for seven days with something we opened on a Tuesday.' },
  { t: 'A practice that outlasts the programme', b: 'By week twelve you have a daily practice you can run without me. That is the point.' },
  { t: 'An honest read, up front', b: 'If this is not the right thing for you, I will say so on the first call rather than take your money.' },
];
---

<Base title={title} description={description} path="/lp/return-to-self" noindex bare>
  <MoShell modal={false}>
    <!-- ============ ABOVE THE FOLD ============ -->
    <section class="inner-hero on-dark lp-hero" style="background-image:url(/img/dark-dojo.webp)" data-section="lp-hero">
      <div class="wide cols cols--top formgrid">
        <div class="formgrid__aside lp-hero__copy">
          <p class="eyebrow">Harrison Saito · Chatswood, Sydney</p>
          <h1>You built the life that looks right. <mark>It still feels hollow.</mark></h1>
          <p class="lede accent">
            Return to Self is a 12-week programme for men who are exhausted from performing a version
            of themselves that isn't even them. Karate, Buddhism, and honest inner work — with someone
            who built the shell, lived in it for decades, and then took it apart.
          </p>

          <ul class="facts lp-points">
            {POINTS.map((p) => <li><span>{p}</span></li>)}
          </ul>

          <div class="deets__row lp-proofrow">
            {PROOF.map((p) => <span class="pill">{p.value}</span>)}
          </div>

          <div class="tlist tlist--dark lp-quotes">
            {proof.map((t) => (
              <blockquote>
                <p>“{t.quote.slice(0, 168).trimEnd()}…”</p>
                <cite>{t.name}<span>{t.context}</span></cite>
              </blockquote>
            ))}
          </div>
        </div>

        <!-- The form is in the fold, not below it. -->
        <div class="formgrid__form" id="apply">
          <p class="eyebrow facts__label">Apply — takes two minutes</p>
          <p class="fs-xs crisis lp-formnote">
            A small number of places at a time. No obligation — an application, then an honest
            conversation about whether this is the right thing for you.
          </p>
          <LeadForm
            formId="lp-return-to-self"
            preset="programme"
            submitLabel="Send application"
            eventName="lead"
            eventValue={3600}
            successHeading="Application received."
            successBody="I read every one myself. Expect a reply within two business days — usually a call."
          />
        </div>
      </div>
    </section>

    <!-- ============ THE PHASES ============ -->
    <section class="section section--bg4 core" data-section="lp-phases">
      <div class="wide">
        <header class="core__head">
          <p class="eyebrow">守破離 — the arc</p>
          <h2 class="reveal">Twelve weeks, <mark>three phases.</mark></h2>
        </header>

        <div class="core__grid" data-stagger>
          {PHASES.map((p) => (
            <article class="phase-card reveal">
              <span class="phase-card__kanji" lang="ja" aria-hidden="true">{p.kanji}</span>
              <p class="phase-card__weeks">{p.weeks}</p>
              <h3>{p.name}</h3>
              <p class="fs-xs phase-card__aim"><strong>{p.aim}</strong></p>
              <p class="fs-xs">{p.blurb}</p>
            </article>
          ))}
        </div>

        <div class="core__cta reveal">
          <a class="btn btn--filled btn--wide" href="#apply" data-track="cta_click" data-track-label="LP — bottom apply">Apply for Return to Self</a>
          <p class="fs-xs core__note">
            Or email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · {SITE.phoneDisplay}
          </p>
        </div>
      </div>
    </section>

    <!-- ============ WHAT YOU ACTUALLY GET ============
         Nathan 03: detail before conversion. The old Manus page carried a
         "What's Included" block that the rebuild dropped; this restores it, and
         it is the thing that stops $3,600 reading as an abstraction. -->
    <section class="section section--white fy" data-section="lp-included">
      <div class="wide">
        <header class="fy__head">
          <p class="eyebrow">What the twelve weeks contain</p>
          <h2 class="reveal">What you <mark>actually get.</mark></h2>
        </header>

        <div class="fy__grid" data-stagger>
          {INCLUDED.map((i) => (
            <article class="fy__card reveal included__card">
              <h3>{i.t}</h3>
              <p>{i.b}</p>
            </article>
          ))}
        </div>

        <div class="fy__foot reveal">
          <a class="btn btn--filled btn--wide" href="#apply" data-track="cta_click" data-track-label="LP — mid CTA (included)">Apply for Return to Self</a>
          <p class="fs-xs core__note">Two minutes. Five questions. No obligation.</p>
        </div>
      </div>
    </section>

    <!-- ============ THE ASK ============ -->
    <section class="section section--dark on-dark close" data-section="lp-close">
      <div class="content text-center">
        <h2 class="reveal">If this is <mark>your year.</mark></h2>
        <div class="close__ctas reveal">
          <a class="btn btn--filled btn--wide" href="#apply" data-track="cta_click" data-track-label="LP — closing CTA">Start the Application</a>
        </div>
      </div>
    </section>

    <footer class="section section--flush lp-foot">
      <div class="wide">
        <p class="fs-xs">&copy; {new Date().getFullYear()} Harrison Saito · {SITE.locality}, {SITE.region}</p>
        <nav class="deets__row" aria-label="Legal">
          <a href="/privacy">Privacy Policy</a>
          <a href="/terms">Terms</a>
          <a href="/">Full site</a>
        </nav>
      </div>
    </footer>
  </MoShell>
</Base>
