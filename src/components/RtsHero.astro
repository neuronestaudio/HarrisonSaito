    var leftAt50 = (PLATE_W - visW) / 2;
    if (dx >= leftAt50 && dx + dw <= leftAt50 + visW) return 50;
    var want = clamp(dx + dw / 2 - visW / 2, 0, PLATE_W - visW);
    var targetX = want / (PLATE_W - visW) * 100;
    var start = pGate - 0.16;
    var k = clamp((p - start) / (pGate - start), 0, 1);
    return 50 + (targetX - 50) * k;
  }

  function onScroll() {
    var p = progress();
    publishPlate();
    if (p > 0.02 && video!.preload !== "auto") video!.preload = "auto";
    /* The gate arms on the way down the first time, and on the way back up
       every time after: the door is a page, and scrolling back to it locks
       there rather than fading through it. */
    /* Which side of the gate he is on — with hysteresis, so a scroll that
       comes to rest on the line cannot flicker, and set outright by Enter
       (above) and by the flip back (below). */
    if (!gated && !transitioning) { if (p > pGate + 0.01) above = true; else if (p < pGate - 0.01) above = false; }
    var crossDown = (!answered && p >= pGate) || (!above && p >= pGate);
    var crossUp = above && p <= pGate;
    if (ready && !gated && !transitioning && !leaving && (crossDown || crossUp)) engage();
    if (gated) {
      if (Math.abs(window.scrollY - gateY) > 1) snapTo(gateY);
      p = pGate;
    }
    if (!cut) {
      target = timeFor(p);
      if (!answered && !transitioning) setObjX(panFor(p));
      if (answered) drivePortal(p);
      if (gated) placeDoor();
      rail!.style.width = (p * 100).toFixed(2) + "%";
      /* End of room two. The runway is not cut here — he scrolled every pixel
         of it, so it stays mapped and stays reversible. Second time through
         (back to the door, Enter again) there is nothing to finish, only the
         playing state to drop and the nav to bring back. */
      if (p >= 0.999) {
        if (!done) finish(false);
        else if (playing) { playing = false; hero!.classList.remove("hero--playing"); showNav(true); }
      }
    }
    if (p > 0.06) hero!.setAttribute("data-progress-past", ""); else hero!.removeAttribute("data-progress-past");
    /* The welcome goes with the first scroll that moves him on from it. */
    if (greeted && !transitioning && Math.abs(p - greetP) > 0.012) hero!.classList.remove("hero--welcome");
    /* The landing comes back on the way up — and it is the landing, not the
       cue: once he has gone on and returned to the top, the choice he made
       on the path is undone and the links are the last beat. */
    var landing = p < 0.08;
    if (!landing) wentOn = true;
    if (landing && wentOn && p < 0.015 && links!.hasAttribute("data-chosen")) {
      links!.removeAttribute("data-chosen");
      cue!.classList.remove("cue--on");
      wentOn = false;
    }
    links!.classList.toggle("links--hidden", !landing);
    hero!.classList.toggle("hero--landing", landing);
  }
  var above = false, wentOn = false;

  /* ---------- seeking (room one only): one in flight, three ways to settle ---------- */
  function settle() { pending = false; clearTimeout(watchdog); }
  video.addEventListener("seeked", settle);
  function issueSeek(t: number) {
    pending = true;
    clearTimeout(watchdog);
    watchdog = window.setTimeout(settle, 220);
    if ("requestVideoFrameCallback" in video!) (video as any).requestVideoFrameCallback(settle);
    try { video!.currentTime = t; } catch (e) { settle(); }
  }
  function tick() {
    if (ready && !cut) {
      eased += (target - eased) * 0.14;
      if (!pending && Math.abs(eased - video!.currentTime) > 1 / 48) issueSeek(eased);
      paintBeats(eased);
    }
    requestAnimationFrame(tick);
  }


  /* ---------- the gate ---------- */
  var SCROLL_KEYS: Record<string, number> = { " ": 1, PageDown: 1, PageUp: 1, ArrowDown: 1, ArrowUp: 1, Home: 1, End: 1 };
  /* Capture phase, so Lenis (which listens on window in the bubble phase) never
     sees the wheel. Stopping Lenis instead would put overflow:hidden on <html>
     via .lenis-stopped, and that detaches the sticky frame from the viewport. */
  /* Up is the way out. The lock swallows every scroll, but enough of it
     upward — a wheel, a finger dragging down, ArrowUp — is read as intent
     and the gate lets go towards the landing (leave()). Down stays locked:
     the way in is Enter. */
  var upAccum = 0, touchY0 = -1, lockedAt = 0, touchFresh = false;
  var LOCK_GRACE = 700;
  function preventScroll(e: Event) {
    if (pops!.scrollWidth > pops!.clientWidth + 2 && pops!.contains(e.target as Node)) return;   /* the phone's pop-up row may scroll sideways */
    e.preventDefault();
    e.stopImmediatePropagation();
    /* The gesture that carried him to the door — a wheel's tail, a finger
       still on the glass, momentum — is not a wish to leave it. Intent counts
       only after a moment, and on touch only from a finger put down since. */
    if (performance.now() - lockedAt < LOCK_GRACE) return;
    if (e.type === "touchmove" && !touchFresh) return;
    if (e.type === "wheel") {
      var we = e as WheelEvent, dy = we.deltaY * (we.deltaMode === 1 ? 16 : we.deltaMode === 2 ? 400 : 1);
      upAccum = dy < 0 ? upAccum - dy : 0;
      if (upAccum > 90) { upAccum = 0; leave(); }
    } else if (e.type === "touchmove") {
      var t = (e as TouchEvent).touches[0];
      if (t) { if (touchY0 < 0) touchY0 = t.clientY; else if (t.clientY - touchY0 > 70) { touchY0 = -1; leave(); } }
    }
  }
  function onTouchStart() { touchFresh = true; touchY0 = -1; }
  function onTouchEnd() { touchY0 = -1; }
  var CAPTURE: AddEventListenerOptions = { passive: false, capture: true };
  var LISTEN: AddEventListenerOptions = { passive: true, capture: true };
  function onKey(e: KeyboardEvent) {
    if (!gated) return;
    if (e.key === "Escape") { e.preventDefault(); if (playing) finish(true); else enter(); return; }
    if (e.key === "ArrowUp" || e.key === "PageUp" || e.key === "Home") { e.preventDefault(); leave(); return; }
    if (SCROLL_KEYS[e.key] && !(e.key === " " && (e.target === door || e.target === skip))) e.preventDefault();
  }
  function lock() {
    upAccum = 0; touchY0 = -1; touchFresh = false; lockedAt = performance.now();
    window.addEventListener("wheel", preventScroll, CAPTURE);
    window.addEventListener("touchmove", preventScroll, CAPTURE);
    window.addEventListener("touchstart", onTouchStart, LISTEN);
    window.addEventListener("touchend", onTouchEnd, LISTEN);
    window.addEventListener("touchcancel", onTouchEnd, LISTEN);
    window.addEventListener("keydown", onKey);
  }
  function unlock() {
    window.removeEventListener("wheel", preventScroll, CAPTURE);
    window.removeEventListener("touchmove", preventScroll, CAPTURE);
    window.removeEventListener("touchstart", onTouchStart, LISTEN);
    window.removeEventListener("touchend", onTouchEnd, LISTEN);
    window.removeEventListener("touchcancel", onTouchEnd, LISTEN);
    window.removeEventListener("keydown", onKey);
  }

  function engage() {
    gated = true;
    gateY = pGate * runway();
    snapTo(gateY);
    target = eased = T_HOLD;
    issueSeek(T_HOLD);
    setObjX(panFor(pGate));
    lock();
    /* Arriving back at the door is a fresh arrival: Enter walks again and
       the welcome greets again. */
    greeted = false;
    hero!.classList.remove("hero--welcome");
    hero!.classList.remove("hero--leaving");
    showNav(false);
    hero!.setAttribute("data-gated", "");
    door!.hidden = false;
    pops!.hidden = false;
    placeDoor();
    requestAnimationFrame(function () { requestAnimationFrame(function () {
      hero!.classList.add("hero--gated");
      hero!.classList.add("hero--at-door");
      door!.focus({ preventScroll: true });
    }); });
  }

  /* Through the door. Everything about the step is a function of scroll —
     see the portal notes in the stylesheet — so Enter does not run a
     transition of its own. It freezes the first room on the canvas, parks the
     second room on its first frame underneath, hands scroll back, and then
     takes the step for him with an eased scroll through the portal window.
     The same keyframes that answer his wheel answer the click, and going
     back is just the wheel. */
  function smooth(a: number, b: number, x: number) {
    var t = clamp((x - a) / (b - a), 0, 1);
    return t * t * (3 - 2 * t);
  }
  /* After Enter the card fades over the first stretch past the gate and the
     film carries on under it — the doors opening are in the footage, so
     nothing is staged here. Keyed to scroll, so it fades back in on the way
     up; on the band just below the gate it is simply the card again. */
  function drivePortal(p: number) {
    if (leaving) return;                        /* the flip back fades the card itself */
    var k = clamp((p - pGate) / FADE_SPAN, 0, 1);
    var band = p >= pGate - BAND && p < pGate;
    var show = (p >= pGate && k < 1) || band;
    setObjX(p < pGate ? panFor(p) : panFor(pGate) + (50 - panFor(pGate)) * k);
    hold!.hidden = true; bloom!.hidden = true;
    door!.hidden = !show;
    /* The tray and the line come and go with the card: on the way back this
       is the page he left — the card with its links — and not the card
       alone. Shown before the card is placed, since the card is sized
       around the tray. */
    pops!.hidden = !show;
    hero!.classList.toggle("hero--at-door", show);
    if (show) placeDoor();
    var st = hero!.style;
    st.setProperty("--portal", "0");
    st.setProperty("--door-s", "1");
    st.setProperty("--door-o", (show ? 1 - k : 0).toFixed(4));
    st.setProperty("--copy-o", "1"); st.setProperty("--pane-light", "0.18"); st.setProperty("--pane-o", "0.98");
    st.setProperty("--ring-o", "0.85"); st.setProperty("--glow-o", "0.7"); st.setProperty("--bloom", "0");
  }
  function enter() {
    if (transitioning || !gated) return;
    transitioning = true;
    answered = true;
    above = true;
    hero!.setAttribute("data-answered", "");
    hero!.classList.remove("hero--gated");
    try { door!.blur(); } catch (e) {}
    target = eased = T_HOLD;
    unlock();
    gated = false;
    hero!.removeAttribute("data-gated");
    playing = true;
    hero!.classList.add("hero--playing");
    resizeLenis();
    drivePortal(pGate);
    /* Enter takes the step for him: the card fades, the doors in the film
       slide open, the room changes hands, and he arrives at the welcome — the
       click is seen to go somewhere. From there the walk is his, on the
       wheel. A wheel or a finger during the step takes over from it. */
    var fromY = window.scrollY, endY = (pGate + WALK) * runway();
    var t0 = performance.now(), expected = fromY, taken = false;
    /* Any input during the step is intent, and the step yields to it at once.
       Measured against the scroll position alone it would not: the page
       scrolls smoothly, so a wheel or a slow finger moves it a few pixels a
       frame and the step, snapping every frame, would win the wrestle. */
    var take = function () { taken = true; };
    for (var ti = 0; ti < TAKE.length; ti++) window.addEventListener(TAKE[ti], take, { passive: true, capture: true });
    var release = function () { for (var ri = 0; ri < TAKE.length; ri++) window.removeEventListener(TAKE[ri], take, { capture: true } as EventListenerOptions); };
    (function step(now: number) {
      if (taken || cut || Math.abs(window.scrollY - expected) > 40) { transitioning = false; release(); return; }
      var k = clamp((now - t0) / WALK_MS, 0, 1);
      k = k * k * (3 - 2 * k);
      expected = fromY + (endY - fromY) * k;
      snapTo(expected);
      onScroll();
      if (k < 1) requestAnimationFrame(step); else { transitioning = false; release(); }
    })(t0);
    greet(pGate + WALK);
    tellNav();
  }
  door.addEventListener("click", enter);

  /* The welcome: shown once, where the step ends, and dismissed by the first
     scroll that moves him on from it in either direction. */
  var greeted = false, greetP = 0;
  /* Shown the moment Enter is pressed — not at the end of the walk, which
     read as a delay — and anchored to where the walk ends, so it stays up
     through the step and goes with the first scroll of his own. */
  function greet(at: number) {
    if (greeted || !welcome) return;
    greeted = true; greetP = at;
    hero!.classList.add("hero--welcome");
  }
  /* Input that ends a scripted scroll: the walk in, and the flip back. */
  var TAKE = ["wheel", "touchstart", "keydown"];

  /* Up from the door. The gate lets go and the page flips back to the
     landing: an eased scroll to the top with the card, the line and the tray
     fading as it goes and the approach running backwards under them. A wheel
     or a finger during the flip takes over, as with the walk. Portfolio in
     the tray does the same. */
  var leaving = false, LEAVE_MS = 1500;
  function leave() {
    if (!gated || transitioning) return;
    unlock();
    gated = false; transitioning = true; leaving = true; above = false;
    hero!.removeAttribute("data-gated");
    hero!.classList.remove("hero--gated");
    hero!.classList.add("hero--leaving");
    try { door!.blur(); } catch (e) {}
    var fromY = window.scrollY, t0 = performance.now(), expected = fromY, taken = false;
    /* The wheel gesture that asked for this keeps ticking for a few hundred
       milliseconds; that tail is not a new intent. */
    var take = function (e: Event) { if (e.type === "wheel" && performance.now() - t0 < 450) return; taken = true; };
    for (var ti = 0; ti < TAKE.length; ti++) window.addEventListener(TAKE[ti], take, { passive: true, capture: true });
    var end = function () {
      for (var ri = 0; ri < TAKE.length; ri++) window.removeEventListener(TAKE[ri], take, { capture: true } as EventListenerOptions);
      leaving = false; transitioning = false;
      hero!.classList.remove("hero--leaving");
      hero!.classList.remove("hero--at-door");
      door!.hidden = true; pops!.hidden = true;
      showNav(done);
      onScroll();
    };
    (function step(now: number) {
      if (taken || Math.abs(window.scrollY - expected) > 40) { end(); return; }
      var k = clamp((now - t0) / LEAVE_MS, 0, 1);
      k = k * k * (3 - 2 * k);
      expected = fromY * (1 - k);
      snapTo(expected);
      onScroll();
      if (k < 1) requestAnimationFrame(step); else end();
    })(t0);
  }
  /* The nav follows the film: away while it plays, back once it has been
     seen through — and away again whenever the door is the page. */
  function showNav(on: boolean) {
    if (on === hero!.hasAttribute("data-done")) return;
    if (on) hero!.setAttribute("data-done", ""); else hero!.removeAttribute("data-done");
    tellNav();
  }

  /* The film has reached its title card. The runway is cut to where the
     visitor stands, so the next scroll lets the frame go into the page. */
  function finish(skipped: boolean) {
    if (done) return;
    done = true; playing = false;
    hold!.hidden = true; bloom!.hidden = true; door!.hidden = true; pops!.hidden = true;
    hero!.classList.remove("hero--playing");
    hero!.classList.remove("hero--at-door");
    hero!.classList.remove("hero--welcome");
    hero!.setAttribute("data-done", "");
    rail!.style.width = "100%";
    paintBeats(duration);
    unlock();
    gated = false; transitioning = false;
    hero!.removeAttribute("data-gated");
    /* Only a jump cuts the runway. He skipped the film, so there is no reason
       to make him scroll past the space it would have taken — and once cut,
       scroll no longer maps onto the film, so the scrub stops for good. */
    if (skipped) {
      try { video!.pause(); video!.currentTime = Math.max(0, duration - 0.04); } catch (e) {}
      hero!.style.height = (window.scrollY + window.innerHeight) + "px";
      cut = true;
    }
    resizeLenis();
    onScroll();
    tellNav();
  }
  video.addEventListener("ended", function () { finish(false); });
  skip.addEventListener("click", function () { if (playing) finish(true); });

  /* Back to the links, which is where the credentials live. From /landing that
     means actually going home — the whole point is that he lands on the proof
     and can read it. From the home page it is already under him, so it stays a
     scroll rather than a reload. unlock() first either way, because the gate
     holds scroll while the door is up. */
  /* Delegated: in marquee mode the tray is rendered twice, so "back" is two
     elements and neither may carry an id. */
  pops.addEventListener("click", function (ev) {
    if (!(ev.target as HTMLElement).closest("[data-back]")) return;
    (function () {
      if (location.pathname !== "/") { unlock(); location.href = "/"; return; }
      if (gated) { leave(); return; }
      unlock();
      hero!.removeAttribute("data-gated");
      hero!.classList.remove("hero--gated");
      hero!.classList.remove("hero--at-door");
      door!.hidden = true;
      pops!.hidden = true;
      /* lenisOf() rather than a bare `lenis` — the instance is owned by
         scripts/motion.ts and exposed on window; there is no local binding. */
      var l = lenisOf();
      try {
        if (l && typeof l.scrollTo === "function") l.scrollTo(0, { duration: 1.4 });
        else window.scrollTo({ top: 0, behavior: "smooth" });
      } catch (e) { window.scrollTo(0, 0); }
    })();
  });

  /* If the film cannot load, the landing carries the page and the nav returns.
     Everything the film had put up comes down with it — the gate, the card,
     the tray, the welcome — or the door is left standing over a page that
     scrolls, under a nav, with the next section showing beneath it. */
  function bail() {
    if (done) return;
    done = true;
    hero!.classList.remove("hero--ready");
    hero!.setAttribute("data-done", "");
    unlock();
    gated = false; transitioning = false; leaving = false; playing = false;
    hero!.removeAttribute("data-gated"); hero!.removeAttribute("data-answered");
    hero!.classList.remove("hero--gated"); hero!.classList.remove("hero--at-door"); hero!.classList.remove("hero--welcome");
    hero!.classList.remove("hero--playing"); hero!.classList.remove("hero--leaving");
    door!.hidden = true; pops!.hidden = true; hold!.hidden = true; bloom!.hidden = true;
    links!.classList.remove("links--hidden"); hero!.classList.add("hero--landing");
    hero!.style.height = window.innerHeight + "px";
    try { window.scrollTo(0, 0); } catch (e) {}
    resizeLenis();
    tellNav();
  }
  /* A network hiccup mid-film fires `error` as readily as a missing file.
     Once the film has been playing, one reload at the frame we were on is
     tried before the page is given up. */
  var recovered = false;
  video.addEventListener("error", function () {
    if (ready && !recovered && !done) {
      recovered = true;
      var at = eased;
      try { video!.load(); } catch (e) { bail(); return; }
      video!.addEventListener("loadedmetadata", function () {
        settle();
        var kick = video!.play();
        if (kick && kick.then) kick.then(function () { video!.pause(); issueSeek(at); }).catch(function () { issueSeek(at); });
        else issueSeek(at);
      }, { once: true });
      return;
    }
    bail();
  });

  /* ---------- arming ---------- */
  function arm() {
    if (ready) return;
    duration = video!.duration || 0;
    if (!duration) return;
    pGate = T_HOLD / duration;
    WALK = clamp(MORPH_S / (duration - T_HOLD), 0, 1) * (1 - pGate);
    ready = true;
    hero!.classList.add("hero--ready");
    onScroll();
    eased = target;
    requestAnimationFrame(tick);
    /* Deep entry: /landing drops the visitor at the gate. engage() does the rest
       — it snaps scroll to gateY, seeks the hold frame and places the door — so
       the page above still exists and scrolling back reverses the approach. */
    if (hero!.dataset.start === "door" && !answered && !gated) engage();
  }
  /* Order matters: metadata first, THEN the iOS unlock (a muted play() that is
     paused the moment it resolves — Safari refuses currentTime on an element
     that has never played), THEN arm the scrub. */
  function unlockThenArm() {
    var kick = video!.play();
    if (kick && kick.then) {
      kick.then(function () { video!.pause(); arm(); })
          .catch(function () { arm(); });
    } else { arm(); }
  }
  if (video.readyState >= 1) unlockThenArm();
  else video.addEventListener("loadedmetadata", unlockThenArm, { once: true });

  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", function () {
    if (gated) { gateY = pGate * runway(); snapTo(gateY); placeDoor(); }
    onScroll();
  });
  onScroll();
})();
</script>
