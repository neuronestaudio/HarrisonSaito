---
/**
 * Return to Self — the intro film.
 *
 * Replaces the static hero on the home page. Three movements:
 *
 *   1. A social-proof landing over the film's first frame — press, then the
 *      two institutions, then LinkedIn (the Credibility Map's order), the
 *      proof strip, and one gold path in. Clicking the path never navigates:
 *      the proof fades and "Scroll to continue" appears.
 *   2. Scroll scrubs the film through the first room to a held frame, where
 *      the room's own sliding door (cropped from that frame at the rails)
 *      covers the centre doorway and carries the offer. The links sit beside
 *      it. The page will not scroll past this until the visitor goes through.
 *   3. Through the door: the held frame dissolves into room two, which plays
 *      itself at 1.5x to the title card. On `ended` the runway is cut to where
 *      the visitor stands, so the next scroll releases the frame into the page.
 *
 * The nav stays out of the way until the film is done — see Nav.astro, which
 * watches [data-hero-intro][data-done]. Reduced motion gets the landing only.
 *
 * Assets: /video/rts-hero-v4.mp4 and -m (short-GOP H.264 so it can be scrubbed;
 *   720p at CRF 24 for wide screens, CRF 28 for phones — 4.6 / 3.0 MB),
 * /img/rts-hero-poster-v3.webp, /img/rts-hero-end-v3.webp. Versioned names:
 * /video and /img ship with a one-year immutable cache, so a new film under
 * the old name is the old film on every phone that has ever loaded it.
 * Encode and mechanics are documented in the rts-hero-parallax repo.
 */

interface Props {
  /**
   * Where the visitor is dropped in.
   *   'top'  — the landing: proof, links, then the approach on scroll.
   *   'door' — straight to the gate, film skipped. Paid traffic wants the
   *            offer, not the approach; the ad already did that work.
   * Both render the same page, so scrolling up from the door reverses the
   * approach into the landing rather than navigating anywhere.
   */
  start?: 'top' | 'door';
}
const { start = 'top' } = Astro.props;

/**
 * The tray beside the door. Rendered twice on small screens so it can run as a
 * seamless marquee — hence data rather than markup, so the second pass carries
 * no duplicate ids and no second tab stop.
 */
const TRAY = [
  { tag: 'Watch', title: 'Films and video interviews', sub: 'SBS, the dojo films, the archive', href: '/media', art: 'mountains' },
  { tag: 'Read', title: 'Client testimonies', sub: 'Eleven, in their own words', href: '/testimonials', art: 'maple' },
  { tag: 'Discovery call', title: 'Book a chat', sub: 'One-to-one coaching', href: '/book', cta: true, track: 'Intro — Book a chat', art: 'mountains' },
  { tag: 'Lineage', title: 'The Saitos', sub: 'Shinbukan, Chatswood — since 1978', href: 'https://www.shinbukan.com.au/the-saitos', ext: true, art: 'pine' },
  { tag: 'Facebook', title: 'Dojo reviews', sub: 'Shinbukan reviews', href: 'https://www.facebook.com/shinbukanmartialarts/', ext: true, art: 'gate' },
  { tag: 'Back to the start', title: 'Portfolio', sub: 'The proof and the links', back: true, track: 'Intro — Portfolio (back to start)', art: 'ripples' },
];
---

<section class="hero hero--landing" id="hero" data-hero-intro data-start={start} data-section="hero" aria-label="Harrison Saito — Return to Self">
  <div class="hero__frame">
    <img class="hero__fill" src="/img/rts-hero-end-v3.webp" alt="" aria-hidden="true" width="1280" height="720" loading="lazy" decoding="async" />
    <img class="hero__poster" src="/img/rts-hero-poster-v3.webp" alt="" aria-hidden="true" width="1280" height="720" fetchpriority="high" decoding="sync" />
    <video class="hero__video" id="heroVideo" muted playsinline preload="metadata"
           aria-label="A slow walk through a traditional Japanese interior, arriving at the words Return to Self."></video>
    {/* room one, frozen at the door so it can dissolve into room two */}
    <canvas class="hero__hold" id="heroHold" width="1280" height="720" aria-hidden="true" hidden></canvas>
    <div class="hero__scrim" aria-hidden="true"></div>
    {/* The portal's light. Peaks halfway through the step, centred on the
        doorway, and is the reason the join between the two rooms is never on
        screen at the moment it would show. */}
    <div class="hero__bloom" id="heroBloom" aria-hidden="true" hidden></div>

    {/* THE LANDING. Social proof first. Every destination verified live on
        2026-09-03 against the Credibility Map. */}
    <nav class="links links--landing" id="links" aria-label="Harrison Saito, verified">
      <div class="links__inner">
        <h1 class="links__name">Harrison Saito<small>Return to Self · Men's coaching · Chatswood, Sydney</small></h1>

        <ul class="proof" aria-label="At a glance">
          <li><b>SBS News</b><small>National broadcast feature</small></li>
          <li><b>3 generations</b><small>Japanese karate lineage</small></li>
          <li><b>2nd Dan</b><small>Shido-In, Shinbukan</small></li>
          <li><b>Teacher</b><small>NSW Department of Education</small></li>
        </ul>

        <ol class="cred" aria-label="Where a stranger can verify him">
          <li><a class="cred__item" data-art="mountains" data-side="l" href="https://www.sbs.com.au/news/small-business-secrets/article/karate-helps-mental-physcial-health/sglf9zcfw" target="_blank" rel="noopener"><span class="cred__tag">Press</span><span><b>As seen on SBS News</b><small>“A battle of resilience” · 30 May 2026</small></span></a></li>
          <li><a class="cred__item" data-art="bamboo" data-side="r" href="https://www.sbs.com.au/language/japanese/en/podcast-episode/generational-and-cultural-divides-within-a-family-two-cultures-coming-together-at-a-karate-dojo/vlc7i0h27" target="_blank" rel="noopener"><span class="cred__tag">Press</span><span><b>My father and I, at the dojo</b><small>SBS Japanese podcast · 20 May 2026</small></span></a></li>
          <li><a class="cred__item" data-art="pine" data-side="l" href="https://www.sbs.com.au/news/podcast-episode/the-ancient-japanese-skills-helping-young-people-combat-modern-stress/h4sndg8f2" target="_blank" rel="noopener"><span class="cred__tag">Press</span><span><b>The skills helping young people</b><small>SBS News In Depth · 31 May 2026</small></span></a></li>
          <li><a class="cred__item" data-art="hills" data-side="r" href="https://inthecove.com.au/2025/04/12/how-a-japanese-karate-grandmaster-came-to-teach-in-lane-cove/" target="_blank" rel="noopener"><span class="cred__tag">Press</span><span><b>The family dojo, Lane Cove</b><small>In the Cove · April 2025</small></span></a></li>
          <li><a class="cred__item" data-art="gate" data-side="l" href="https://www.shinbukan.com.au/shinbukan-instructors" target="_blank" rel="noopener"><span class="cred__tag">Dojo</span><span><b>Shinbukan 神武館</b><small>Instructor wall · 2nd Dan, Shido-In</small></span></a></li>
          <li><a class="cred__item" data-art="temple" data-side="r" href="https://www.shingon.org.au/about" target="_blank" rel="noopener"><span class="cred__tag">Temple</span><span><b>Seizanji Temple 青山寺</b><small>Kōyasan Shingon · ordained 2014</small></span></a></li>
          <li><a class="cred__item" data-art="ripples" data-side="l" href="https://www.linkedin.com/in/harrison-saito" target="_blank" rel="noopener"><span class="cred__tag">Him</span><span><b>LinkedIn</b><small>Teacher, NSW Department of Education</small></span></a></li>
          <li><a class="cred__item" data-art="maple" data-side="r" href="https://www.youtube.com/@Harrison_saito" target="_blank" rel="noopener"><span class="cred__tag">Him</span><span><b>YouTube</b><small>Films, interviews and dojo practice</small></span></a></li>
        </ol>

        {/* The path in. Click fades the proof and reveals the scroll cue; the href is the no-JS fallback. */}
        <a class="links__path" id="path" data-beam data-art="mountains" data-side="l" href="/mens-coaching" data-track="cta_click" data-track-label="Intro — Men's coaching"><span class="links__path-text"><small>The path in</small><b>Men's coaching</b></span><span class="links__path-go">Begin →</span></a>
      </div>
    </nav>

    <div class="cue" id="cue" aria-hidden="true">
      <p class="cue__lead">Scroll to continue</p>
      <span class="cue__arrow"><span></span></span>
      <span class="cue__tip"></span>
    </div>

    {/* Where Enter arrives. The step through the door is taken for him; this
        is the greeting at the end of it and the one instruction that follows,
        gone the moment he follows it. */}
    <div class="welcome" id="welcome" aria-hidden="true">
      <p class="welcome__lead">Welcome</p>
      <p class="welcome__sub">Scroll to continue</p>
      <span class="cue__arrow"><span></span></span>
      <span class="cue__tip"></span>
    </div>

    {/* THE FORK: under the door on the held frame, two rows of three; a
        marquee across the foot of a phone. Book a chat is the one CTA-styled item. */}
    <nav class="pops" id="pops" aria-label="More from Harrison" hidden>
      {[0, 1].map((band) => (
        <div class="pops__band" data-band={band}>
          {[0, 1].map((pass) => {
            /* Only the first pass of the first band is real. Everything else
               exists to make the loop seamless and the stripes cross, so it is
               hidden from the reader and taken out of the tab order. */
            const ghost = band === 1 || pass === 1;
            return (
              <div class="pops__track" aria-hidden={ghost ? 'true' : undefined}>
                {TRAY.map((t, i) =>
                  t.back ? (
                    <button
                      class:list={['pops__item', 'pops__item--back']}
                      type="button"
                      data-back
                      data-art={t.art}
                      data-side={i % 2 ? 'r' : 'l'}
                      tabindex={ghost ? -1 : undefined}
                      data-track="cta_click"
                      data-track-label={t.track}><span class="pops__tag">{t.tag}</span><b>{t.title}</b><small>{t.sub}</small></button>
                  ) : (
                    <a
                      class:list={['pops__item', { 'pops__item--cta': t.cta }]}
                      href={t.href}
                      data-art={t.art}
                      data-side={i % 2 ? 'r' : 'l'}
                      tabindex={ghost ? -1 : undefined}
                      target={t.ext ? '_blank' : undefined}
                      rel={t.ext ? 'noopener' : undefined}
                      data-track={t.track ? 'cta_click' : undefined}
                      data-track-label={t.track}><span class="pops__tag">{t.tag}</span><b>{t.title}</b><small>{t.sub}</small></a>
                  )
                )}
              </div>
            );
          })}
        </div>
      ))}
    </nav>

    {/* The entrance point, in the empty band above the door. */}
    <p class="door__line" aria-hidden="false">
      Gain agency of your life <em>—</em> to succeed across all domains
    </p>

    {/* THE DOOR. The room's own sliding door over the centre doorway, positioned by script. */}
    <button class="door" id="door" type="button" aria-label="Enter — Return to Self" hidden>
      <span class="door__paper" aria-hidden="true"></span>
      <span class="door__glow" aria-hidden="true"></span>
      <span class="door__ring" aria-hidden="true"></span>
      <span class="door__copy">
        {/* VSL slot. Placeholder until the film is supplied — deliberately a
            real 16:9 box rather than a grey rectangle, so the layout it will
            occupy is the layout being reviewed now. */}
        <small>Return to Self</small>
        <b>Helping high-performing men break old habits and rebuild self-trust.</b>
        <span class="door__vsl" data-vsl aria-hidden="true">
          <span class="door__vsl-play"></span>
          <span class="door__vsl-label">Video</span>
        </span>
        <span class="door__enter">Enter →</span>
      </span>
    </button>

    {/* The last beat. The card in the film says Return To Self; as the scroll
        carries on past it, this arrives beneath — same face, same size, same
        axis as the card's own line — fading and drifting up with the wheel,
        the final thing before the page itself. Placed on the plate, so it sits
        where a second line on the card would sit on any screen. */}
    <p class="hero__program" aria-hidden="true">The Program</p>

    {/* Beats: seconds of film, not scroll. */}
    <div class="hero__beats">
      <div class="beat beat--close" data-beat data-t-in="17.4" data-t-out="999">
        <p class="hero__scrollcue"><span aria-hidden="true"></span>Scroll to continue</p>
        <div class="hero__actions">
          <a class="btn btn--gold" href="/apply" data-track="cta_click" data-track-label="Intro — Apply">Apply</a>
          <a class="btn btn--ghost" href="/book" data-track="cta_click" data-track-label="Intro — Book a call">Book a call</a>
        </div>
      </div>
    </div>

    {/* Room two is scroll-driven, and a frame that only moves when you move
        gives no sign it wants you to. This is that sign, and it goes as soon
        as the film reaches its end. */}
    <div class="hero__more" aria-hidden="true"><span></span></div>

    <button class="hero__skip" id="skip" type="button">Skip to the end</button>
    <div class="hero__rail" aria-hidden="true"><i id="heroRail"></i></div>
  </div>
</section>

<style>
  /* Tokens come from global.css. These are the film's own: the paper is the
     wall the title is written on, sampled from that frame; the door box is the
     centre doorway of the held frame in plate percentages, measured on a 40px
     grid (plate x 460–635, y 198–545). */
  .hero{
    --card-paper:   #E5DAC9;
    --card-paper-2: #DED0BD;
    --card-ink:     #493D2F;
    --card-shadow:  #C8B299;
    --hero-scroll: 500vh;

    /* The scroll behind the glass. Every card and chip on this screen carries
       a cropped piece of it, faded off diagonally so the pattern is there to
       be noticed and never there to be read through. Swap this one line to
       change the paper everywhere. */
    --scroll-tex: url('/img/ink-wash-768.webp');
    --scroll-radius: 16px;

    position:relative; height:var(--hero-scroll); background:var(--ink-900);
    color:var(--text-on-ink); font-family:var(--font-body); font-size:var(--step-0); line-height:1.65;
  }
  .hero [hidden]{display:none!important}

  /* The dynamic viewport, not the small one: sized to 100svh the frame
     stops short of the screen the moment Safari's toolbar collapses, and
     the band it leaves below is black — "it can be dragged up" (Dion, 11
     Sep). dvh follows the toolbar; the layout re-places itself on resize. */
  .hero__frame{
    position:sticky; top:0;
    height:100vh; height:100dvh;
    overflow:hidden;
    background:var(--ink-900);
  }

  .hero__video,.hero__poster{
    position:absolute; inset:0;
    width:100%; height:100%;
    object-fit:cover; object-position:50% 50%;
  }
  /* max-width:none — the site's media reset would otherwise cap the element
     at the viewport when the end zoom sizes it to the plate (see placeFilm). */
  .hero__video{max-width:none; max-height:none}
  /* Behind the end zoom on a portrait phone: the card's own wall, blurred and
     dimmed, so the film shrinks into a room rather than onto black. */
  .hero__fill{
    position:absolute; inset:-6%; width:112%; height:112%; max-width:none; max-height:none;
    object-fit:cover; object-position:50% 50%; pointer-events:none;
    filter:blur(26px) saturate(.9) brightness(.55);
    opacity:var(--film-fill, 0);
  }
  .hero__video{opacity:0; transition:opacity .6s ease}
  .hero--ready .hero__video{opacity:1}
  .hero--ready .hero__poster{opacity:0}
  .hero__poster{transition:opacity .6s ease}

  /* max-width:none — the site's media reset would otherwise cap the canvas at
     the viewport and squash the frozen frame on portrait */
  /* ---- the step through the door -------------------------------------
     Two clips meet at the door and the join between them shows: the second
     room is lit and framed differently from the first. Rather than cut, the
     step is a portal — the last frame of the first room is held on a canvas
     and walked into, the doorway itself turns to light and grows to fill the
     frame, and the new room is only ever revealed under that light. All of it
     is keyed to scroll through --portal (0 at the gate, 1 through), so it
     runs backwards as readily as forwards; nothing here is on a timer. */
  .hero__hold{
    position:absolute; z-index:1; pointer-events:none; max-width:none; max-height:none;
    opacity:var(--hold-o, 1); transform:scale(var(--hold-s, 1));
    transform-origin:var(--bx, 50%) var(--by, 52%);
  }
  .hero__bloom{
    position:absolute; inset:0; z-index:2; pointer-events:none;
    opacity:var(--bloom, 0);
    background:radial-gradient(ellipse 64% 80% at var(--bx, 50%) var(--by, 52%),
      oklch(98.5% 0.022 88) 0%, oklch(97% 0.04 86 / .97) 15%,
      oklch(93.5% 0.07 84 / .78) 34%, oklch(88% 0.08 80 / .34) 56%, transparent 78%);
  }
  /* Sized and placed in plate units — the same 1280x720 the door box lives
     in — so it lands on the card's axis on any crop. 0.132 of the plate's
     height is the card's own 60px cap height; the colour is the card's ink. */
  .hero__program{
    position:absolute; z-index:2; margin:0; pointer-events:none; white-space:nowrap;
    left:calc(var(--plate-x, 0px) + var(--plate-w, 100vw) * .493);
    top:calc(var(--plate-y, 0px) + var(--plate-h, 100vh) * .515);
    font-family:var(--font-display); font-weight:600; line-height:1;
    font-size:min(calc(var(--plate-h, 100vh) * .132), 16vw);
    color:#53412F;
    opacity:var(--program, 0);
    transform:translate(-50%, -50%) translateY(calc((1 - var(--program, 0)) * .32em));
    text-shadow:0 1px 0 oklch(100% 0 0 / .18);
  }

  .hero[data-answered] .door{
    opacity:var(--door-o, 0); pointer-events:none; transition:none;
    transform:scale(var(--door-s, 1)); transform-origin:50% 56%;
  }
  /* Back at the door, locked, it is the card again — and a card that can be
     pressed. The answered rule above turns its pointer events off for the
     fade; while the gate holds it is a button. */
  .hero[data-answered].hero--gated .door{pointer-events:auto}
  .hero[data-answered] .door__copy{opacity:var(--copy-o, 1); transition:none}
  /* The paper stays the paper — the shoji panel — with light rising through
     it as it grows, so what fills the screen is still the door. */
  .hero[data-answered] .door__paper{opacity:var(--pane-o, .98); transition:none}
  .hero[data-answered] .door__glow{animation:none; opacity:var(--glow-o, .7)}
  .hero[data-answered] .door__ring{animation-duration:1.4s; opacity:var(--ring-o, .85)}

  .hero__scrim{
    position:absolute; inset:0; pointer-events:none; z-index:1;
    background:
      linear-gradient(to top,   oklch(11% 0.008 55 / .78) 0%, oklch(11% 0.008 55 / .30) 34%, transparent 58%),
      linear-gradient(to bottom,oklch(11% 0.008 55 / .42) 0%, transparent 26%);
  }
  .hero--landing .hero__scrim{
    background:
      linear-gradient(to top,   oklch(11% 0.008 55 / .82) 0%, oklch(11% 0.008 55 / .55) 40%, oklch(11% 0.008 55 / .30) 100%);
  }

  /* ---------------- the landing ---------------- */
  /* visibility as well as opacity: an invisible link still takes a tap, and
     the landing sits under the door for the whole film. */
  .links{position:absolute; inset:0; z-index:2; pointer-events:none; opacity:1; visibility:visible; transition:opacity .45s ease, visibility 0s linear 0s}
  .links--hidden{opacity:0; visibility:hidden; transition:opacity .45s ease, visibility 0s linear .45s}
  .links__inner{
    position:absolute; left:50%; top:50%; transform:translate(-50%,-52%);
    width:min(46rem, calc(100% - 2.5rem)); display:grid; gap:.8rem; pointer-events:none;
  }
  .links__inner > *{pointer-events:auto; transition:opacity .6s ease}
  .links__name{
    font-family:var(--font-display); font-weight:400; font-size:var(--step-2); letter-spacing:.02em;
    color:var(--text-on-ink); text-align:center; margin:0; pointer-events:none; line-height:1.1;
  }
  .links__name small{display:block; font-family:var(--font-body); font-size:var(--step--1); font-weight:600; letter-spacing:.22em; text-transform:uppercase; color:var(--gold); margin-top:.3rem}

  /* Glass, not a ruled band. Each marker is its own pill so the row reads as
     four separate claims rather than one block of small print, and the blur
     gives the light type something to sit on over a moving frame. */
  .proof{
    list-style:none; margin:0; padding:0;
    display:grid; grid-template-columns:repeat(4,1fr); gap:.5rem; text-align:center;
  }
  .proof li{
    padding:.6rem .75rem; border-radius:calc(var(--scroll-radius) - 3px);
    background:oklch(30% 0.012 60 / .34);
    -webkit-backdrop-filter:blur(16px) saturate(1.15); backdrop-filter:blur(16px) saturate(1.15);
    border:1px solid oklch(92% 0.02 85 / .17);
    box-shadow:inset 0 1px 0 oklch(100% 0 0 / .10), 0 6px 18px oklch(0% 0 0 / .22);
  }
  /* Sits above the card's own background and below its text: a negative
     z-index child paints after the parent background but before inline
     content, so the pattern reads without ever fighting the words. */
  .proof li::before{
    content:''; position:absolute; inset:0; z-index:-1; border-radius:inherit;
    background:var(--scroll-tex) center / cover no-repeat;
    pointer-events:none; opacity:.26;
    -webkit-mask-image:linear-gradient(108deg, #000 0%, oklch(0% 0 0 / .5) 42%, transparent 88%);
    mask-image:linear-gradient(108deg, #000 0%, oklch(0% 0 0 / .5) 42%, transparent 88%);
  }
  .proof li{position:relative; isolation:isolate}
  /* The ink on each card: one sumi motif, drawn at the card's height on one
     edge and fading toward the words — mountains, bamboo, pine, the gate, the
     temple, ripples, maple. They alternate sides down the column so the stack
     reads as a scroll rather than a list. Each image is composed left-heavy
     and mirrored for the right; scripts/sumi/motifs.mjs draws and rasterises
     them. */
  .cred__item::before,
  .pops__item::before,
  .links__path::before{
    content:''; position:absolute; inset:0; z-index:-1; border-radius:inherit; pointer-events:none;
    background:var(--art) left center / auto 100% no-repeat;
    opacity:.62;
  }
  [data-side="r"]::before{transform:scaleX(-1)}
  [data-art="mountains"]{--art:url('/img/sumi-mountains-v1.webp')}
  [data-art="bamboo"]{--art:url('/img/sumi-bamboo-v1.webp')}
  [data-art="pine"]{--art:url('/img/sumi-pine-v1.webp')}
  [data-art="hills"]{--art:url('/img/sumi-hills-v1.webp')}
  [data-art="gate"]{--art:url('/img/sumi-gate-v1.webp')}
  [data-art="temple"]{--art:url('/img/sumi-temple-v1.webp')}
  [data-art="ripples"]{--art:url('/img/sumi-ripples-v1.webp')}
  [data-art="maple"]{--art:url('/img/sumi-maple-v1.webp')}
  /* The tray's cards are narrow, so their ink is drawn a little smaller and
     lighter, tucked into the corner rather than filling the edge. */
  .pops__item::before{background-size:auto 80%; opacity:.5}
  /* On the gold the mountains sit in the paint rather than on it. */
  .links__path::before,.pops__item--cta::before{opacity:.3; mix-blend-mode:multiply}

  .proof b{display:block; font-family:var(--font-display); font-weight:400; font-size:var(--step-1); color:var(--text-on-ink); line-height:1.1}
  .proof small{display:block; font-family:var(--font-body); font-size:.62rem; font-weight:600; letter-spacing:.16em; text-transform:uppercase; color:var(--text-on-ink-faint); margin-top:.2rem}

  /* Two columns on a wide screen — a single stack of eight is taller than a
     768px laptop — with the ink on the outer edge of each: the L/R/L/R
     alternation in the markup lands as left column left, right column right.
     Under 760px it is the one column of the design, alternating down. */
  .cred{list-style:none; margin:0; padding:0; display:grid; grid-template-columns:1fr 1fr; gap:.5rem .8rem}
  @media (max-width:760px){
    .cred{grid-template-columns:1fr; gap:.5rem}
    .links__inner{width:min(40rem, calc(100% - 2.5rem))}
  }
  .cred__item{
    /* Centred, tag over title. The proof strip above and the path bar below
       both sit on the centre line; these cards were the one thing left reading
       off a left margin, which is what made the screen look untidy rather than
       off-centre. */
    display:grid; grid-template-columns:1fr; gap:.22rem; justify-items:center; text-align:center;
    text-decoration:none; color:var(--card-ink);
    background:color-mix(in oklab, var(--card-paper) 80%, transparent);
    -webkit-backdrop-filter:blur(16px) saturate(1.15); backdrop-filter:blur(16px) saturate(1.15);
    border:1px solid color-mix(in oklab, var(--card-shadow) 62%, transparent);
    border-radius:var(--scroll-radius); position:relative; isolation:isolate;
    box-shadow:inset 0 1px 0 oklch(100% 0 0 / .34), 0 6px 18px oklch(0% 0 0 / .2);
    padding:.6rem 1.15rem;
    transition:background .3s ease, border-color .3s ease;
  }
  .cred__tag{font-family:var(--font-body); font-size:.58rem; font-weight:600; letter-spacing:.2em; text-transform:uppercase; color:var(--gold-deep); padding-top:.28rem; white-space:nowrap}
  .cred__item b{display:block; font-family:var(--font-display); font-weight:500; font-size:var(--step-0); line-height:1.15}
  /* The dated source line stays in the link's name for a screen reader; on
     screen the card is the tag and the title, as designed. */
  .cred__item small,.pops__item small{position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap}
  .cred__item:hover,.cred__item:focus-visible{background:var(--card-paper); border-color:var(--gold-deep); outline:none}
  .cred__item:focus-visible{box-shadow:0 0 0 2px var(--gold-deep)}

  /* Centred. Label left and button right read as a toolbar, which is the one
     thing this is not — it is the single intended click on the screen, and it
     should look like a destination rather than a row of controls. */
  .links__path{
    display:grid; grid-template-columns:1fr; justify-items:center; text-align:center; gap:.3rem;
    text-decoration:none; color:var(--ink-900); border:1px solid oklch(87% 0.11 80 / .9);
    background:linear-gradient(112deg, oklch(69% 0.135 66) 0%, var(--gold) 48%, oklch(83% 0.12 80) 100%);
    border-radius:calc(var(--scroll-radius) + 2px); box-shadow:0 8px 26px oklch(0% 0 0 / .3);
    padding:.9rem 1.6rem; transition:background .3s ease, border-color .3s ease;
  }
  .links__path-text{display:block}
  .links__path b{display:block; font-family:var(--font-display); font-weight:500; font-size:var(--step-2); line-height:1.1}
  .links__path small{display:block; font-family:var(--font-body); font-size:.64rem; font-weight:600; letter-spacing:.2em; text-transform:uppercase; opacity:.72; margin-bottom:.15rem}
  .links__path-go{font-family:var(--font-body); font-size:var(--step--1); font-weight:600; letter-spacing:.14em; text-transform:uppercase; white-space:nowrap}
  .links__path:hover,.links__path:focus-visible{background:linear-gradient(112deg, var(--gold) 0%, var(--gold-light) 55%, oklch(88% 0.10 82) 100%); border-color:var(--gold-light); outline:none}
  .links__path:focus-visible{box-shadow:0 0 0 2px var(--ink-900)}

  /* The same travelling beam the door carries, so a moving gold edge means one
     thing everywhere on this page: this is the way through. The tray beside it
     is a list of places to look; this is the single intended click, and on
     landing it should be obvious which is which without reading.

     The segment is near-white rather than gold — the button is already gold,
     so a gold beam on it would not read. Sits entirely outside the border box
     via inset/padding + an excluded mask, so it never touches the label. */
  .links__path{position:relative; isolation:isolate}
  .links__path::after{
    content:''; position:absolute; inset:-5px; padding:5px; pointer-events:none;
    border-radius:calc(var(--scroll-radius) + 7px);
    background:conic-gradient(from var(--sweep),
      oklch(88% 0.09 82 / .10) 0 58%, oklch(94% 0.07 84 / .55) 76%, oklch(99% 0.03 90) 88%, oklch(88% 0.09 82 / .10) 100%);
    -webkit-mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite:xor;
    mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite:exclude;
    filter:drop-shadow(0 0 7px oklch(92% 0.08 82 / .6));
    animation:sweep 2.6s linear infinite;
  }
  /* Once he has chosen the path there is nothing left to point at. */
  .links[data-chosen] .links__path::after{animation:none; opacity:0; transition:opacity .4s ease}

  .links[data-chosen] .links__inner > *{opacity:0; pointer-events:none}
  .links[data-chosen] .links__path{transition-delay:.3s}

  .cue{
    position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
    z-index:2; text-align:center; pointer-events:none;
    opacity:0; transition:opacity .6s ease .45s;
  }
  .cue--on{opacity:1}
  .cue__lead{font-family:var(--font-display); font-weight:400; font-size:var(--step-2); color:var(--text-on-ink); margin:0 0 .6rem; letter-spacing:.01em; white-space:nowrap}
  .cue__arrow{display:block; width:1px; height:52px; margin:0 auto; background:var(--rule-on-ink); position:relative; overflow:hidden}
  .cue__arrow span{position:absolute; top:-45%; left:0; width:100%; height:45%; background:var(--gold); animation:cue 2.2s cubic-bezier(.6,0,.4,1) infinite}
  .cue__tip{display:block; width:9px; height:9px; margin:-5px auto 0; border-right:1px solid var(--gold); border-bottom:1px solid var(--gold); transform:rotate(45deg)}
  @keyframes cue{0%{top:-45%}60%,100%{top:100%}}
  .hero[data-progress-past] .cue{opacity:0; transition-delay:0s}

  /* ---------------- the fork ---------------- */
  /* Under the door, two rows of three, as wide as the line above the card.
     Placed by placeDoor(), which also shortens the card to make the room. */
  .pops{
    position:absolute; z-index:4; width:min(44rem, calc(100% - 3rem));
    display:grid; grid-template-columns:repeat(3, 1fr); gap:.6rem .7rem;
    opacity:0; pointer-events:none; transition:opacity .4s ease;
  }
  /* Under the door the track is not a box at all — the items are the grid.
     The second pass exists only for the marquee and stays out of the way. */
  .pops__band,.pops__track{display:contents}
  .pops__track[aria-hidden="true"]{display:none}
  .hero--at-door .pops{opacity:1; pointer-events:auto}
  .hero--tray-crowded .pops{opacity:0; pointer-events:none}
  /* On the way back the tray fades in with the card, at the card's opacity. */
  .hero[data-answered]:not(.hero--tray-crowded) .pops{opacity:var(--door-o, 0); transition:none}
  .hero--tray-single .pops__band[data-band="1"]{display:none}
  .pops__item{
    display:grid; grid-template-columns:1fr; gap:.22rem; justify-items:center; text-align:center;
    text-decoration:none; color:var(--card-ink);
    background:color-mix(in oklab, var(--card-paper) 84%, transparent);
    -webkit-backdrop-filter:blur(12px); backdrop-filter:blur(12px);
    border:1px solid color-mix(in oklab, var(--card-shadow) 62%, transparent);
    border-radius:var(--scroll-radius); position:relative; isolation:isolate;
    box-shadow:inset 0 1px 0 oklch(100% 0 0 / .34), 0 6px 18px oklch(0% 0 0 / .2);
    padding:.65rem 1.25rem; transform:translateX(18px); opacity:0;
    transition:background .3s ease, border-color .3s ease;
  }
  .hero--at-door .pops__item{animation:popin .6s cubic-bezier(.22,.61,.36,1) forwards}
  .pops__item:nth-child(2){animation-delay:.08s}
  .pops__item:nth-child(3){animation-delay:.16s}
  .pops__item:nth-child(4){animation-delay:.24s}
  .pops__item:nth-child(5){animation-delay:.32s}
  @keyframes popin{to{transform:none; opacity:1}}
  .pops__item b{display:block; font-family:var(--font-display); font-weight:500; font-size:var(--step-1); line-height:1.15; text-wrap:balance}
  .pops__tag{font-family:var(--font-body); font-size:.58rem; font-weight:600; letter-spacing:.2em; text-transform:uppercase; color:var(--gold-deep); padding-top:.28rem; white-space:nowrap}
  .pops__item:hover,.pops__item:focus-visible{background:var(--card-paper); border-color:var(--gold-deep); outline:none}
  .pops__item:focus-visible{box-shadow:0 0 0 2px var(--gold-deep)}
  .pops__item--back{width:100%; font:inherit; cursor:pointer}
  .pops__item--cta{
    color:var(--ink-900); border-color:oklch(87% 0.11 80 / .9);
    background:linear-gradient(112deg, oklch(69% 0.135 66) 0%, var(--gold) 48%, oklch(83% 0.12 80) 100%);
  }
  .pops__item--cta .pops__tag{color:oklch(30% 0.03 60 / .78)}
  .pops__item--cta:hover,.pops__item--cta:focus-visible{background:linear-gradient(112deg, var(--gold) 0%, var(--gold-light) 55%, oklch(88% 0.10 82) 100%); border-color:var(--gold-light)}

  /* ---------------- the door ---------------- */
  /* The band above the door was dead screen. This is the entrance point: what
     the twelve weeks are actually for, said once, before the offer. */
  .door__line{
    position:absolute; z-index:3; left:50%; translate:-50% 0;
    top:clamp(1.8rem, 8vh, 5.5rem);
    width:min(92vw, 60rem); margin:0; text-align:center; text-wrap:balance;
    font-family:var(--font-display); font-weight:400;
    font-size:clamp(.95rem, 1.85vw, 1.3rem); line-height:1.5;
    letter-spacing:.2em; text-transform:uppercase;
    /* A sheen crossing the letters, in place of the old static glow: the
       type is a window onto a moving gradient, and what is left of the light
       around it is a soft halo rather than a blaze. */
    color:transparent;
    background:linear-gradient(100deg,
      oklch(94% 0.02 88) 0%, oklch(94% 0.02 88) 38%, oklch(99.5% 0.04 92) 47%, oklch(90% 0.10 84) 52%, oklch(94% 0.02 88) 60%, oklch(94% 0.02 88) 100%);
    background-size:260% 100%; background-position:100% 0;
    -webkit-background-clip:text; background-clip:text;
    filter:drop-shadow(0 0 10px oklch(88% 0.10 82 / .4)) drop-shadow(0 0 26px oklch(80% 0.09 80 / .22));
    animation:lineshine 5.2s ease-in-out infinite;
    opacity:0; pointer-events:none; transition:opacity 1s ease .3s;
  }
  @keyframes lineshine{0%,18%{background-position:100% 0} 62%,100%{background-position:0% 0}}
  .door__line em{font-style:normal; color:transparent}
  .hero--at-door .door__line{opacity:1}
  .hero[data-answered] .door__line{opacity:var(--door-o, 0); transition:none}
  /* No room for it on a short screen — the door has to win there. */
  @media (max-height:560px){ .door__line{display:none} }

  .door{
    position:absolute; z-index:3; display:block;
    background:none; border:0; padding:0; cursor:pointer; text-align:center;
    opacity:0; pointer-events:none;
    transition:opacity 1.1s ease;
  }
  .hero--at-door .door{opacity:1; pointer-events:auto; transition-duration:.7s}
  .door__paper{
    position:absolute; inset:0; border-radius:var(--scroll-radius);
    background:
      linear-gradient(180deg, oklch(100% 0 0 / .22), transparent 38%),
      var(--scroll-tex) center / cover no-repeat,
      linear-gradient(180deg, var(--card-paper), var(--card-paper-2));
    background-blend-mode:normal, soft-light, normal;
    box-shadow:inset 0 1px 0 oklch(100% 0 0 / .45), inset 0 0 0 1px oklch(11% 0.008 55 / .16), 0 30px 70px -28px oklch(11% 0.008 55 / .6);
    transition:filter .3s ease, box-shadow .3s ease;
  }
  .door__glow{
    position:absolute; inset:0; z-index:1; pointer-events:none;
    background:radial-gradient(130% 90% at 50% 46%, oklch(97% 0.03 85 / .78) 0%, oklch(96% 0.03 85 / .48) 42%, oklch(96% 0.03 85 / .28) 100%);
    mix-blend-mode:screen; opacity:.72;
    animation:breathe 4.4s ease-in-out infinite alternate;
  }
  @keyframes breathe{from{opacity:.58} to{opacity:.9}}
  /* the beam: a 5px ring just outside the panel with a bright segment that
     travels the edge — the cue that the door is the thing to press. The faint
     base track keeps the outline visible all the way round. */
  @property --sweep{syntax:'<angle>'; inherits:false; initial-value:0deg}
  .door__ring{
    position:absolute; inset:-5px; z-index:3; pointer-events:none; padding:5px; border-radius:calc(var(--scroll-radius) + 5px);
    background:conic-gradient(from var(--sweep),
      oklch(84% 0.11 78 / .16) 0 62%, oklch(84% 0.11 78 / .45) 78%, oklch(92% 0.10 80) 90%, oklch(84% 0.11 78 / .16) 100%);
    -webkit-mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite:xor;
    mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite:exclude;
    filter:drop-shadow(0 0 6px oklch(84% 0.11 78 / .55));
    animation:sweep 2.6s linear infinite;
  }
  @keyframes sweep{to{--sweep:360deg}}
  .door__copy{
    position:absolute; inset:0; width:100%; height:100%; box-sizing:border-box; min-width:0;
    z-index:2; display:grid; grid-template-columns:minmax(0, 1fr); align-content:center; justify-items:center; gap:.85rem;
    padding:1.1rem 1rem; color:var(--card-ink);
  }
  .door__copy small{
    font-family:var(--font-body); font-weight:700; text-transform:uppercase; color:var(--card-ink);
    font-size:clamp(.9rem, calc(var(--dw, 480px) * .042), 1.25rem); letter-spacing:.13em; margin-right:-.13em;
    white-space:nowrap;
  }
  .door__copy b{font-family:var(--font-display); font-weight:400; font-size:clamp(1.1rem, calc(var(--dw, 480px) * .056), 1.55rem); line-height:1.24; text-wrap:balance}
  .door__enter{
    position:relative; isolation:isolate; overflow:hidden;
    font-family:var(--font-body); font-size:clamp(.95rem, calc(var(--dw, 480px) * .036), 1.15rem); font-weight:700; letter-spacing:.24em; text-transform:uppercase;
    color:var(--ink-900); border:1px solid oklch(88% 0.10 80 / .95); border-radius:13px;
    background:linear-gradient(112deg, oklch(69% 0.135 66) 0%, var(--gold) 46%, oklch(84% 0.12 80) 100%);
    width:100%; box-sizing:border-box; padding:1.45rem 1rem; margin-top:.3rem;
    animation:enterglow 3.2s ease-in-out infinite;
    transition:filter .3s ease;
  }
  /* The shine: a bar of light crossing the button under the words, on the
     same clock as the ring around the door; and the glow breathing with it. */
  .door__enter::after{
    content:''; position:absolute; inset:-30% -20%; z-index:-1; pointer-events:none;
    background:linear-gradient(105deg, transparent 38%, oklch(100% 0 0 / .18) 45%, oklch(100% 0 0 / .62) 50%, oklch(100% 0 0 / .18) 55%, transparent 62%);
    transform:translateX(-90%);
    animation:entershine 3.2s cubic-bezier(.5,0,.3,1) infinite;
  }
  @keyframes entershine{0%,10%{transform:translateX(-90%)} 60%,100%{transform:translateX(90%)}}
  @keyframes enterglow{
    0%,100%{box-shadow:inset 0 1px 0 oklch(100% 0 0 / .5), inset 0 -1px 0 oklch(48% 0.10 64 / .4), 0 12px 30px -12px oklch(64% 0.13 68 / .9), 0 0 0 0 oklch(84% 0.11 78 / 0)}
    50%{box-shadow:inset 0 1px 0 oklch(100% 0 0 / .62), inset 0 -1px 0 oklch(48% 0.10 64 / .4), 0 14px 34px -10px oklch(70% 0.13 70 / 1), 0 0 24px 3px oklch(84% 0.11 78 / .34)}
  }
  .door:hover .door__paper,.door:focus-visible .door__paper{filter:brightness(1.04)}
  .door:hover .door__glow,.door:focus-visible .door__glow{animation-play-state:paused; opacity:.92}
  .door:hover .door__ring,.door:focus-visible .door__ring{animation-duration:1.6s}
  .door:hover .door__enter,.door:focus-visible .door__enter{filter:brightness(1.07) saturate(1.05)}
  .door:focus-visible{outline:none}

  /* ---------------- beats, after the door ---------------- */
  /* Sits above the two closing CTAs: the film has finished, but the page has
     not — without this the end of the reel reads as the end of the site. */
  .hero__scrollcue{
    display:flex; align-items:center; gap:.55rem; margin:0 0 .85rem;
    font-family:var(--font-body); font-size:.66rem; font-weight:700;
    letter-spacing:.22em; text-transform:uppercase; color:oklch(93% 0.005 60 / .58);
  }
  .hero__scrollcue span{
    width:1px; height:22px; background:var(--rule-on-ink); position:relative; overflow:hidden; flex:0 0 auto;
  }
  .hero__scrollcue span::after{
    content:''; position:absolute; left:0; top:-45%; width:100%; height:45%;
    background:var(--gold); animation:cue 2.2s cubic-bezier(.6,0,.4,1) infinite;
  }

  /* The VSL slot inside the door. The panel is a narrow shoji, so the box is
     sized off its width and stays 16:9 — if the finished film needs more room
     than this, the door is the wrong home for it and it moves out. */
  .door__vsl{
    display:block; width:100%; max-width:100%; aspect-ratio:16/9; position:relative;
    min-height:0; max-height:100%; justify-self:center;
    background:oklch(24% 0.012 60); border:1px solid oklch(11% 0.008 55 / .28);
    display:grid; place-items:center; gap:.3rem;
  }
  .door__vsl-play{
    width:0; height:0; border-left:14px solid oklch(96% 0.02 85 / .92);
    border-top:9px solid transparent; border-bottom:9px solid transparent;
    margin-left:3px;
  }
  .door__vsl-label{
    position:absolute; bottom:.3rem; left:0; right:0; text-align:center;
    font-family:var(--font-body); font-size:.5rem; font-weight:700;
    letter-spacing:.2em; text-transform:uppercase; color:oklch(96% 0.02 85 / .5);
  }

  .hero__beats{position:absolute; inset:0; z-index:2; display:grid; place-items:end start; padding:0 clamp(1.5rem,5vw,5.5rem) clamp(3.5rem,9vh,6.5rem); pointer-events:none}
  .hero__beats a{pointer-events:auto}
  .beat{grid-area:1/1; max-width:38rem; opacity:0; transform:translateY(14px); transition:opacity .4s ease-out, transform .4s ease-out; will-change:opacity,transform}
  .beat[data-on]{opacity:1; transform:none; transition:opacity .9s cubic-bezier(.22,.61,.36,1), transform .9s cubic-bezier(.22,.61,.36,1)}
  .beat__line{font-family:var(--font-display); font-weight:300; font-size:var(--step-4); line-height:1.08; letter-spacing:-.01em; color:var(--text-on-ink); margin:0; text-wrap:balance}
  .beat__line em{font-style:italic; color:var(--gold-light)}
  .beat__sub{font-size:var(--step-1); color:var(--text-on-ink-muted); margin:1rem 0 0; max-width:34rem; font-weight:300}
  .beat--close{justify-self:center; text-align:center}
  .beat--close .hero__actions{justify-content:center; margin-top:0}
  .beat__line--portrait{display:none; font-size:var(--step-3); margin-bottom:1.4rem}
  @media (orientation:portrait) and (max-width:760px){
    .beat__line--portrait{display:block}
  }
  .hero__actions{display:flex; flex-wrap:wrap; gap:.85rem; margin-top:1.8rem}
  .btn{display:inline-block; font-family:var(--font-body); font-size:var(--step--1); font-weight:600; letter-spacing:.14em; text-transform:uppercase; padding:.95rem 1.9rem; border-radius:1px; text-decoration:none; transition:background .3s ease, color .3s ease, border-color .3s ease}
  .btn--gold{background:var(--gold); color:var(--ink-900); border:1px solid var(--gold)}
  .btn--gold:hover{background:var(--gold-light); border-color:var(--gold-light)}
  .btn--ghost{background:transparent; color:var(--text-on-ink); border:1px solid var(--rule-on-ink)}
  .btn--ghost:hover{border-color:var(--gold); color:var(--gold-light)}
  .btn:focus-visible{outline:2px solid var(--gold); outline-offset:3px}

  .hero__skip{
    position:absolute; right:clamp(1.5rem,5vw,5.5rem); bottom:clamp(1.6rem,5vh,3rem); z-index:3;
    background:none; border:0; padding:.4rem 0; cursor:pointer;
    font-family:var(--font-body); font-size:.66rem; font-weight:600; letter-spacing:.2em; text-transform:uppercase;
    color:var(--text-on-ink-faint); border-bottom:1px solid var(--rule-on-ink);
    opacity:0; pointer-events:none; transition:opacity .6s ease .8s, color .3s ease;
  }
  .hero--playing .hero__skip{opacity:1; pointer-events:auto}
  .hero:not(.hero--playing) .hero__skip{transition-delay:0s; transition-duration:.25s}
  .hero__skip:hover,.hero__skip:focus-visible{color:var(--gold-light); outline:none}

  .hero__more{
    position:absolute; z-index:3; left:50%; top:68%; translate:-50% 0;
    width:2.9rem; height:2.9rem; display:grid; place-items:center;
    border:1px solid oklch(88% 0.09 82 / .5); border-radius:50%;
    background:oklch(20% 0.02 60 / .28); -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px);
    opacity:0; pointer-events:none; transition:opacity .6s ease;
  }
  .hero__more span{
    width:.62rem; height:.62rem; margin-top:-.16rem;
    border-right:1.5px solid var(--gold-light); border-bottom:1.5px solid var(--gold-light);
    rotate:45deg; animation:morebob 1.9s ease-in-out infinite;
  }
  @keyframes morebob{0%,100%{transform:translateY(-2px); opacity:.55} 50%{transform:translateY(3px); opacity:1}}
  .hero--playing:not([data-done]) .hero__more{opacity:1}

  /* ---------------- the welcome ----------------
     Enter walks him through the door; this is what he arrives at, in the
     middle of the screen: the greeting and the one instruction. The small
     bobbing sign waits its turn. */
  .welcome{
    position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
    z-index:3; text-align:center; pointer-events:none; opacity:0; transition:opacity .8s ease;
  }
  .welcome__lead{font-family:var(--font-display); font-weight:300; font-size:var(--step-4); line-height:1; color:var(--text-on-ink); margin:0 0 .55rem; letter-spacing:.02em; text-shadow:0 2px 28px oklch(0% 0 0 / .55)}
  .welcome__sub{font-family:var(--font-body); font-size:var(--step--1); font-weight:600; letter-spacing:.26em; text-transform:uppercase; white-space:nowrap; color:var(--gold-light); margin:0 0 .9rem; text-shadow:0 1px 14px oklch(0% 0 0 / .5)}
  .hero--welcome .welcome{opacity:1; transition-duration:.7s}
  /* The flip back to the landing: the card, its line and the tray go
