---
/**
 * A seat, applied for in one step — then the windows for the call.
 *
 * The site's lead form (LeadForm.astro) walks three questions before it asks
 * for a name, because a coaching enquiry earns that. A seat at a three-person
 * room does not: Dion's brief for /workshop (25 Sep 2026) is "very minimal
 * friction", so this is the contact step of that form on its own — which
 * session, a name, a phone, an email, one optional line, the consent line.
 *
 * Dion, 26 Sep: "two dates, 1–2 pm on the third and the fourth. Then they
 * see: thank you, your spot is under review and Harrison will reach out
 * directly — please select a window for him to call you. When they apply,
 * they get into the workshop." So the session is chosen up front, and the
 * thank-you screen asks one more thing: when he can call.
 *
 * Dion, later that day: "time-block hours to select, UI/UX high end." So the
 * window is not a broad "weekday evenings" any more but real blocks (two
 * hours each since 30 Sep — 8 am to 8 pm, six a day; FORM.call says):
 * a strip of the next seven days (Sydney time, drawn in the browser so it is
 * always current), the blocks that day has (weekday afternoons and evenings,
 * weekend mornings — Harrison teaches), and up to three picks across days.
 * A quiet "I'm flexible" is the way out for people who do not want to choose.
 * The hours live in workshop.ts (FORM.call); nothing here knows a time.
 *
 * The picks go up as a second post against the same email, so the contact in
 * GHL gains the windows without a second lead being counted (it fires as
 * Schedule): `timing` is the machine list ("2026-09-28 17:00-18:00; …") and
 * `timing_label` the sentence Harrison reads in "when suits" ("Mon 28 Sep,
 * 5–6 pm or 6–7 pm; or Wed 30 Sep, 4–5 pm (Sydney)").
 *
 * It posts the same shape to /api/lead as the big form does (form_id, about,
 * event_id, page_url, the badge-set tags from sessionStorage, fbc/fbp), so
 * the lead lands in GHL tagged form-<id>, enquiry-<about> and (email is
 * optional since 27 Sep — GHL then upserts on the phone, which every post
 * carries)
 * session-<id>, with the session in the "topic" field and the windows in
 * "when suits" — the fields that already exist — and nothing downstream has
 * to learn a new payload.
 */
import { whatsappLink } from '../data/site';

export type Session = { id: string; label: string; time: string };
export type CallConfig = {
  /** IANA zone the blocks are drawn in — Harrison's, not the visitor's */
  tz: string;
  /** how many days to offer, and how many days out the first one is */
  days: number;
  from: number;
  /** block start hours (24h); every block runs one hour */
  weekday: number[];
  weekend: number[];
  /** picks allowed across all days */
  max: number;
  hint: string;
  /** "{n} of {max}" */
  countLabel: string;
  confirm: string;
  flexible: string;
  flexibleLabel: string;
};

interface Props {
  formId: string;
  /** rides into GHL as enquiry-<about> and the "about" custom field */
  about: string;
  aboutLabel: string;
  /** the rooms on offer — one must be picked */
  sessions: Session[];
  sessionLabel: string;
  submitLabel: string;
  /** the thank-you: the spot is under review, pick the windows for the call */
  successHeading: string;
  successBody: string;
  callLabel: string;
  call: CallConfig;
  /** after the windows are picked; `{window}` is replaced with their picks */
  doneHeading: string;
  doneBody: string;
  /** the pre-written WhatsApp message, for the direct route */
  whatsapp: string;
  /** GA4 / Meta event fired on the application */
  eventName?: string;
  /** one optional line in their words. Lands in the lead as `note`. */
  ask?: { label: string; placeholder: string };
}

const {
  formId, about, aboutLabel, sessions, sessionLabel, submitLabel,
  successHeading, successBody, callLabel, call, doneHeading, doneBody,
  whatsapp, eventName = 'lead', ask,
} = Astro.props;
---

<div class="sf" data-seat-form={formId} data-event={eventName} data-done-body={doneBody}>
  <form class="sf__form" novalidate>
    {/* ---- which room ---- */}
    <fieldset class="sf__sessions">
      <legend class="sf__label">{sessionLabel}</legend>
      <div class="sf__tiles" role="radiogroup" aria-label={sessionLabel}>
        {sessions.map((s) => (
          <button type="button" class="sf__tile" role="radio" aria-checked="false" data-session={s.id} data-label={`${s.label} · ${s.time}`}>
            <span class="sf__tile-label">{s.label}</span>
            <span class="sf__tile-hint">{s.time}</span>
            <span class="sf__tile-mark" aria-hidden="true"></span>
          </button>
        ))}
      </div>
      <input type="hidden" name="session" value="" />
      <input type="hidden" name="session_label" value="" />
      <p class="sf__error" data-error-for="session" hidden></p>
    </fieldset>

    <div class="sf__fields">
      <div class="sf__field sf__field--wide">
        <label class="sf__label" for={`${formId}-name`}>Your name</label>
        <input class="sf__input" id={`${formId}-name`} name="name" type="text" required autocomplete="name" placeholder="First and last" />
        <p class="sf__error" data-error-for="name" hidden></p>
      </div>
      <div class="sf__field">
        <label class="sf__label" for={`${formId}-phone`}>Phone</label>
        <input class="sf__input" id={`${formId}-phone`} name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="04…" />
        <p class="sf__error" data-error-for="phone" hidden></p>
      </div>
      <div class="sf__field">
        <label class="sf__label" for={`${formId}-email`}>Email <span class="sf__optional">optional</span></label>
        <input class="sf__input" id={`${formId}-email`} name="email" type="email" autocomplete="email" placeholder="you@…" />
        <p class="sf__error" data-error-for="email" hidden></p>
      </div>
    </div>

    {ask && (
      <div class="sf__field sf__field--wide sf__field--ask">
        <label class="sf__label" for={`${formId}-note`}>{ask.label} <span class="sf__optional">optional</span></label>
        <textarea class="sf__input sf__textarea" id={`${formId}-note`} name="note" rows="3" maxlength="400" placeholder={ask.placeholder}></textarea>
      </div>
    )}

    <label class="sf__consent">
      <input type="checkbox" name="consent" required />
      <span>
        I agree to Harrison Saito storing these details in order to reply. See the
        <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.
      </span>
    </label>

    <input type="hidden" name="about" value={about} />
    <input type="hidden" name="about_label" value={aboutLabel} />

    {/* Honeypot — bots fill it, humans never see it. */}
    <div class="sf__pot" aria-hidden="true">
      <label for={`${formId}-website`}>Website</label>
      <input id={`${formId}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <button type="submit" class="sf__submit" data-submit>
      <span>{submitLabel}</span><span aria-hidden="true">→</span>
    </button>
    <p class="sf__help">A phone number so Harrison can call, rather than trade emails for a week.</p>

    <p class="sf__formerror" data-form-error hidden role="alert"></p>
  </form>

  {/* ---- thank you: under review, pick the windows ---- */}
  <div class="sf__success" data-success hidden tabindex="-1">
    <span class="sf__success-rule" aria-hidden="true"></span>
    <h3>{successHeading}</h3>
    <p>{successBody}</p>

    <div class="sf__call" data-call-root data-call-config={JSON.stringify(call)}>
      <div class="sf__call-head">
        <p class="sf__label sf__call-label" id={`${formId}-call-label`}>{callLabel}</p>
        <p class="sf__count" data-count aria-live="polite"></p>
      </div>
      <p class="sf__call-hint">{call.hint}</p>

      {/* the day strip: drawn by the script from today, in Sydney time */}
      <div class="sf__days" role="radiogroup" aria-labelledby={`${formId}-call-label`} data-days></div>

      {/* that day's blocks (FORM.call.block hours each) */}
      <p class="sf__hours-day" data-hours-day aria-live="polite"></p>
      <div class="sf__hours" role="group" aria-label="One-hour windows" data-hours></div>

      {/* what they have picked so far, each removable */}
      <div class="sf__picks" data-picks hidden></div>

      <button type="button" class="sf__submit sf__confirm" data-confirm disabled>
        <span>{call.confirm}</span><span aria-hidden="true">→</span>
      </button>
      <button type="button" class="sf__flex" data-flexible>{call.flexible}</button>
      <p class="sf__formerror" data-call-error hidden role="alert"></p>
    </div>
  </div>

  {/* ---- done ---- */}
  <div class="sf__success sf__done" data-done hidden tabindex="-1">
    <span class="sf__success-rule" aria-hidden="true"></span>
    <h3>{doneHeading}</h3>
    <p data-done-text></p>
    <a class="sf__wa" href={whatsappLink(whatsapp)} target="_blank" rel="noopener">
      Or message Harrison on WhatsApp <span aria-hidden="true">→</span>
    </a>
  </div>
</div>

<style>
  /* ---- the glass — the same pane the big form sits in ------------------- */
  .sf {
    --glass-bg: linear-gradient(160deg, oklch(100% 0 0 / 0.11), oklch(100% 0 0 / 0.035) 46%, oklch(100% 0 0 / 0.07));
    --glass-line: oklch(100% 0 0 / 0.14);
    --glass-tile: oklch(100% 0 0 / 0.06);
    --glass-tile-hover: oklch(100% 0 0 / 0.1);
    --gold-wash: oklch(84% 0.11 78 / 0.12);
    --gold-ring: 0 0 0 3px oklch(75% 0.12 75 / 0.28);
    position: relative;
    isolation: isolate;
    color: var(--text-on-ink);
    border-radius: 24px;
    padding: clamp(1.4rem, 4vw, 2.4rem);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(28px) saturate(1.25);
    backdrop-filter: blur(28px) saturate(1.25);
    border: 1px solid var(--glass-line);
    box-shadow:
      inset 0 1px 0 oklch(100% 0 0 / 0.18),
      inset 0 -1px 0 oklch(0% 0 0 / 0.25),
      0 30px 80px -30px oklch(0% 0 0 / 0.75);
    overflow: hidden;
  }
  .sf::before {
    content: '';
    position: absolute;
    inset: -30% -20% auto -20%;
    height: 70%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse at 22% 18%, oklch(84% 0.11 78 / 0.22), transparent 58%);
    filter: blur(20px);
  }

  /* ---- the rooms: glass tiles that answer on tap ------------------------- */
  .sf__sessions { border: 0; margin: 0 0 1.1rem; padding: 0; min-width: 0; }
  .sf__sessions legend { padding: 0; margin-bottom: 0.5rem; }
  .sf__tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 10.5rem), 1fr)); gap: 0.6rem; }
  .sf__tile {
    position: relative;
    display: grid;
    gap: 0.15rem;
    text-align: left;
    padding: 0.85rem 2.8rem 0.85rem 1rem;
    border-radius: 14px;
    border: 1px solid var(--glass-line);
    background: var(--glass-tile);
    color: var(--text-on-ink);
    cursor: pointer;
    font: inherit;
    box-shadow: inset 0 1px 0 oklch(100% 0 0 / 0.08);
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out-expo), box-shadow var(--dur-fast) ease;
    -webkit-tap-highlight-color: transparent;
  }
  .sf__tile:hover { background: var(--glass-tile-hover); border-color: oklch(84% 0.11 78 / 0.5); transform: translateY(-1px); }
  .sf__tile:focus-visible { outline: none; border-color: var(--gold); box-shadow: var(--gold-ring), inset 0 1px 0 oklch(100% 0 0 / 0.08); }
  .sf__tile-label { font-family: var(--font-display); font-size: 1.12rem; line-height: 1.2; }
  .sf__tile-hint { font-size: 0.78rem; color: var(--text-on-ink-muted); line-height: 1.4; }
  .sf__tile-mark {
    position: absolute;
    right: 0.9rem;
    top: 50%;
    width: 20px;
    height: 20px;
    margin-top: -10px;
    border-radius: 50%;
    border: 1px solid oklch(100% 0 0 / 0.22);
    transition: border-color var(--dur-fast) ease, background var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out-expo);
  }
  .sf__tile[aria-checked='true'] { border-color: var(--gold); background: var(--gold-wash); }
  .sf__tile[aria-checked='true'] .sf__tile-mark { border-color: var(--gold); background: var(--gold); transform: scale(0.72); }

  /* ---- fields ---- */
  .sf__fields { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  .sf__field { display: grid; gap: 0.35rem; min-width: 0; align-content: start; }
  .sf__field--wide { grid-column: 1 / -1; }
  .sf__label {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-on-ink-muted);
  }
  .sf__input {
    width: 100%;
    font: inherit;
    font-size: 1.02rem;
    color: var(--text-on-ink);
    padding: 0.85rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--glass-line);
    background: var(--glass-tile);
    box-shadow: inset 0 1px 0 oklch(100% 0 0 / 0.08);
    transition: border-color var(--dur-fast) ease, box-shadow var(--dur-fast) ease, background var(--dur-fast) ease;
  }
  .sf__input::placeholder { color: var(--text-on-ink-faint); }
  .sf__input:focus { outline: none; border-color: var(--gold); box-shadow: var(--gold-ring), inset 0 1px 0 oklch(100% 0 0 / 0.08); }
  .sf__field--ask { margin-top: 0.9rem; }
  .sf__optional { font-weight: 500; letter-spacing: 0.04em; text-transform: none; color: var(--text-on-ink-faint); margin-left: 0.4em; }
  .sf__textarea { resize: vertical; min-height: 4.6rem; line-height: 1.5; font-size: 0.98rem; }
  .sf__error { margin: 0.4rem 0 0; font-size: 0.8rem; color: oklch(80% 0.12 40); }
  .sf__error[hidden] { display: none; }

  .sf__consent {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    margin-top: 1.1rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-on-ink-muted);
  }
  .sf__consent input { margin-top: 0.25rem; accent-color: var(--gold); flex: none; }
  .sf__consent a { color: var(--text-on-ink); text-decoration-color: oklch(75% 0.12 75 / 0.6); text-underline-offset: 0.2em; }

  .sf__pot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  /* ---- the ask ---- */
  .sf__submit {
    margin-top: 1.2rem;
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1rem 1.4rem;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-size: 1.05rem;
    font-weight: 700;
    color: #14100d;
    background: linear-gradient(to right, #f2c275 0%, #daa24f 100%);
    cursor: pointer;
    box-shadow: 0 10px 30px -10px oklch(75% 0.12 75 / 0.7);
    transition: transform var(--dur-fast) var(--ease-out-expo), box-shadow var(--dur-fast) ease, filter var(--dur-fast) ease, opacity var(--dur-fast) ease;
  }
  .sf__submit:hover { transform: translateY(-1px); filter: brightness(1.04); box-shadow: 0 14px 34px -10px oklch(75% 0.12 75 / 0.85); }
  .sf__submit:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  .sf__submit[disabled] { opacity: 0.45; cursor: not-allowed; transform: none; filter: none; box-shadow: none; }
  .sf__submit span:last-child { transition: transform var(--dur-fast) var(--ease-out-expo); }
  .sf__submit:hover span:last-child { transform: translateX(3px); }
  .sf__help { margin: 0.8rem 0 0; font-size: 0.8rem; text-align: center; color: var(--text-on-ink-faint); }
  .sf__formerror { margin: 0.9rem 0 0; font-size: 0.88rem; color: oklch(80% 0.12 40); }
  .sf__formerror[hidden] { display: none; }
  .sf__formerror a { color: var(--text-on-ink); }

  /* ---- the answer ---- */
  .sf__success { text-align: center; padding: clamp(0.6rem, 2vw, 1.4rem) 0; outline: none; }
  .sf__success[hidden] { display: none; }
  .sf__success-rule { display: block; width: 56px; height: 2px; margin: 0 auto 1.2rem; background: linear-gradient(to right, #f2c275, #daa24f); }
  .sf__success h3 { font-family: var(--font-display); font-size: var(--step-3); font-weight: 300; margin: 0 0 0.7rem; color: var(--text-on-ink); }
  .sf__success > p { color: var(--text-on-ink-muted); max-width: 42ch; margin: 0 auto; line-height: 1.7; }
  .sf__wa {
    display: inline-flex;
    gap: 0.5em;
    align-items: center;
    margin-top: 1.3rem;
    color: var(--gold);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid oklch(75% 0.12 75 / 0.45);
    padding-bottom: 2px;
  }
  .sf__wa:hover { color: var(--text-on-ink); border-color: var(--text-on-ink); }

  /* ---- the call: a strip of days, that day's hours, the picks ------------
     The day strip is a radio (one day open at a time); the hours are toggles
     (many picks, capped); the picks are a row of removable chips so what has
     been chosen is never out of sight while another day is open. The tiles,
     chips and picks themselves are drawn by the script, so Astro's scoping
     attribute never reaches them: their rules live in the global block below. */
  .sf__call { margin-top: 1.6rem; text-align: left; }
  .sf__call.is-sending { opacity: 0.6; pointer-events: none; }
  .sf__call-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .sf__call-label { margin: 0; }
  .sf__count { margin: 0; font-size: 0.78rem; font-variant-numeric: tabular-nums; color: var(--text-on-ink-faint); transition: color var(--dur-fast) ease; }
  .sf__count.is-full { color: var(--gold-light); }
  .sf__count.is-nudge { animation: sf-nudge 420ms var(--ease-out-expo); }
  .sf__call-hint { margin: 0.3rem 0 0.85rem; font-size: 0.76rem; color: var(--text-on-ink-faint); }
  .sf__days { display: grid; grid-template-columns: repeat(7, minmax(2.55rem, 1fr)); gap: 0.4rem; }
  .sf__hours-day { margin: 1.1rem 0 0.55rem; font-family: var(--font-display); font-size: 1.18rem; line-height: 1.2; color: var(--text-on-ink); }
  .sf__hours-day:empty { display: none; }
  .sf__hours { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .sf__hours.is-in { animation: sf-in var(--dur-fast) var(--ease-out-expo) both; }
  .sf__picks { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1rem; }
  .sf__picks[hidden] { display: none; }
  .sf__confirm { margin-top: 1.15rem; }
  .sf__flex {
    display: block;
    margin: 0.85rem auto 0;
    padding: 0.25rem 0.4rem;
    background: none;
    border: 0;
    font: inherit;
    font-size: 0.86rem;
    color: var(--text-on-ink-muted);
    text-decoration: underline;
    text-decoration-color: oklch(100% 0 0 / 0.25);
    text-underline-offset: 0.22em;
    cursor: pointer;
    transition: color var(--dur-fast) ease;
  }
  .sf__flex:hover { color: var(--text-on-ink); text-decoration-color: var(--gold); }
  .sf__flex:focus-visible { outline: none; color: var(--text-on-ink); text-decoration-color: var(--gold); }

  @media (max-width: 480px) {
    .sf__fields { grid-template-columns: 1fr; }
    .sf__days { gap: 0.3rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sf__hours.is-in, .sf__count.is-nudge { animation: none; }
  }
</style>

<style is:global>
  /* The picker's tiles, chips and picks — built by the script, hence global;
     everything is under .sf and prefixed sf__ so nothing leaks. */
  .sf .sf__day {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.05rem;
    padding: 0.6rem 0.15rem 0.85rem;
    border-radius: 14px;
    border: 1px solid var(--glass-line);
    background: var(--glass-tile);
    color: var(--text-on-ink);
    cursor: pointer;
    font: inherit;
    box-shadow: inset 0 1px 0 oklch(100% 0 0 / 0.08);
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out-expo), box-shadow var(--dur-fast) ease;
    -webkit-tap-highlight-color: transparent;
  }
  .sf .sf__day:hover { background: var(--glass-tile-hover); border-color: oklch(84% 0.11 78 / 0.5); transform: translateY(-1px); }
  .sf .sf__day:focus-visible { outline: none; border-color: var(--gold); box-shadow: var(--gold-ring), inset 0 1px 0 oklch(100% 0 0 / 0.08); }
  .sf .sf__day[aria-checked='true'] { border-color: var(--gold); background: var(--gold-wash); }
  .sf .sf__day-wd { font-size: 0.6rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-on-ink-muted); transition: color var(--dur-fast) ease; }
  .sf .sf__day[aria-checked='true'] .sf__day-wd { color: var(--gold-light); }
  .sf .sf__day-n { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.05; }
  .sf .sf__day-mo { font-size: 0.66rem; color: var(--text-on-ink-faint); }
  .sf .sf__day-dot {
    position: absolute;
    bottom: 0.36rem;
    left: 50%;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 50%;
    background: var(--gold);
    opacity: 0;
    transform: scale(0.4);
    transition: opacity var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out-expo);
  }
  .sf .sf__day.has-picks .sf__day-dot { opacity: 1; transform: none; }

  .sf .sf__hour {
    padding: 0.62rem 1.05rem;
    border-radius: 999px;
    border: 1px solid var(--glass-line);
    background: var(--glass-tile);
    color: var(--text-on-ink);
    font: inherit;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    box-shadow: inset 0 1px 0 oklch(100% 0 0 / 0.08);
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease, color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out-expo), box-shadow var(--dur-fast) ease, opacity var(--dur-fast) ease;
    -webkit-tap-highlight-color: transparent;
  }
  .sf .sf__hour:hover { background: var(--glass-tile-hover); border-color: oklch(84% 0.11 78 / 0.5); transform: translateY(-1px); }
  .sf .sf__hour:focus-visible { outline: none; border-color: var(--gold); box-shadow: var(--gold-ring), inset 0 1px 0 oklch(100% 0 0 / 0.08); }
  .sf .sf__hour[aria-pressed='true'] {
    border-color: transparent;
    background: linear-gradient(to right, #f2c275, #daa24f);
    color: #14100d;
    font-weight: 700;
    box-shadow: 0 8px 22px -10px oklch(75% 0.12 75 / 0.75);
  }
  .sf .sf__hour[aria-disabled='true'] { opacity: 0.35; cursor: not-allowed; }
  .sf .sf__hour[aria-disabled='true']:hover { transform: none; background: var(--glass-tile); border-color: var(--glass-line); }

  .sf .sf__pick {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.28rem 0.3rem 0.28rem 0.8rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-on-ink);
    background: var(--gold-wash);
    border: 1px solid oklch(84% 0.11 78 / 0.35);
    animation: sf-in var(--dur-fast) var(--ease-out-expo) both;
  }
  .sf .sf__pick-x {
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 50%;
    border: 0;
    background: oklch(100% 0 0 / 0.1);
    color: inherit;
    font: inherit;
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
    transition: background var(--dur-fast) ease;
  }
  .sf .sf__pick-x:hover { background: oklch(100% 0 0 / 0.24); }
  .sf .sf__pick-x:focus-visible { outline: none; box-shadow: var(--gold-ring); }

  @keyframes sf-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes sf-nudge { 0% { transform: translateX(0); } 30% { transform: translateX(-3px); } 60% { transform: translateX(3px); } 100% { transform: translateX(0); } }

  @media (max-width: 480px) {
    .sf .sf__day { padding: 0.5rem 0.1rem 0.8rem; border-radius: 12px; }
    .sf .sf__day-n { font-size: 1.3rem; }
    .sf .sf__hour { padding: 0.58rem 0.9rem; font-size: 0.92rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sf .sf__pick { animation: none; }
  }
</style>

<script>
  import { track, eventId } from '../scripts/tracking';

  const ENDPOINT = import.meta.env.PUBLIC_FORM_ENDPOINT || '/api/lead';

  type CallCfg = {
    tz: string; days: number; from: number; block?: number; weekday: number[]; weekend: number[]; max: number;
    hint: string; countLabel: string; confirm: string; flexible: string; flexibleLabel: string;
  };
  type Day = { iso: string; wd: number; n: number; mo: number; hours: number[] };
  type Pick = { iso: string; h: number };

  const WD = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
  const WD_LONG = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
  const MO = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const MO_LONG = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
  const pad = (n: number) => String(n).padStart(2, '0');
  const h12 = (h: number) => ((h + 11) % 12) + 1;
  const mer = (h: number) => (h % 24 >= 12 ? 'pm' : 'am');
  /** n hours from h: 16,2 → "4–6 pm"; 10,2 → "10 am–12 pm"; 12,2 → "12–2 pm" */
  const blockLabel = (h: number, n: number) =>
    mer(h) === mer(h + n) ? `${h12(h)}–${h12(h + n)} ${mer(h)}` : `${h12(h)} ${mer(h)}–${h12(h + n)} ${mer(h + n)}`;

  /** The wall clock in Harrison's zone — the only place Intl is needed. From
      there the days are plain calendar arithmetic on UTC-noon dates, which is
      immune to the DST change Sydney makes in October. */
  function nowIn(tz: string) {
    const parts = new Intl.DateTimeFormat('en-AU', { timeZone: tz, hourCycle: 'h23', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit' }).formatToParts(new Date());
    const get = (t: string) => Number(parts.find((p) => p.type === t)?.value ?? 0);
    return { y: get('year'), m: get('month'), d: get('day'), h: get('hour') % 24 };
  }

  function buildDays(cfg: CallCfg): Day[] {
    const now = nowIn(cfg.tz);
    const days: Day[] = [];
    for (let i = cfg.from; days.length < cfg.days && i < cfg.from + cfg.days + 7; i++) {
      const dt = new Date(Date.UTC(now.y, now.m - 1, now.d + i, 12));
      const wd = dt.getUTCDay();
      const hours = (wd === 0 || wd === 6 ? cfg.weekend : cfg.weekday).filter((h) => i > 0 || h >= now.h + 2);
      if (!hours.length) continue;
      days.push({ iso: `${dt.getUTCFullYear()}-${pad(dt.getUTCMonth() + 1)}-${pad(dt.getUTCDate())}`, wd, n: dt.getUTCDate(), mo: dt.getUTCMonth(), hours });
    }
    return days;
  }

  document.querySelectorAll<HTMLElement>('[data-seat-form]').forEach((root) => {
    const form = root.querySelector('form')!;
    const formId = root.dataset.seatForm!;
    const eventName = root.dataset.event || 'lead';
    const success = root.querySelector<HTMLElement>('[data-success]')!;
    const done = root.querySelector<HTMLElement>('[data-done]')!;
    const doneText = root.querySelector<HTMLElement>('[data-done-text]')!;
    const formError = root.querySelector<HTMLElement>('[data-form-error]')!;
    const callError = root.querySelector<HTMLElement>('[data-call-error]')!;
    const submitBtn = root.querySelector<HTMLButtonElement>('[data-submit]')!;
    const consent = form.querySelector<HTMLInputElement>('[name="consent"]')!;
    const wa = root.querySelector<HTMLAnchorElement>('.sf__wa')!;
    const hidden = (name: string) => form.querySelector<HTMLInputElement>(`input[type="hidden"][name="${name}"]`)!;

    form.addEventListener(
      'input',
      () => track('form_start', { form_id: formId, page_path: location.pathname }),
      { once: true }
    );

    /* ---- the room: a tap answers ---- */
    root.querySelectorAll<HTMLButtonElement>('[data-session]').forEach((btn) => {
      btn.addEventListener('click', () => {
        root.querySelectorAll<HTMLElement>('[data-session]').forEach((b) => b.setAttribute('aria-checked', String(b === btn)));
        hidden('session').value = btn.dataset.session || '';
        hidden('session_label').value = btn.dataset.label || '';
        const slot = root.querySelector<HTMLElement>('[data-error-for="session"]');
        if (slot) slot.hidden = true;
        track('form_step', { form_id: formId, step: 1, question: 'session', answer: btn.dataset.session, page_path: location.pathname });
      });
    });

    const showError = (name: string, message: string) => {
      const slot = root.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (!slot) return;
      slot.textContent = message;
      slot.hidden = false;
    };
    const validate = (): boolean => {
      root.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => { el.hidden = true; el.textContent = ''; });
      let ok = true;
      let first: HTMLElement | null = null;
      if (!hidden('session').value) {
        showError('session', 'Pick a session.');
        ok = false;
        first = root.querySelector<HTMLElement>('[data-session]');
      }
      form.querySelectorAll<HTMLInputElement>('.sf__input[required]').forEach((el) => {
        let msg = '';
        if (!el.value.trim()) msg = 'This one is needed.';
        else if (el.type === 'email' && !/^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(el.value)) msg = 'That email address does not look right.';
        else if (el.type === 'tel' && el.value.replace(/\D/g, '').length < 8) msg = 'Please include a full phone number.';
        if (msg) { showError(el.name, msg); ok = false; first ??= el; }
      });
      /* email is optional (Dion, 27 Sep 2026) — but if it is there, it has to be one */
      const email = form.querySelector<HTMLInputElement>('.sf__input[type="email"]');
      if (email && email.value.trim() && !/^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(email.value)) {
        showError(email.name, 'That email address does not look right.');
        ok = false;
        first ??= email;
      }
      first?.focus();
      return ok;
    };

    /* what every post carries: who they are, and where this came from */
    const identity = (): Record<string, unknown> => {
      const data = new FormData(form);
      const p: Record<string, unknown> = {};
      data.forEach((value, key) => { if (key !== 'website') p[key] = value; });
      /* the session goes into GHL's existing "topic" field as well, so it is
         readable there whether or not a session field has been created */
      p.topic = p.session;
      p.topic_label = p.session_label;
      p.form_id = formId;
      p.page_path = location.pathname;
      p.page_url = location.href;
      p.referrer = document.referrer || undefined;
      try {
        p.fy = sessionStorage.getItem('rts-fy') || undefined;
        p.fy_pick = sessionStorage.getItem('rts-fy-pick') || undefined;
      } catch {}
      p.fbc = document.cookie.match(/_fbc=([^;]+)/)?.[1];
      p.fbp = document.cookie.match(/_fbp=([^;]+)/)?.[1];
      return p;
    };

    const post = async (payload: Record<string, unknown>) => {
      const res = await fetch(ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || json.ok === false) throw new Error(json.error || `HTTP ${res.status}`);
      return json;
    };

    const failed = (slot: HTMLElement, suffix: string, err: unknown) => {
      slot.innerHTML = `That did not send. Try again, or <a href="${wa.href}" target="_blank" rel="noopener">message Harrison on WhatsApp</a>${suffix}.`;
      slot.hidden = false;
      track('form_error', { form_id: formId, page_path: location.pathname, message: String((err as Error).message).slice(0, 80) });
    };

    /* ---- 2. the windows for the call: day → hour blocks → up to three ---- */
    const callRoot = root.querySelector<HTMLElement>('[data-call-root]')!;
    const cfg = JSON.parse(callRoot.dataset.callConfig || '{}') as CallCfg;
    const daysEl = callRoot.querySelector<HTMLElement>('[data-days]')!;
    const hoursDayEl = callRoot.querySelector<HTMLElement>('[data-hours-day]')!;
    const hoursEl = callRoot.querySelector<HTMLElement>('[data-hours]')!;
    const picksEl = callRoot.querySelector<HTMLElement>('[data-picks]')!;
    const countEl = callRoot.querySelector<HTMLElement>('[data-count]')!;
    const confirmBtn = callRoot.querySelector<HTMLButtonElement>('[data-confirm]')!;
    const flexBtn = callRoot.querySelector<HTMLButtonElement>('[data-flexible]')!;

    let days: Day[] = [];
    let activeDay = '';
    const picks: Pick[] = [];
    const dayOf = (iso: string) => days.find((d) => d.iso === iso);
    const sorted = () => picks.slice().sort((a, b) => (a.iso === b.iso ? a.h - b.h : a.iso < b.iso ? -1 : 1));
    const short = (d: Day) => `${WD[d.wd]} ${d.n} ${MO[d.mo]}`;

    /** "2026-09-28 17:00-18:00; 2026-09-30 16:00-17:00" — for a workflow */
    const N = cfg.block || 1;
    const label = (h: number) => blockLabel(h, N);
    const machine = () => sorted().map((p) => `${p.iso} ${pad(p.h)}:00-${pad(p.h + N)}:00`).join('; ');
    /** "Mon 28 Sep, 5–6 pm or 6–7 pm; or Wed 30 Sep, 4–5 pm (Sydney)" — for Harrison */
    const sentence = () => {
      const byDay: string[] = [];
      for (const d of days) {
        const hs = sorted().filter((p) => p.iso === d.iso).map((p) => label(p.h));
        if (hs.length) byDay.push(`${short(d)}, ${hs.join(' or ')}`);
      }
      return `${byDay.join('; or ')} (Sydney)`;
    };

    const renderDays = () => {
      daysEl.querySelectorAll<HTMLButtonElement>('[data-day]').forEach((b) => {
        b.setAttribute('aria-checked', String(b.dataset.day === activeDay));
        b.tabIndex = b.dataset.day === activeDay ? 0 : -1;
        b.classList.toggle('has-picks', picks.some((p) => p.iso === b.dataset.day));
      });
    };
    const renderHours = (animate = false) => {
      const d = dayOf(activeDay);
      if (!d) return;
      hoursDayEl.textContent = `${WD_LONG[d.wd]} ${d.n} ${MO_LONG[d.mo]}`;
      hoursEl.innerHTML = '';
      const full = picks.length >= cfg.max;
      for (const h of d.hours) {
        const on = picks.some((p) => p.iso === d.iso && p.h === h);
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'sf__hour';
        b.dataset.hour = String(h);
        b.setAttribute('aria-pressed', String(on));
        if (!on && full) b.setAttribute('aria-disabled', 'true');
        b.textContent = label(h);
        b.addEventListener('click', () => toggle(d.iso, h));
        hoursEl.appendChild(b);
      }
      if (animate) { hoursEl.classList.remove('is-in'); void hoursEl.offsetWidth; hoursEl.classList.add('is-in'); }
    };
    const renderPicks = () => {
      countEl.textContent = cfg.countLabel.replace('{n}', String(picks.length)).replace('{max}', String(cfg.max));
      countEl.classList.toggle('is-full', picks.length >= cfg.max);
      picksEl.innerHTML = '';
      picksEl.hidden = picks.length === 0;
      for (const p of sorted()) {
        const d = dayOf(p.iso);
        if (!d) continue;
        const chip = document.createElement('span');
        chip.className = 'sf__pick';
        const text = document.createElement('span');
        text.textContent = `${short(d)} · ${label(p.h)}`;
        const x = document.createElement('button');
        x.type = 'button';
        x.className = 'sf__pick-x';
        x.setAttribute('aria-label', `Remove ${short(d)} ${label(p.h)}`);
        x.textContent = '×';
        x.addEventListener('click', () => toggle(p.iso, p.h));
        chip.append(text, x);
        picksEl.appendChild(chip);
      }
      confirmBtn.disabled = picks.length === 0;
    };
    const sync = () => { renderDays(); renderHours(); renderPicks(); };
    const toggle = (iso: string, h: number) => {
      const i = picks.findIndex((p) => p.iso === iso && p.h === h);
      if (i >= 0) picks.splice(i, 1);
      else if (picks.length >= cfg.max) {
        countEl.classList.remove('is-nudge'); void countEl.offsetWidth; countEl.classList.add('is-nudge');
        return;
      } else picks.push({ iso, h });
      sync();
      track('form_step', { form_id: formId, step: 2, question: 'window', answer: `${iso} ${pad(h)}:00`, picks: picks.length, page_path: location.pathname });
    };

    /** Drawn when the thank-you appears, so "now" is now. */
    const openPicker = () => {
      days = buildDays(cfg);
      activeDay = days[0]?.iso ?? '';
      daysEl.innerHTML = '';
      for (const d of days) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'sf__day';
        b.setAttribute('role', 'radio');
        b.dataset.day = d.iso;
        b.setAttribute('aria-label', `${WD_LONG[d.wd]} ${d.n} ${MO_LONG[d.mo]}`);
        b.innerHTML = `<span class="sf__day-wd">${WD[d.wd]}</span><span class="sf__day-n">${d.n}</span><span class="sf__day-mo">${MO[d.mo]}</span><span class="sf__day-dot" aria-hidden="true"></span>`;
        b.addEventListener('click', () => {
          if (activeDay === d.iso) return;
          activeDay = d.iso;
          renderDays();
          renderHours(true);
        });
        daysEl.appendChild(b);
      }
      sync();
    };
    /* arrow keys walk the day strip, as a radio group should */
    daysEl.addEventListener('keydown', (e) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key)) return;
      const i = days.findIndex((d) => d.iso === activeDay);
      const j = e.key === 'Home' ? 0 : e.key === 'End' ? days.length - 1 : (i + (e.key === 'ArrowRight' ? 1 : -1) + days.length) % days.length;
      e.preventDefault();
      activeDay = days[j].iso;
      renderDays();
      renderHours(true);
      daysEl.querySelector<HTMLButtonElement>(`[data-day="${activeDay}"]`)?.focus();
    });

    /* ---- 1. the application ---- */
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      formError.hidden = true;
      if (!validate()) return;
      if (!consent.checked) {
        formError.textContent = 'Please tick the consent box so Harrison can reply.';
        formError.hidden = false;
        return;
      }
      if ((new FormData(form).get('website') as string)?.trim()) { form.hidden = true; success.hidden = false; return; }

      const id = eventId();
      const payload = { ...identity(), event_id: id, event_name: eventName };
      submitBtn.disabled = true;
      try {
        await post(payload);
        track(eventName, { event_id: id, form_id: formId, page_path: location.pathname });
        openPicker();
        form.hidden = true;
        success.hidden = false;
        success.focus({ preventScroll: true });
      } catch (err) {
        failed(formError, '', err);
        submitBtn.disabled = false;
      }
    });

    /* ---- 2. the windows, sent ---- */
    const send = async (timing: string, label: string, said: string) => {
      callError.hidden = true;
      callRoot.classList.add('is-sending');
      confirmBtn.disabled = true;
      flexBtn.disabled = true;
      const id = eventId();
      try {
        await post({ ...identity(), timing, timing_label: label, event_id: id, event_name: 'schedule' });
        track('schedule', { event_id: id, form_id: formId, window: timing === 'flexible' ? 'flexible' : `${picks.length} blocks`, page_path: location.pathname });
        doneText.textContent = (root.dataset.doneBody || '').replace('{window}', said);
        success.hidden = true;
        done.hidden = false;
        done.focus({ preventScroll: true });
      } catch (err) {
        callRoot.classList.remove('is-sending');
        confirmBtn.disabled = picks.length === 0;
        flexBtn.disabled = false;
        failed(callError, ' with the windows', err);
      }
    };
    confirmBtn.addEventListener('click', () => { if (picks.length) send(machine(), sentence(), sentence()); });
    flexBtn.addEventListener('click', () => send('flexible', `Flexible — ${cfg.flexibleLabel}`, cfg.flexibleLabel));
  });
</script>
