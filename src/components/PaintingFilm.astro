---
/**
 * The "Harrison Painting" film behind The Program (Dion, 29 Sep; 2 Oct: "what
 * happened to the mp4 in the bg — I want it at 70%"; 2 Oct later: "has to be 20%" — too bright for the text). Drop it as the first
 * child of a section; ink.css isolates any section that holds one. Plays when
 * the section is near, loops (the file dissolves back to blank paper).
 */
import '../styles/ink.css';
interface Props { opacity?: number; pos?: string }
const { opacity = 0.2, pos = '50% 40%' } = Astro.props;
---

<div class="film-bg" aria-hidden="true" data-film-bg style={`--film-o:${opacity};--film-pos:${pos}`}>
  <video
    muted
    playsinline
    loop
    preload="none"
    poster="/img/painting-poster-v1-1600.webp"
    data-src="/video/harrison-painting-v1.mp4"
    data-src-sm="/video/harrison-painting-v1-sm.mp4"
  ></video>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-film-bg]:not([data-wired])').forEach((box) => {
    box.dataset.wired = '1';
    const video = box.querySelector('video');
    if (!video) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    let armed = false;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          if (!armed) {
            armed = true;
            video.src = (window.matchMedia('(max-width: 700px)').matches && video.dataset.srcSm) || video.dataset.src || '';
            video.muted = true;
            video.load();
          }
          video.play().catch(() => {});
        } else if (!video.paused) video.pause();
      });
    }, { rootMargin: '25% 0px', threshold: 0.01 });
    io.observe(box.closest('section') || box);
  });
</script>
