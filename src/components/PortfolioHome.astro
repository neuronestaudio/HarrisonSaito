---
/**
 * The page under the walk, since 29 Sep 2026: the portfolio.
 *
 * Dion, 28 Sep: the home page is his portfolio again — what he does, then
 * the choice to go on to Return to Self or out to his channels — and the
 * twelve-week sales page that used to sit here is /return-to-self, whole
 * (MorelHome). What stays from that build is what a portfolio needs: the
 * films ("See the work"), the wall of what people took with them, and the
 * close. Same design system (MoShell), so the reveals, the tokens and the
 * video lightbox are the ones the rest of the site uses.
 */
import MoShell from './MoShell.astro';
import Portfolio from './Portfolio.astro';
import Wall from './Wall.astro';
import { FILMS, FILMS_SECTION, CORE, PHASES, CLOSE, asset } from '../data/morel';
import { PLAY_ICON } from '../lib/morel-icons';

const book = (href: string) => href === '/book';
---

<MoShell>
  <Portfolio />

  <!-- ============ FILMS (as on /return-to-self) ============ -->
  <section class="section section--white films" id="films" data-section="films">
    <div class="wide">
      <div class="sec-head">
        <div>
          <p class="eyebrow">{FILMS_SECTION.label}</p>
          <h2 class="reveal" set:html={FILMS_SECTION.title} />
        </div>
        <a class="btn btn--outline" href={FILMS_SECTION.cta.href}>{FILMS_SECTION.cta.label}</a>
      </div>

      {FILMS.filter((f) => f.featured).map((f) => (
        <a class={`film film--feature js-video reveal${'imageMobile' in f ? ' film--has-mobile' : ''}${'tall' in f && f.tall ? ' film--tall' : ''}`} href={`https://www.youtube.com/watch?v=${f.id}`} data-video={f.id} style={`background-image:url(${f.image})${'imageMobile' in f ? `;--film-mobile:url(${f.imageMobile})` : ''}`}>
          <div class="film__inner">
            <div>
              <span class="pill">{f.label}</span>
              <h3>{f.title}</h3>
              {f.description && <p class="fs-xs">{f.description}</p>}
            </div>
            <Fragment set:html={PLAY_ICON} />
          </div>
        </a>
      ))}

      <div class="films__pair" data-stagger>
        {FILMS.filter((f) => !f.featured).map((f) => (
          <a class="film js-video reveal" href={`https://www.youtube.com/watch?v=${f.id}`} data-video={f.id} style={`background-image:url(${f.image})`}>
            <div class="film__inner">
              <div>
                <span class="pill">{f.label}</span>
                <h3>{f.title}</h3>
              </div>
              <Fragment set:html={PLAY_ICON} />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ THE WALL: what they took with them ============ -->
  <Wall />

  <!-- ============ RETURN TO SELF: the three phases, under the testimonies ============
       Dion, 29 Sep: "below the testimonies should be Return to Self — those 3
       components". The Core as it is on /return-to-self (words: data/morel.ts
       CORE + PHASES), without that page's plate experiment. -->
  <section class="section section--bg4 section--film core" id="the-core" data-section="core" style="--film-o:0.5;--film-pos:50% 40%">
    {/* Dion, 29 Sep: the "Harrison Painting" film behind The Program at 50% —
        an ink landscape drawing itself in; plays once when the section is in
        view and holds on the finished painting (styles/ink.css, script below). */}
    <div class="film-bg" aria-hidden="true" data-film-bg>
      <video
        muted
        playsinline
        preload="none"
        poster="/img/painting-poster-v1-1600.webp"
        data-src="/video/harrison-painting-v1.mp4"
        data-src-sm="/video/harrison-painting-v1-sm.mp4"
      ></video>
    </div>
    <div class="wide">
      <header class="core__head">
        <p class="eyebrow">{CORE.label}</p>
        <h2 class="reveal">{CORE.title}</h2>
        <p class="fs-md core__lede reveal">{CORE.lede}</p>
      </header>

      <div class="core__grid" data-stagger>
        {PHASES.map((ph) => (
          <article class="phase-card reveal">
            <span class="phase-card__kanji" lang="ja" aria-hidden="true">{ph.kanji}</span>
            <p class="phase-card__weeks">{ph.weeks}</p>
            <h3>{ph.name}</h3>
            <p class="fs-xs">{ph.body}</p>
            <p class="phase-card__romaji" aria-hidden="true">{ph.kanji} {ph.romaji}</p>
          </article>
        ))}
      </div>

      <p class="fs-xs core__note reveal">{CORE.note}</p>

      <div class="core__cta reveal">
        {CORE.ctas.map((c) => (
          <a class={`btn btn--${c.style} btn--wide`} href={c.href} data-track={book(c.href) ? 'cta_click' : undefined} data-track-label={book(c.href) ? `Core — ${c.label}` : undefined}>{c.label}</a>
        ))}
      </div>
    </div>
  </section>

  <script>
    /* The film behind The Program: its source is given only as the section
       nears (no 5 MB on a page that is never scrolled that far), it plays
       once — muted set imperatively, which is what iOS needs — and pauses if
       the section leaves before it has finished. Reduced motion keeps the
       poster: the finished painting. */
    document.querySelectorAll<HTMLElement>('[data-film-bg]').forEach((box) => {
      const video = box.querySelector('video');
      if (!video) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
      let armed = false;
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            if (!armed) {
              armed = true;
              const small = window.matchMedia('(max-width: 700px)').matches;
              video.src = (small && video.dataset.srcSm) || video.dataset.src || '';
              video.muted = true;
              video.load();
            }
            if (!video.ended) video.play().catch(() => {});
          } else if (!video.paused) {
            video.pause();
          }
        });
      }, { rootMargin: '25% 0px', threshold: 0.01 });
      io.observe(box.closest('section') || box);
    });
  </script>

  <!-- ============ CLOSE ============ -->
  <section class="section section--dark on-dark close" data-section="close">
    <div class="close__enso" aria-hidden="true"><img src={asset('/img/logo-light-512.png')} alt="" width="320" height="320" loading="lazy" /></div>
    <div class="content text-center">
      <h2 class="reveal" set:html={CLOSE.title} />
      <p class="fs-md close__sub reveal">{CLOSE.body}</p>
      <div class="close__ctas reveal">
        {CLOSE.ctas.map((c) => (
          <a class={`btn btn--${c.style} btn--wide`} href={c.href} data-track="cta_click" data-track-label={`Close — ${c.label}`}>{c.label}</a>
        ))}
      </div>
    </div>
  </section>
</MoShell>
