---
/**
 * The recto — the photographic page of a spread, and the front face of a
 * turning leaf.
 */
import type { Chapter } from '../data/site';
import { srcset, src } from '../lib/images';

interface Props {
  chapter: Chapter;
  index: number;
  eager?: boolean;
}

const { chapter: c, index: i, eager = false } = Astro.props;
---

<div class="ip">
  <img
    src={src(c.image)}
    srcset={srcset(c.image) || undefined}
    sizes="(max-width: 900px) 100vw, 42vw"
    alt={c.imageAlt}
    width="900"
    height="1100"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
  <span class="ip__scrim" aria-hidden="true"></span>
  <span class="ip__caption">{c.caption}</span>
  <span class="ip__folio" aria-hidden="true">{String(i * 2 + 2).padStart(2, '0')}</span>
</div>

<style>
  .ip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--ink-900);
  }

  .ip img { width: 100%; height: 100%; object-fit: cover; }

  .ip__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, oklch(11% 0.008 55 / 0.72), transparent 55%),
      /* the fold side is shaded, matching the text page */
      linear-gradient(to right, oklch(11% 0.008 55 / 0.28), transparent 18%);
  }

  .ip__caption {
    position: absolute;
    inset-block-end: clamp(1rem, 2.4vw, 2rem);
    inset-inline-start: clamp(1.25rem, 2.6vw, 2.25rem);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    color: oklch(95% 0.005 60);
    z-index: 2;
    text-shadow: 0 2px 20px oklch(11% 0.008 55 / 0.8);
  }

  .ip__folio {
    position: absolute;
    inset-block-end: clamp(0.75rem, 1.6vw, 1.4rem);
    inset-inline-end: clamp(1.25rem, 2.6vw, 2.25rem);
    font-family: var(--font-display);
    font-size: 0.8rem;
    color: oklch(93% 0.005 60 / 0.55);
    font-variant-numeric: tabular-nums;
    z-index: 2;
  }
</style>
