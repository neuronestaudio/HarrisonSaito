---
/**
 * 円相 — the ensō.
 *
 * In Zen the circle is painted in a single uninterrupted breath and left open;
 * the gap is the point. Here the stroke draws in step with scroll progress, so
 * on the programme page it closes exactly as the reader reaches week twelve.
 *
 * The path is a hand-tuned cubic approximation of a brush circle rather than a
 * true arc — the radius wobbles slightly and the stroke is left open at roughly
 * eleven o'clock, which is what stops it reading as a plain SVG ring.
 */
interface Props {
  size?: string;
  class?: string;
  /** Scroll-drawn (default) or already complete. */
  animate?: boolean;
  stroke?: string;
  opacity?: number;
  strokeWidth?: number;
}

const {
  size = '100%',
  class: className = '',
  animate = true,
  stroke = 'var(--gold)',
  opacity = 1,
  strokeWidth = 7,
} = Astro.props;

// Open circle: starts just past 12 o'clock, sweeps clockwise all the way round,
// stopping short so the ends never quite meet.
const d = `
  M 168 34
  C 244 34 302 92 302 166
  C 302 244 242 300 166 300
  C 88 300 30 242 30 164
  C 30 92 84 38 152 34
`;
---

<svg
  class={`enso ${className}`}
  viewBox="0 0 332 332"
  width={size}
  height={size}
  fill="none"
  aria-hidden="true"
  style={`opacity:${opacity}`}
>
  <defs>
    <linearGradient id="enso-ink" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color={stroke} stop-opacity="0.55"></stop>
      <stop offset="45%" stop-color={stroke} stop-opacity="1"></stop>
      <stop offset="100%" stop-color={stroke} stop-opacity="0.35"></stop>
    </linearGradient>
    <filter id="enso-brush" x="-12%" y="-12%" width="124%" height="124%">
      {/* Roughens the edge so it reads as a loaded brush, not a vector ring. */}
      <feTurbulence type="fractalNoise" baseFrequency="0.028" numOctaves="3" seed="7" result="n" />
      <feDisplacementMap in="SourceGraphic" in2="n" scale="4.5" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </defs>

  <path
    d={d}
    stroke="url(#enso-ink)"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    filter="url(#enso-brush)"
    data-enso-path={animate ? '' : undefined}
    style={animate ? undefined : 'stroke-dasharray:none;stroke-dashoffset:0'}
  ></path>
</svg>

<style>
  .enso {
    display: block;
    max-width: 100%;
    overflow: visible;
  }
</style>
