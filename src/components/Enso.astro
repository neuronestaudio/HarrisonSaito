---
/**
 * 円相 — the ensō, as the actual brand mark.
 *
 * This started as a hand-drawn SVG circle, on the reasoning that the ensō was
 * the right motif for the work. Harrison's real logo turned out to *be* an
 * ensō — a brushed circle with an S through it — so the drawn stand-in was
 * retired and the mark itself now does the job.
 *
 * A PNG cannot stroke-draw the way an SVG path can, so the reveal is done with
 * a conic-gradient mask that sweeps clockwise from roughly ten o'clock, where
 * the red accent sits. The effect is the same one the drawn version had, and
 * better: the thing painting itself in is the brand, not a generic circle.
 *
 * Props are unchanged from the SVG version so every call site still works.
 */
import BrandMark from './BrandMark.astro';

interface Props {
  size?: string;
  class?: string;
  /** Scroll-swept (default) or already complete. */
  animate?: boolean;
  opacity?: number;
  variant?: 'light' | 'dark';
  /** Retained for API compatibility with the previous SVG implementation. */
  stroke?: string;
  strokeWidth?: number;
}

const {
  size = '100%',
  class: className = '',
  animate = true,
  opacity = 1,
  variant = 'light',
} = Astro.props;
---

<div
  class={`enso ${className}`}
  style={`width:${size};opacity:${opacity}`}
  data-enso={animate ? '' : undefined}
  aria-hidden="true"
>
  <BrandMark variant={variant} size={512} loading="lazy" sizes="(max-width: 768px) 60vw, 34vw" />
</div>

<style>
  .enso {
    --enso-sweep: 360deg;
    display: block;
    max-width: 100%;
    aspect-ratio: 1;
  }

  /* Unswept until the observer arms it, so a no-JS visitor sees the whole mark. */
  .enso[data-enso] {
    -webkit-mask-image: conic-gradient(
      from -115deg,
      #000 0deg,
      #000 calc(var(--enso-sweep) - 14deg),
      transparent var(--enso-sweep)
    );
    mask-image: conic-gradient(
      from -115deg,
      #000 0deg,
      #000 calc(var(--enso-sweep) - 14deg),
      transparent var(--enso-sweep)
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .enso[data-enso] { -webkit-mask-image: none; mask-image: none; }
  }
</style>
