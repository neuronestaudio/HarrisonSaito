---
/**
 * Site navigation.
 *
 * Audit finding M4: the legacy nav was <button> elements that scrolled to
 * anchors on a single page. Nothing was crawlable and nothing was linkable.
 * These are real anchors to real URLs.
 */
import { NAV, SITE } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a class="nav__brand" href="/" aria-label="Harrison Saito — home">
      <span class="nav__mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" width="30" height="30" fill="none">
          <path
            d="M31 9.5 A 13.5 13.5 0 1 0 33.4 18"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
          ></path>
        </svg>
      </span>
      <span class="nav__name">Harrison Saito</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class:list={['nav__link', { 'is-active': isActive(item.href) }]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__actions">
      <a
        class="btn nav__cta"
        href="/book"
        data-track="cta_click"
        data-track-label="Nav — Book a chat"
        data-track-section="nav"
      >
        Book a Chat
      </a>
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-drawer">
        <span class="visually-hidden">Menu</span>
        <span class="nav__bars" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="nav__drawer" id="nav-drawer" hidden>
    <nav aria-label="Mobile">
      {NAV.map((item) => <a href={item.href} class="nav__drawer-link">{item.label}</a>)}
      <a href="/apply" class="nav__drawer-link">Apply — Return to Self</a>
    </nav>
    <div class="nav__drawer-foot">
      <a class="btn btn--block" href="/book" data-track="cta_click" data-track-label="Drawer — Book a chat">
        Book a Chat
      </a>
      <a class="nav__drawer-contact" href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 100;
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease,
      transform var(--dur) var(--ease-out-expo);
    border-bottom: 1px solid transparent;
  }

  /* Solid once you leave the hero, so links stay legible over cream sections. */
  .nav.is-stuck {
    background: oklch(11% 0.008 55 / 0.92);
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom-color: oklch(75% 0.12 75 / 0.22);
  }

  .nav.is-hidden { transform: translateY(-100%); }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: var(--page-max);
    margin-inline: auto;
    padding: 1.1rem var(--gutter);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text-on-ink);
    flex-shrink: 0;
  }

  .nav__mark { color: var(--gold); display: grid; place-items: center; }

  .nav__name {
    font-family: var(--font-display);
    font-size: 1.28rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: clamp(1rem, 2.2vw, 2.1rem);
  }

  .nav__link {
    position: relative;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: oklch(93% 0.005 60 / 0.72);
    padding-block: 0.4rem;
    white-space: nowrap;
    transition: color var(--dur-fast) ease;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-out-expo);
  }

  .nav__link:hover { color: var(--text-on-ink); }
  .nav__link:hover::after,
  .nav__link.is-active::after { transform: scaleX(1); }
  .nav__link.is-active { color: var(--gold); }

  .nav__actions { display: flex; align-items: center; gap: 0.85rem; }

  .nav__cta {
    display: none;
    padding: 0.72rem 1.5rem;
    font-size: 0.72rem;
  }

  .nav__toggle {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    background: transparent;
    border: 1px solid oklch(75% 0.12 75 / 0.35);
    cursor: pointer;
    color: var(--gold);
  }

  .nav__bars { display: grid; gap: 6px; width: 20px; }
  .nav__bars i {
    display: block;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur-fast) var(--ease-out-expo), opacity var(--dur-fast) ease;
  }
  .nav__toggle[aria-expanded='true'] .nav__bars i:first-child { transform: translateY(3.75px) rotate(45deg); }
  .nav__toggle[aria-expanded='true'] .nav__bars i:last-child { transform: translateY(-3.75px) rotate(-45deg); }

  /* ---- drawer ---- */
  .nav__drawer {
    background: var(--ink-900);
    border-top: 1px solid oklch(75% 0.12 75 / 0.2);
    padding: 1.5rem var(--gutter) 2rem;
    max-height: calc(100dvh - 70px);
    overflow-y: auto;
  }

  .nav__drawer[hidden] { display: none; }

  .nav__drawer nav { display: grid; }

  .nav__drawer-link {
    padding: 1rem 0;
    border-bottom: 1px solid oklch(100% 0 0 / 0.07);
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--text-on-ink);
  }
  .nav__drawer-link:hover { color: var(--gold); }

  .nav__drawer-foot { margin-top: 1.75rem; display: grid; gap: 1rem; }

  .nav__drawer-contact {
    text-align: center;
    font-size: var(--step--1);
    color: var(--text-on-ink-muted);
    letter-spacing: 0.08em;
  }

  @media (min-width: 900px) {
    .nav__links { display: flex; }
    .nav__cta { display: inline-flex; }
    .nav__toggle { display: none; }
    .nav__drawer { display: none !important; }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = nav?.querySelector<HTMLButtonElement>('.nav__toggle');
  const drawer = nav?.querySelector<HTMLElement>('.nav__drawer');

  // Solid background past the fold; hide on scroll down, reveal on scroll up.
  let last = 0;
  const onScroll = () => {
    if (!nav) return;
    const y = window.scrollY;
    nav.classList.toggle('is-stuck', y > 60);
    const open = toggle?.getAttribute('aria-expanded') === 'true';
    nav.classList.toggle('is-hidden', y > 420 && y > last && !open);
    last = y;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (drawer) drawer.hidden = open;
    document.body.style.overflow = open ? '' : 'hidden';
  });

  drawer?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      if (drawer) drawer.hidden = true;
      document.body.style.overflow = '';
    })
  );

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      toggle.click();
    }
  });
</script>
