---
/**
 * The patterns — an infinite coverflow.
 *
 * Ported from formulamobile's www/assets/js/select.js + select.css. The
 * mechanic is unchanged: infinite looping with no cloned DOM, by computing each
 * card's SIGNED SHORTEST distance to the active index around the ring
 *
 *     d = ((i - current) mod n + n + floor(n/2)) mod n - floor(n/2)
 *
 * and placing it purely by transform from that d. Nothing is reordered,
 * nothing is duplicated, and there is no seam to jump at because there is no
 * seam. Backgrounds crossfade on opacity alone, cards are glass, and the
 * inputs are drag, arrows, pips and keyboard.
 *
 * ONE DELIBERATE CHANGE. The original is a fixed full-screen selector, so it
 * calls preventDefault() on every wheel event and sets overscroll-behavior:
 * none. Dropped onto the middle of a homepage that has six sections after it,
 * that traps vertical scroll and strands the visitor — fatal on a page about to
 * take paid traffic. Wheel input is therefore bound to HORIZONTAL intent:
 * trackpad swipes and shift-wheel drive the ring, vertical scroll passes
 * straight through to the page.
 *
 * Restyled to the site's tokens: gold instead of Formula red, cream/ink
 * instead of white/black, square corners, and the card art is the drawn kamon
 * emblem rather than a photograph. The photographs are the backdrops.
 */
import { ARCHETYPES } from '../data/site';
import ArchetypeEmblem from './ArchetypeEmblem.astro';

const n = ARCHETYPES.length;
---

<section class="ac" data-select aria-roledescription="carousel" aria-label="The patterns">
  {/* ---------- background stack: opacity-only crossfade ---------- */}
  <div class="ac__bgs" aria-hidden="true">
    {
      ARCHETYPES.map((a, i) => (
        <div class:list={['ac__bg', { 'is-on': i === 0 }]} data-bg style={`--grade:${a.grade}`}>
          <img
            src={`/img/room/${a.image}.webp`}
            alt=""
            loading={i < 2 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
      ))
    }
  </div>
  <div class="ac__veil" aria-hidden="true"></div>

  {/* ---------- stage ---------- */}
  <div class="ac__stage">
    <div class="ac__track">
      {
        ARCHETYPES.map((a, i) => (
          <article
            class:list={['ac__card', { 'is-active': i === 0 }]}
            data-card
            data-name={a.name}
            aria-hidden={i === 0 ? 'false' : 'true'}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="ac__reticle" aria-hidden="true">
              <i /><i /><i /><i />
            </span>

            <div class="ac__art">
              <span class="ac__kanji" aria-hidden="true">
                {a.kanji}
              </span>
              <span class="ac__emblem">
                <ArchetypeEmblem id={a.id} />
              </span>
            </div>

            <div class="ac__body">
              <span class="ac__idx">
                {a.number} — <span lang="ja">{a.kanji}</span> {a.romaji}
              </span>
              <h3 class="ac__name">{a.name}</h3>
              <p class="ac__blurb">{a.recognise}</p>

              <dl class="ac__detail">
                <dt>What it costs</dt>
                <dd>{a.cost}</dd>
                <dt>The way through</dt>
                <dd>{a.through}</dd>
              </dl>

              <a
                class="ac__go"
                href="/mens-coaching#return-to-self"
                data-track="cta_click"
                data-track-label={`Archetype — ${a.name}`}
                data-track-section="archetypes"
              >
                How the work undoes this
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                  <path
                    d="M5 12h13M13 6l6 6-6 6"
                    stroke="currentColor"
                    stroke-width="1.8"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  {/* ---------- HUD ---------- */}
  <div class="ac__hud">
    <button class="ac__arrow ac__arrow--prev" type="button" data-prev aria-label="Previous pattern">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
        ><path
          d="M15 6l-6 6 6 6"
          stroke="currentColor"
          stroke-width="1.8"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"></path></svg
      >
    </button>
    <button class="ac__arrow ac__arrow--next" type="button" data-next aria-label="Next pattern">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
        ><path
          d="M9 6l6 6-6 6"
          stroke="currentColor"
          stroke-width="1.8"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"></path></svg
      >
    </button>

    <div class="ac__bottom">
      <p class="ac__counter"><b data-cur>01</b> / {String(n).padStart(2, '0')}</p>

      <div class="ac__pips" role="tablist" aria-label="Choose a pattern">
        {
          ARCHETYPES.map((a, i) => (
            <button
              class="ac__pip"
              type="button"
              role="tab"
              data-pip
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={a.name}
            />
          ))
        }
      </div>

      <p class="ac__hint">
        <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"
          ><path
            d="M5 12h14M13 6l6 6-6 6"
            stroke="currentColor"
            stroke-width="1.7"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
        Drag, or use the arrows
      </p>
    </div>
  </div>
</section>

<style>
  .ac {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--ink-900);
    border-block: 1px solid var(--rule-on-ink);
    min-height: min(46rem, 92svh);
    display: grid;
  }

  /* ---------- backgrounds ---------- */
  .ac__bgs { position: absolute; inset: 0; z-index: 0; }

  .ac__bg {
    position: absolute;
    inset: -8%; /* overscan so the blur never shows a soft edge */
    opacity: 0;
    transition: opacity 0.9s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }
  .ac__bg.is-on { opacity: 1; }

  .ac__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Sources are 112px wide — the upscale does most of the blurring, which
       keeps five simultaneous plates cheap to composite. */
    filter: blur(18px) saturate(1.2) brightness(0.4);
    transform: scale(1.18);
    animation: acdrift 26s ease-in-out infinite alternate;
  }
  @keyframes acdrift {
    from { transform: scale(1.18) translate3d(-1.2%, -0.8%, 0); }
    to   { transform: scale(1.28) translate3d(1.2%, 0.8%, 0); }
  }

  /* per-pattern colour grade — the backdrops differ, the accent stays gold */
  .ac__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    mix-blend-mode: color;
    opacity: 0.55;
    background: var(--grade, transparent);
  }

  .ac__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(120% 80% at 50% 42%, transparent 28%, oklch(11% 0.008 55 / 0.76) 100%),
      linear-gradient(to top, oklch(11% 0.008 55 / 0.96) 0%, transparent 30%),
      linear-gradient(to bottom, oklch(11% 0.008 55 / 0.92) 0%, transparent 24%);
  }

  /* ---------- stage ---------- */
  .ac__stage {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    perspective: 1700px;
    perspective-origin: 50% 46%;
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  .ac__track {
    position: relative;
    width: 100%;
    height: 33rem;
    transform-style: preserve-3d;
  }

  /* ---------- the glass card ---------- */
  .ac__card {
    position: absolute;
    top: 0;
    left: 50%;
    width: 22rem;
    height: 33rem;
    margin-left: -11rem;
    overflow: hidden;
    cursor: pointer;
    text-align: left;
    padding: 0;
    transform-style: preserve-3d;

    /* glass, warmed to the site's palette rather than neutral white */
    background: oklch(96% 0.02 70 / 0.055);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border: 1px solid oklch(96% 0.02 70 / 0.13);
    box-shadow:
      inset 0 1px 0 oklch(100% 0 0 / 0.16),
      inset 0 -1px 0 oklch(100% 0 0 / 0.04),
      0 36px 70px -24px oklch(6% 0.004 55 / 0.92);

    /* driven by the script */
    transform:
      translate3d(calc(var(--d) * 19rem), calc(var(--ad) * 0.9rem), calc(var(--ad) * -230px))
      rotateY(calc(var(--d) * -21deg))
      scale(var(--s, 1));
    opacity: var(--o, 1);
    filter: blur(calc(var(--ad) * 1.1px));
    z-index: var(--z, 1);
    transition:
      transform 0.62s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.5s ease,
      filter 0.5s ease,
      border-color 0.5s ease,
      box-shadow 0.5s ease;
    will-change: transform, opacity;
  }

  .ac__card.is-active {
    border-color: oklch(75% 0.12 75 / 0.55);
    box-shadow:
      inset 0 1px 0 oklch(100% 0 0 / 0.22),
      0 0 0 1px oklch(75% 0.12 75 / 0.25),
      0 0 60px -6px oklch(75% 0.12 75 / 0.4),
      0 44px 80px -26px oklch(6% 0.004 55 / 0.95);
  }

  /* sheen that only rides the active card */
  .ac__card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(115deg, transparent 38%, oklch(100% 0 0 / 0.12) 50%, transparent 62%);
    transition: opacity 0.6s ease;
    z-index: 6;
  }
  .ac__card.is-active::after { opacity: 1; }

  /* ---------- card art: the emblem, not a photo ---------- */
  .ac__art {
    position: relative;
    height: 11rem;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 80% at 50% 45%, oklch(24% 0.014 60 / 0.75), transparent 70%),
      linear-gradient(to bottom, oklch(14% 0.008 55 / 0.5), oklch(14% 0.008 55 / 0.9));
  }

  .ac__kanji {
    position: absolute;
    font-family: var(--font-jp);
    font-size: 8rem;
    line-height: 1;
    color: var(--gold);
    /* Kept faint — the emblem is the subject here, not the kanji. */
    opacity: 0.055;
    pointer-events: none;
    user-select: none;
  }

  .ac__emblem {
    position: relative;
    z-index: 2;
    width: 8.5rem;
    height: 8.5rem;
    /* A little bloom so the thin gold strokes hold against the dark ground. */
    filter: drop-shadow(0 0 14px oklch(75% 0.12 75 / 0.35));
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1), filter 0.6s ease;
  }
  .ac__card.is-active .ac__emblem {
    transform: scale(1.05);
    filter: drop-shadow(0 0 20px oklch(75% 0.12 75 / 0.5));
  }

  /* Only a foot of shadow, so the emblem is not washed out by the fade into
     the card body below it. */
  .ac__art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, oklch(14% 0.008 55 / 0.95), transparent 32%);
  }

  /* ---------- card body ---------- */
  .ac__body { padding: 0 1.4rem 1.4rem; margin-top: -1.6rem; position: relative; z-index: 2; }

  .ac__idx {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.4rem;
  }
  .ac__idx [lang='ja'] { font-family: var(--font-jp); font-size: 1.05em; }

  .ac__name {
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 300;
    line-height: 1.05;
    margin: 0 0 0.6rem;
    color: oklch(96% 0.005 60);
  }

  .ac__blurb {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--gold-light);
    margin: 0 0 0.7rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ac__detail { margin: 0; display: grid; gap: 0.15rem; }
  .ac__detail dt {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: oklch(93% 0.005 60 / 0.45);
    margin-top: 0.5rem;
  }
  .ac__detail dd {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.55;
    color: oklch(93% 0.005 60 / 0.66);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* the CTA only exists on the selected card — that's the "select" beat */
  .ac__go {
    margin-top: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-900);
    background: var(--gold);
    padding: 0.7rem 1.1rem;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.45s ease 0.12s,
      transform 0.45s cubic-bezier(0.22, 1, 0.36, 1) 0.12s, background 0.25s ease;
    pointer-events: none;
  }
  .ac__card.is-active .ac__go { opacity: 1; transform: none; pointer-events: auto; }
  .ac__go:hover { background: var(--gold-light); }

  /* targeting brackets — the game-select tell */
  .ac__reticle {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .ac__card.is-active .ac__reticle { opacity: 1; }
  .ac__reticle i {
    position: absolute;
    width: 20px;
    height: 20px;
    border: 1.5px solid var(--gold);
  }
  .ac__reticle i:nth-child(1) { top: 9px; left: 9px; border-right: 0; border-bottom: 0; }
  .ac__reticle i:nth-child(2) { top: 9px; right: 9px; border-left: 0; border-bottom: 0; }
  .ac__reticle i:nth-child(3) { bottom: 9px; left: 9px; border-right: 0; border-top: 0; }
  .ac__reticle i:nth-child(4) { bottom: 9px; right: 9px; border-left: 0; border-top: 0; }

  /* ---------- HUD ---------- */
  .ac__hud {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    display: grid;
    grid-template-rows: 1fr auto;
  }

  .ac__bottom {
    grid-row: 2;
    padding: 0 clamp(1.2rem, 4vw, 3rem) clamp(1.4rem, 3vw, 2.4rem);
    display: grid;
    gap: 0.9rem;
    justify-items: center;
    pointer-events: auto;
  }

  .ac__counter {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.2em;
    color: oklch(93% 0.005 60 / 0.5);
    font-variant-numeric: tabular-nums;
  }
  .ac__counter b { color: var(--gold); font-weight: 400; }

  .ac__pips { display: flex; gap: 0.5rem; }
  .ac__pip {
    width: 26px;
    height: 3px;
    border: 0;
    padding: 0;
    background: oklch(93% 0.005 60 / 0.2);
    cursor: pointer;
    transition: background 0.35s ease, width 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ac__pip[aria-selected='true'] { background: var(--gold); width: 42px; }

  .ac__hint {
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: oklch(93% 0.005 60 / 0.34);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: opacity 0.6s ease;
  }
  .ac.is-touched .ac__hint { opacity: 0; }
  .ac__hint svg { animation: acnudge 1.9s ease-in-out infinite; }
  @keyframes acnudge {
    0%, 100% { transform: translateX(0); opacity: 0.5; }
    50%      { transform: translateX(4px); opacity: 1; }
  }

  .ac__arrow {
    position: absolute;
    top: 50%;
    margin-top: -26px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: oklch(96% 0.02 70 / 0.06);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid oklch(96% 0.02 70 / 0.14);
    color: oklch(96% 0.005 60);
    cursor: pointer;
    pointer-events: auto;
    z-index: 4;
    transition: background 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .ac__arrow:hover {
    background: oklch(75% 0.12 75 / 0.28);
    border-color: oklch(75% 0.12 75 / 0.6);
    transform: scale(1.07);
  }
  .ac__arrow--prev { left: clamp(0.8rem, 3vw, 2.4rem); }
  .ac__arrow--next { right: clamp(0.8rem, 3vw, 2.4rem); }

  /* ---------- responsive ---------- */
  @media (max-width: 820px) {
    .ac__card { width: 17.5rem; margin-left: -8.75rem; height: 28rem; }
    .ac__track { height: 28rem; }
    .ac__art { height: 9rem; }
    .ac__emblem { width: 6rem; height: 6rem; }
    .ac__name { font-size: 1.55rem; }
    .ac__arrow { display: none; }
    .ac__card { transform:
      translate3d(calc(var(--d) * 13rem), calc(var(--ad) * 0.7rem), calc(var(--ad) * -200px))
      rotateY(calc(var(--d) * -19deg)) scale(var(--s, 1)); }
  }
  @media (max-width: 420px) {
    .ac__card { width: 15rem; margin-left: -7.5rem; }
    .ac__card { transform:
      translate3d(calc(var(--d) * 10.5rem), calc(var(--ad) * 0.6rem), calc(var(--ad) * -180px))
      rotateY(calc(var(--d) * -18deg)) scale(var(--s, 1)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ac__bg img { animation: none; }
    .ac__hint svg { animation: none; }
    .ac__card, .ac__bg, .ac__go { transition-duration: 0.001ms !important; }
  }
</style>

<script>
  import { track } from '../scripts/tracking';

  const root = document.querySelector<HTMLElement>('[data-select]');

  if (root) {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'));
    const bgs = Array.from(root.querySelectorAll<HTMLElement>('[data-bg]'));
    const pips = Array.from(root.querySelectorAll<HTMLElement>('[data-pip]'));
    const curEl = root.querySelector<HTMLElement>('[data-cur]');
    const n = cards.length;

    if (n) {
      let current = 0;
      const seen = new Set<number>();

      const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* signed shortest distance around the ring */
      function dist(i: number) {
        const half = Math.floor(n / 2);
        return ((((i - current) % n) + n + half) % n) - half;
      }

      function render() {
        cards.forEach((card, i) => {
          const d = dist(i);
          const ad = Math.abs(d);
          const active = d === 0;

          // only the nearest few are worth painting
          const visible = ad <= 3;
          card.style.setProperty('--d', String(d));
          card.style.setProperty('--ad', String(ad));
          card.style.setProperty('--s', String(active ? 1 : Math.max(0.66, 1 - ad * 0.13)));
          card.style.setProperty(
            '--o',
            String(visible ? (active ? 1 : Math.max(0, 0.62 - (ad - 1) * 0.22)) : 0)
          );
          card.style.setProperty('--z', String(20 - ad));
          card.classList.toggle('is-active', active);
          card.setAttribute('aria-hidden', active ? 'false' : 'true');
          card.tabIndex = active ? 0 : -1;
          // keep offscreen cards out of hit-testing
          card.style.pointerEvents = visible ? 'auto' : 'none';
        });

        bgs.forEach((b, i) => b.classList.toggle('is-on', i === current));
        pips.forEach((p, i) => p.setAttribute('aria-selected', i === current ? 'true' : 'false'));
        if (curEl) curEl.textContent = String(current + 1).padStart(2, '0');

        if (!seen.has(current)) {
          seen.add(current);
          track('archetype_view', {
            archetype: cards[current]?.dataset.name,
            position: current + 1,
            page_path: location.pathname,
          });
        }
      }

      const go = (delta: number) => {
        current = (((current + delta) % n) + n) % n;
        render();
      };
      const goTo = (i: number) => {
        current = ((i % n) + n) % n;
        render();
      };
      const touched = () => root.classList.add('is-touched');

      /* ---- wheel: horizontal intent only ----
         The source component owns the whole viewport and can safely swallow
         every wheel event. Here there are six sections below this one, so a
         dominantly-vertical gesture must reach the page. Horizontal trackpad
         swipes and shift-wheel drive the ring. */
      let acc = 0;
      let cooling = false;
      root.addEventListener(
        'wheel',
        (e) => {
          const horizontal = Math.abs(e.deltaX) > Math.abs(e.deltaY) || e.shiftKey;
          if (!horizontal) return; // let the page scroll

          e.preventDefault();
          touched();
          if (cooling) return;

          acc += e.shiftKey && !e.deltaX ? e.deltaY : e.deltaX;

          if (Math.abs(acc) > 42) {
            go(acc > 0 ? 1 : -1);
            acc = 0;
            cooling = true;
            setTimeout(() => { cooling = false; }, reduced() ? 40 : 340);
          }
        },
        { passive: false }
      );

      /* ---- drag / swipe ---- */
      let startX: number | null = null;
      let moved = false;

      root.addEventListener('pointerdown', (e) => {
        if ((e.target as HTMLElement).closest('a,button')) return;
        startX = e.clientX;
        moved = false;
      });

      root.addEventListener('pointermove', (e) => {
        if (startX === null) return;
        const dx = e.clientX - startX;
        if (Math.abs(dx) > 60) {
          touched();
          go(dx < 0 ? 1 : -1);
          startX = e.clientX;
          moved = true;
        }
      });

      const endDrag = () => { startX = null; };
      root.addEventListener('pointerup', endDrag);
      root.addEventListener('pointercancel', endDrag);
      root.addEventListener('pointerleave', endDrag);

      /* ---- click a side card to bring it forward ---- */
      cards.forEach((card, i) => {
        card.addEventListener('click', (e) => {
          if (moved) { e.preventDefault(); return; }
          if (dist(i) !== 0) {
            e.preventDefault();
            touched();
            goTo(i);
          }
          // the active card's CTA is a real link — let it through
        });
      });

      /* ---- arrows + pips ---- */
      root.querySelector('[data-prev]')?.addEventListener('click', () => { touched(); go(-1); });
      root.querySelector('[data-next]')?.addEventListener('click', () => { touched(); go(1); });
      pips.forEach((p, i) => p.addEventListener('click', () => { touched(); goTo(i); }));

      /* ---- keyboard ----
         Scoped to when the carousel is actually on screen; the source binds
         these globally, which on a long page would steal arrow keys from
         someone reading a different section. */
      let inView = false;
      new IntersectionObserver(
        ([entry]) => { inView = entry.isIntersecting; },
        { threshold: 0.35 }
      ).observe(root);

      window.addEventListener('keydown', (e) => {
        if (!inView && !root.contains(document.activeElement)) return;
        if (e.key === 'ArrowRight') { touched(); go(1); e.preventDefault(); }
        else if (e.key === 'ArrowLeft') { touched(); go(-1); e.preventDefault(); }
        else if (e.key === 'Home') { touched(); goTo(0); e.preventDefault(); }
        else if (e.key === 'End') { touched(); goTo(n - 1); e.preventDefault(); }
      });

      render();
    }
  }
</script>
