---
/**
 * The patterns — an infinite coverflow.
 *
 * Shell (glass cards, backdrop crossfade, HUD, reticle) comes from
 * styles/coverflow.css; the mechanic from scripts/coverflow.ts. Only the card
 * content is defined here.
 *
 * The card art is the drawn kamon emblem rather than a photograph — the
 * photographs are the backdrops. See ArchetypeEmblem.astro.
 */
import { ARCHETYPES } from '../data/site';
import ArchetypeEmblem from './ArchetypeEmblem.astro';
import '../styles/coverflow.css';

const n = ARCHETYPES.length;
---

<section class="cf ac" data-coverflow aria-roledescription="carousel" aria-label="The patterns">
  <div class="cf__bgs" aria-hidden="true">
    {
      ARCHETYPES.map((a, i) => (
        <div class:list={['cf__bg', { 'is-on': i === 0 }]} data-bg style={`--grade:${a.grade}`}>
          <img
            src={`/img/room/${a.image}.webp`}
            alt=""
            loading={i < 2 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
      ))
    }
  </div>
  <div class="cf__veil" aria-hidden="true"></div>

  <div class="cf__stage">
    <div class="cf__track">
      {
        ARCHETYPES.map((a, i) => (
          <article
            class:list={['cf__card', 'ac__card', { 'is-active': i === 0 }]}
            data-card
            data-name={a.name}
            aria-hidden={i === 0 ? 'false' : 'true'}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="cf__reticle" aria-hidden="true">
              <i /><i /><i /><i />
            </span>

            <div class="ac__art">
              <span class="ac__kanji" aria-hidden="true">
                {a.kanji}
              </span>
              <span class="ac__emblem">
                <ArchetypeEmblem id={a.id} />
              </span>
            </div>

            <div class="ac__body">
              <span class="ac__idx">
                {a.number} — <span lang="ja">{a.kanji}</span> {a.romaji}
              </span>
              <h3 class="ac__name">{a.name}</h3>
              <p class="ac__blurb">{a.recognise}</p>

              <dl class="ac__detail">
                <dt>What it costs</dt>
                <dd>{a.cost}</dd>
                <dt>The way through</dt>
                <dd>{a.through}</dd>
              </dl>

              <a
                class="cf__go"
                href="/mens-coaching#return-to-self"
                data-track="cta_click"
                data-track-label={`Archetype — ${a.name}`}
                data-track-section="archetypes"
              >
                How the work undoes this
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                  <path
                    d="M5 12h13M13 6l6 6-6 6"
                    stroke="currentColor"
                    stroke-width="1.8"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="cf__hud">
    <button class="cf__arrow cf__arrow--prev" type="button" data-prev aria-label="Previous pattern">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
        ><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg
      >
    </button>
    <button class="cf__arrow cf__arrow--next" type="button" data-next aria-label="Next pattern">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
        ><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg
      >
    </button>

    <div class="cf__bottom">
      <p class="cf__counter"><b data-cur>01</b> / {String(n).padStart(2, '0')}</p>

      <div class="cf__pips" role="tablist" aria-label="Choose a pattern">
        {
          ARCHETYPES.map((a, i) => (
            <button
              class="cf__pip"
              type="button"
              role="tab"
              data-pip
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={a.name}
            />
          ))
        }
      </div>

      <p class="cf__hint">
        <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"
          ><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
        Drag, or use the arrows
      </p>
    </div>
  </div>
</section>

<style>
  .ac { min-height: min(46rem, 92svh); }

  /* ---------- card art: the emblem, not a photo ---------- */
  .ac__art {
    position: relative;
    height: 11rem;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 80% at 50% 45%, oklch(24% 0.014 60 / 0.75), transparent 70%),
      linear-gradient(to bottom, oklch(14% 0.008 55 / 0.5), oklch(14% 0.008 55 / 0.9));
  }

  .ac__kanji {
    position: absolute;
    font-family: var(--font-jp);
    font-size: 8rem;
    line-height: 1;
    color: var(--gold);
    /* Kept faint — the emblem is the subject here, not the kanji. */
    opacity: 0.055;
    pointer-events: none;
    user-select: none;
  }

  .ac__emblem {
    position: relative;
    z-index: 2;
    width: 8.5rem;
    height: 8.5rem;
    /* A little bloom so the thin gold strokes hold against the dark ground. */
    filter: drop-shadow(0 0 14px oklch(75% 0.12 75 / 0.35));
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1), filter 0.6s ease;
  }
  .ac__card.is-active .ac__emblem {
    transform: scale(1.05);
    filter: drop-shadow(0 0 20px oklch(75% 0.12 75 / 0.5));
  }

  /* Only a foot of shadow, so the emblem is not washed out by the fade into
     the card body below it. */
  .ac__art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, oklch(14% 0.008 55 / 0.95), transparent 32%);
  }

  /* ---------- card body ---------- */
  .ac__body { padding: 0 1.4rem 1.4rem; margin-top: -1.6rem; position: relative; z-index: 2; }

  .ac__idx {
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.4rem;
  }
  .ac__idx [lang='ja'] { font-family: var(--font-jp); font-size: 1.05em; }

  .ac__name {
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 300;
    line-height: 1.05;
    margin: 0 0 0.6rem;
    color: oklch(96% 0.005 60);
  }

  .ac__blurb {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--gold-light);
    margin: 0 0 0.7rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ac__detail { margin: 0; display: grid; gap: 0.15rem; }
  .ac__detail dt {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: oklch(93% 0.005 60 / 0.45);
    margin-top: 0.5rem;
  }
  .ac__detail dd {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.55;
    color: oklch(93% 0.005 60 / 0.66);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 820px) {
    .ac__art { height: 9rem; }
    .ac__emblem { width: 6rem; height: 6rem; }
    .ac__name { font-size: 1.55rem; }
  }
</style>

<script>
  import { initCoverflow } from '../scripts/coverflow';
  import { track } from '../scripts/tracking';

  const root = document.querySelector<HTMLElement>('.ac[data-coverflow]');
  if (root) {
    const seen = new Set<number>();
    initCoverflow(root, {
      onChange(i, card) {
        if (seen.has(i)) return;
        seen.add(i);
        track('archetype_view', {
          archetype: card?.dataset.name,
          position: i + 1,
          page_path: location.pathname,
        });
      },
    });
  }
</script>
