---
/**
 * 守破離 — the Return to Self arc, as a coverflow.
 *
 * Replaces a pinned horizontal-scroll timeline. That version worked, but it
 * cost ~1,570px of hijacked vertical scroll to show three panels, and pinning
 * on a commercial page means a visitor who wants to reach the pricing section
 * has to sit through the whole animation first. The coverflow shows the same
 * three phases, on demand, in a fixed amount of page.
 *
 * Shell from styles/coverflow.css, mechanic from scripts/coverflow.ts — the
 * same glass, backdrop crossfade and ring used by the archetypes, so the two
 * carousels read as one system.
 */
import { PHASES } from '../data/site';
import '../styles/coverflow.css';

const n = PHASES.length;
---

<section class="cf ph" data-coverflow aria-roledescription="carousel" aria-label="The three phases">
  <div class="cf__bgs" aria-hidden="true">
    {
      PHASES.map((p, i) => (
        <div class:list={['cf__bg', { 'is-on': i === 0 }]} data-bg style={`--grade:${p.grade}`}>
          <img
            src={`/img/room/${p.image}.webp`}
            alt=""
            loading={i < 2 ? 'eager' : 'lazy'}
            decoding="async"
          />
        </div>
      ))
    }
  </div>
  <div class="cf__veil" aria-hidden="true"></div>

  <div class="cf__stage">
    <div class="cf__track">
      {
        PHASES.map((p, i) => (
          <article
            class:list={['cf__card', 'ph__card', { 'is-active': i === 0 }]}
            data-card
            data-name={p.name}
            aria-hidden={i === 0 ? 'false' : 'true'}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="cf__reticle" aria-hidden="true">
              <i /><i /><i /><i />
            </span>

            <span class="ph__glyph" lang="ja" aria-hidden="true">
              {p.kanji}
            </span>

            <div class="ph__body">
              <p class="ph__head">
                <span class="ph__num">{p.number}</span>
                <span class="ph__weeks">{p.weeks}</span>
              </p>

              <h3 class="ph__name">{p.name}</h3>

              <p class="ph__romaji">
                <span lang="ja">{p.kanji}</span>
                <em>{p.romaji}</em>
                <span class="ph__meaning">— {p.kanjiMeaning}</span>
              </p>

              <p class="ph__aim">{p.aim}</p>
              <p class="ph__blurb">{p.blurb}</p>
              <p class="ph__trust">{p.selfTrust}</p>

              <ul class="ph__weeklist">
                {p.weekList.map((w) => (
                  <li>{w}</li>
                ))}
              </ul>

              <a
                class="cf__go"
                href="/apply"
                data-track="cta_click"
                data-track-label={`Phase — ${p.name}`}
                data-track-section="programme"
              >
                Apply for the programme
                <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                  <path
                    d="M5 12h13M13 6l6 6-6 6"
                    stroke="currentColor"
                    stroke-width="1.8"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="cf__hud">
    <button class="cf__arrow cf__arrow--prev" type="button" data-prev aria-label="Previous phase">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
        ><path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg
      >
    </button>
    <button class="cf__arrow cf__arrow--next" type="button" data-next aria-label="Next phase">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
        ><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg
      >
    </button>

    <div class="cf__bottom">
      <p class="cf__counter"><b data-cur>01</b> / {String(n).padStart(2, '0')}</p>

      <div class="cf__pips" role="tablist" aria-label="Choose a phase">
        {
          PHASES.map((p, i) => (
            <button
              class="cf__pip"
              type="button"
              role="tab"
              data-pip
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={`${p.name} — ${p.weeks}`}
            />
          ))
        }
      </div>

      <p class="cf__hint">
        <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"
          ><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"></path></svg
        >
        Drag, or use the arrows
      </p>
    </div>
  </div>
</section>

<style>
  /* Taller and wider than the archetype cards — a phase carries more copy. */
  .ph { --cf-w: 25rem; --cf-h: 31.5rem; --cf-gap: 21rem; min-height: min(48rem, 94svh); }

  .ph__card { overflow: hidden; }

  .ph__glyph {
    position: absolute;
    inset-block-start: -0.2em;
    inset-inline-end: -0.06em;
    font-family: var(--font-jp);
    font-size: 15rem;
    line-height: 1;
    color: var(--gold);
    opacity: 0.09;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .ph__body {
    position: relative;
    z-index: 2;
    padding: clamp(1.4rem, 2.6vw, 2rem);
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .ph__head {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: 0.4rem;
  }
  .ph__num {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 300;
    line-height: 1;
    color: oklch(75% 0.12 75 / 0.6);
  }
  .ph__weeks {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .ph__name {
    font-family: var(--font-display);
    font-size: 2.3rem;
    font-weight: 300;
    line-height: 1.05;
    margin: 0 0 0.5rem;
    color: oklch(96% 0.005 60);
  }

  .ph__romaji {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem;
    font-size: 0.72rem;
    color: oklch(93% 0.005 60 / 0.5);
    padding-bottom: 0.8rem;
    margin-bottom: 0.8rem;
    border-bottom: 1px solid oklch(100% 0 0 / 0.1);
  }
  .ph__romaji [lang='ja'] { font-family: var(--font-jp); font-size: 1.15em; color: var(--gold); }
  .ph__romaji em { font-style: italic; letter-spacing: 0.08em; color: oklch(93% 0.005 60 / 0.72); }
  .ph__meaning { opacity: 0.8; }

  .ph__aim {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.4;
    color: var(--gold-light);
    margin: 0 0 0.7rem;
  }

  .ph__blurb {
    font-size: 0.82rem;
    line-height: 1.6;
    color: oklch(93% 0.005 60 / 0.7);
    margin: 0 0 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ph__trust {
    font-size: 0.74rem;
    line-height: 1.55;
    color: oklch(93% 0.005 60 / 0.5);
    padding-left: 0.85rem;
    border-left: 1px solid oklch(75% 0.12 75 / 0.4);
    margin: 0 0 0.85rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ph__weeklist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0 0 auto;
  }
  .ph__weeklist li {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: oklch(93% 0.005 60 / 0.5);
    border: 1px solid oklch(100% 0 0 / 0.14);
    padding: 0.3rem 0.5rem;
  }

  @media (max-width: 820px) {
    .ph { --cf-w: 18.5rem; --cf-h: 32rem; --cf-gap: 14rem; }
    .ph__name { font-size: 1.9rem; }
    .ph__glyph { font-size: 11rem; }
  }
  @media (max-width: 420px) {
    .ph { --cf-w: 16rem; --cf-gap: 11rem; }
  }
</style>

<script>
  import { initCoverflow } from '../scripts/coverflow';
  import { track } from '../scripts/tracking';

  const root = document.querySelector<HTMLElement>('.ph[data-coverflow]');
  if (root) {
    const seen = new Set<number>();
    initCoverflow(root, {
      onChange(i, card) {
        if (seen.has(i)) return;
        seen.add(i);
        track('phase_view', {
          phase: card?.dataset.name,
          position: i + 1,
          page_path: location.pathname,
        });
      },
    });
  }
</script>
