---
/**
 * Footer.
 *
 * Carries the two things the legacy footer was missing: policy links, which
 * Meta requires before it will run ads (audit C3), and non-WhatsApp contact
 * routes — email and tel — since WhatsApp-only excluded a real slice of the
 * audience, particularly parents (M9).
 */
import { SITE, NAV } from '../data/site';
import { LINKS } from '../data/morel-source';
import BrandMark from './BrandMark.astro';
import { srcset, src } from '../lib/images';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      {/* Portrait beside the mark — the person, then the brand. */}
      <div class="footer__identity">
        <img
          class="footer__portrait"
          src={src('portrait-harrison')}
          srcset={srcset('portrait-harrison') || undefined}
          sizes="56px"
          alt="Harrison Saito"
          width="56"
          height="56"
          loading="lazy"
          decoding="async"
        />
        <a href="/" class="footer__mark" aria-label="Harrison Saito — home">
          <BrandMark variant="light" size={56} loading="lazy" />
        </a>
        <div class="footer__who">
          <a href="/" class="footer__name">Harrison Saito</a>
          <p class="footer__tagline">Educator. Martial Artist. Coach.</p>
        </div>
      </div>
      <p class="footer__loc">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" aria-hidden="true">
          <path
            d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z"
            stroke="currentColor"
            stroke-width="1.6"></path>
          <circle cx="12" cy="10" r="2.4" stroke="currentColor" stroke-width="1.6"></circle>
        </svg>
        {SITE.locality}, {SITE.region} Australia
      </p>
      <p class="footer__note">
        Coaching and mentoring. Not therapy, diagnosis or emergency care.
      </p>
    </div>

    {/* Explore, Work With Me and Contact share one row at every width (Dion,
        18 Sep: "more compact… all on the same scaled row"). On a phone the row
        scales down with them: shorter labels, and "Email" / "Call" in place
        of the address and the number, which are a column wide on their own. */}
    <div class="footer__cols">
    <div class="footer__col">
      <h2 class="footer__head">Explore</h2>
      <ul>
        {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="footer__head">Work With Me</h2>
      <ul>
        <li><a href="/apply"><span class="footer__long">Apply — Return to Self</span><span class="footer__short">Return to Self</span></a></li>
        <li><a href="/book"><span class="footer__long">Start the conversation</span><span class="footer__short">Talk with me</span></a></li>
        <li><a href="/mens-coaching"><span class="footer__long">1:1 Life Coaching</span><span class="footer__short">Life Coaching</span></a></li>
        <li><a href="/hsc-tutoring"><span class="footer__long">HSC &amp; Youth Mentoring</span><span class="footer__short">HSC Mentoring</span></a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="footer__head">Contact</h2>
      <ul>
        <li>
          <a href={`mailto:${SITE.email}`} data-track="cta_click" data-track-label="Footer — email" aria-label={`Email ${SITE.email}`}>
            <span class="footer__long">{SITE.email}</span><span class="footer__short">Email</span>
          </a>
        </li>
        <li>
          <a href={`tel:${SITE.phone}`} data-track="cta_click" data-track-label="Footer — phone" aria-label={`Call ${SITE.phoneDisplay}`}>
            <span class="footer__long">{SITE.phoneDisplay}</span><span class="footer__short">Call</span>
          </a>
        </li>
        <li>
          <a href={SITE.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        </li>
        <li>
          <a href={SITE.youtube} target="_blank" rel="noopener noreferrer">YouTube</a>
        </li>
      </ul>
    </div>
    </div>

    {/* The two crests. They arrived as black line art on white — one of them
        a screenshot — and were rebuilt as cream-on-transparent marks by
        scripts/make-marks.py rather than knocked out by hand, so they carry
        no halo and CSS decides how loud they are.

        Marks and names only. What each relationship actually is — trained,
        ordained, affiliated — is Harrison's to word, so nothing is claimed
        here beyond the names themselves. */}
    <ul class="footer__crests">
      <li>
        <a href={LINKS.shinbukan} target="_blank" rel="noopener">
          <img src="/img/mark-shinbukan.webp" alt="" width="200" height="200" loading="lazy" decoding="async" />
          <span>Shinbukan Martial Arts</span>
        </a>
      </li>
      <li>
        <a href={LINKS.seizanji} target="_blank" rel="noopener">
          <img src="/img/mark-seizanji.webp" alt="" width="364" height="200" loading="lazy" decoding="async" />
          <span>Koyasan Seizanji Temple</span>
        </a>
      </li>
    </ul>
  </div>

  <div class="container footer__bar">
    <p>&copy; {year} Harrison Saito. All rights reserved.</p>
    <nav class="footer__legal" aria-label="Legal">
      <a href="/privacy">Privacy Policy</a>
      <a href="/terms">Terms</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink-900);
    color: var(--text-on-ink);
    border-top: 2px solid oklch(75% 0.12 75 / 0.35);
    padding-block: clamp(2.25rem, 4vw, 3.5rem) 1.5rem;
  }

  .footer__inner {
    display: grid;
    gap: clamp(1.75rem, 3vw, 3rem);
    grid-template-columns: 1fr;
  }
  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 3vw, 3rem);
    align-items: start;
  }
  .footer__short { display: none; }

  .footer__identity {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 0.4rem;
  }
  .footer__who { min-width: 0; }
  .footer__who .footer__tagline { margin-top: 0.1rem; }

  .footer__portrait {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid oklch(75% 0.12 75 / 0.35);
    filter: saturate(0.9);
  }

  .footer__mark {
    display: block;
    width: 56px;
    flex-shrink: 0;
    opacity: 0.9;
    transition: opacity var(--dur-fast) ease, transform var(--dur) var(--ease-out-expo);
  }
  .footer__mark:hover { opacity: 1; transform: rotate(-8deg); }

  .footer__name {
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.1;
    font-weight: 300;
    color: oklch(93% 0.005 60 / 0.92);
  }
  .footer__name:hover { color: var(--gold); }

  .footer__tagline,
  .footer__loc,
  .footer__note {
    font-size: var(--step--1);
    color: oklch(93% 0.005 60 / 0.42);
    margin-top: 0.6rem;
    line-height: 1.6;
  }

  .footer__crests {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.6rem;
  }
  .footer__crests li,
  .footer__crests a {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: inherit;
  }
  .footer__crests img {
    height: 38px;
    width: auto;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }
  .footer__crests a:hover img,
  .footer__crests a:focus-visible img {
    opacity: 1;
  }
  .footer__crests span {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.3;
    color: var(--text-on-ink-faint);
  }
  .footer__crests a:hover span,
  .footer__crests a:focus-visible span {
    color: var(--text-on-ink);
  }

  .footer__loc { display: flex; align-items: center; gap: 0.5rem; }

  .footer__note {
    margin-top: 0.5rem;
    max-width: 44ch;
    color: oklch(93% 0.005 60 / 0.3);
    font-size: 0.75rem;
  }

  .footer__head {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.8rem;
  }

  .footer__col ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.45rem; }
  .footer__col li { line-height: 1.4; }

  .footer__col a {
    font-size: var(--step--1);
    color: oklch(93% 0.005 60 / 0.55);
    transition: color var(--dur-fast) ease;
  }
  .footer__col a:hover { color: var(--gold); }

  .footer__bar {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: 1.1rem;
    border-top: 1px solid oklch(100% 0 0 / 0.09);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
  }

  .footer__bar p {
    font-size: 0.75rem;
    color: oklch(93% 0.005 60 / 0.3);
  }

  .footer__legal { display: flex; gap: 1.5rem; }
  .footer__legal a {
    font-size: 0.75rem;
    color: oklch(93% 0.005 60 / 0.45);
  }
  .footer__legal a:hover { color: var(--gold); }

  @media (min-width: 900px) {
    .footer__inner { grid-template-columns: minmax(0, 1.5fr) minmax(0, 3fr); align-items: start; row-gap: 1.5rem; }
    .footer__crests { grid-column: 1 / -1; }
  }
  /* A phone: the same row, scaled to fit. */
  @media (max-width: 639px) {
    .footer__long { display: none; }
    .footer__short { display: inline; }
    .footer__head { font-size: 0.64rem; letter-spacing: 0.12em; margin-bottom: 0.6rem; }
    .footer__col a { font-size: 0.78rem; }
    .footer__col ul { gap: 0.7rem; }
    .footer__bar { gap: 0.4rem 1rem; }
    .footer__crests img { height: 30px; }
    .footer__crests { gap: 0.6rem 1.2rem; }
  }
</style>
