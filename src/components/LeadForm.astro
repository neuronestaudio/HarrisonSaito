---
/**
 * Lead capture — three taps and a name.
 *
 * Closes audit finding C2 (the legacy site had zero forms) in the shape the
 * campaign playbook asks for: the low-commitment questions first, contact
 * details last, once someone has already invested a few taps. Rebuilt on
 * 12 Sep 2026 at Dion's ask as a stepped, glass form: each tap answers the
 * question and moves on by itself, and the only typing is at the end.
 *
 *   1  Which path brings you to Harrison? (skipped where the page already says)
 *   2  What would you like to talk about? (the choices follow the answer above)
 *   3  When suits you?
 *   4  Your name and phone (email optional) → send
 *
 * Submission posts JSON to /api/lead (api/lead.ts on Vercel) and fires a Lead
 * event with an event_id shared with the server-side Conversions API call, so
 * Meta can deduplicate the pair. The success screen also offers WhatsApp with
 * the answers already written, so nothing is ever stranded.
 */
import { SITE } from '../data/site';

interface Choice {
  value: string;
  label: string;
  hint?: string;
}

interface Props {
  formId: string;
  /** GA4/Meta event name fired on success. */
  eventName?: string;
  /** Value attributed to the conversion, for ROAS reporting. */
  eventValue?: number;
  submitLabel?: string;
  successHeading?: string;
  successBody?: string;
  /** Answers "What is this about?" for the page, so the form opens on the next question. */
  preset?: string;
}

const {
  formId,
  eventName = 'lead',
  eventValue,
  submitLabel = 'Send',
  successHeading = 'Thank you.',
  successBody = "Your message is with me. I'll reply personally, usually within a day.",
  preset,
} = Astro.props;

const ABOUT: Choice[] = [
  { value: 'coaching', label: 'Coaching', hint: 'One to one, with Harrison' },
  { value: 'programme', label: 'Return to Self', hint: 'The 12-week program' },
  { value: 'martial', label: 'Martial arts', hint: 'Shinbukan, Chatswood' },
  { value: 'media', label: 'Media or speaking', hint: 'Interviews, talks and collaborations' },
  { value: 'other', label: 'Something else', hint: 'A question, or just a conversation' },
];

const TOPICS: Record<string, Choice[]> = {
  coaching: [
    { value: 'where-i-am', label: 'Where I am right now', hint: 'What is going on, honestly' },
    { value: 'is-this-for-me', label: 'Whether this is for me', hint: 'What coaching with Harrison actually is' },
    { value: 'one-to-one', label: 'Working together one to one', hint: 'How it runs, what it costs' },
    { value: 'on-the-call', label: "I'd rather say it on the call" },
  ],
  programme: [
    { value: 'the-twelve-weeks', label: 'How the twelve weeks work', hint: 'Separate, return, then integrate' },
    { value: 'is-this-for-me', label: 'Whether this is for me', hint: 'Where you are, and where it leads' },
    { value: 'next-intake', label: 'When the next intake starts', hint: 'Places and timing' },
    { value: 'on-the-call', label: "I'd rather say it on the call" },
  ],
  martial: [
    { value: 'training', label: 'Training at Shinbukan', hint: 'Classes, grading, the dojo' },
    { value: 'private', label: 'Private sessions', hint: 'One to one on the mat' },
    { value: 'on-the-call', label: "I'd rather say it on the call" },
  ],
  media: [
    { value: 'interview', label: 'An interview or podcast' },
    { value: 'talk', label: 'A talk or workshop' },
    { value: 'collaboration', label: 'A collaboration' },
  ],
  other: [
    { value: 'question', label: 'A question' },
    { value: 'conversation', label: 'Just a conversation' },
    { value: 'on-the-call', label: "I'll explain on the call" },
  ],
};

/* Dion, 29 Sep 2026: not "weekday mornings" any more — a day. The next
   fourteen are drawn by the script when the page opens (Sydney time, so they
   are always today's fourteen), one is chosen, and its date goes up as
   `timing` (2026-10-01) with "Wed 1 Oct" as the label — so a calendar can be
   put behind it later. This is the one choice that is not a day. */
const TIMING: Choice[] = [{ value: 'flexible', label: "I'm flexible" }];
const DAYS_AHEAD = 14;

const RAIL = preset ? ['Talk about', 'When', 'You'] : ['Your path', 'Talk about', 'When', 'You'];
const presetLabel = preset ? ABOUT.find((c) => c.value === preset)?.label ?? '' : '';
---

<div
  class="lf"
  data-lead-form={formId}
  data-event={eventName}
  data-event-value={eventValue}
  data-preset={preset}
  data-preset-label={presetLabel}
  data-whatsapp={SITE.whatsapp}
>
  <form class="lf__form" novalidate>
    <header class="lf__head">
      <button type="button" class="lf__back" data-step-back aria-label="Back to the previous question" hidden>
        <span aria-hidden="true">←</span>
      </button>
      <ol class="lf__rail" aria-label="Progress">
        {RAIL.map((l, i) => (
          <li class:list={[{ 'is-active': i === 0 }]} data-rail={i}>
            <span class="lf__rail-bar" aria-hidden="true"></span>
            <span class="lf__rail-label">{l}</span>
          </li>
        ))}
      </ol>
      <p class="lf__count" data-count aria-live="polite">1 of {RAIL.length}</p>
    </header>

    <div class="lf__stage" data-stage>
      {/* ---- 1. what is this about ---- */}
      <fieldset class="lf__step" data-step="about" hidden={!!preset}>
        {/* Dion, 30 Sep: "What is this about?" sounded demanding; pathways to Harrison */}
        <legend class="lf__q">Which path brings you to Harrison?</legend>
        <p class="lf__hint">There is no wrong door. Choose the one closest to where you are.</p>
        <div class="lf__choices lf__choices--two" role="radiogroup" aria-label="Which path brings you to Harrison?">
          {ABOUT.map((c) => (
            <button type="button" class="lf__choice" role="radio" aria-checked="false" data-choice="about" data-value={c.value} data-label={c.label}>
              <span class="lf__choice-label">{c.label}</span>
              {c.hint && <span class="lf__choice-hint">{c.hint}</span>}
              <span class="lf__choice-mark" aria-hidden="true"></span>
            </button>
          ))}
        </div>
        <input type="hidden" name="about" value={preset ?? ''} />
        <input type="hidden" name="about_label" value={presetLabel} />
      </fieldset>

      {/* ---- 2. what would you like to talk about (the set follows step 1) ---- */}
      <fieldset class="lf__step" data-step="topic" hidden={!preset}>
        <legend class="lf__q">What would you like to talk about?</legend>
        {Object.entries(TOPICS).map(([key, list]) => (
          <div class="lf__choices lf__choices--two" role="radiogroup" aria-label="What would you like to talk about?" data-topics={key} hidden>
            {list.map((c) => (
              <button type="button" class="lf__choice" role="radio" aria-checked="false" data-choice="topic" data-value={c.value} data-label={c.label}>
                <span class="lf__choice-label">{c.label}</span>
                {c.hint && <span class="lf__choice-hint">{c.hint}</span>}
                <span class="lf__choice-mark" aria-hidden="true"></span>
              </button>
            ))}
          </div>
        ))}
        <input type="hidden" name="topic" value="" />
        <input type="hidden" name="topic_label" value="" />
      </fieldset>

      {/* ---- 3. when suits you: a day from the next fourteen, or flexible ---- */}
      <fieldset class="lf__step" data-step="timing" hidden>
        <legend class="lf__q">When suits you?</legend>
        <p class="lf__hint">Pick a day in the next two weeks, then a two-hour window for his call. Sydney time.</p>
        <div class="lf__choices lf__when" role="radiogroup" aria-label="When suits you?">
          {/* the fourteen days: drawn by the script, so they are always today's */}
          <div class="lf__days" data-days data-days-ahead={DAYS_AHEAD}></div>
          {/* Dion, 30 Sep: after a day, its two-hour windows, 8 am to 8 pm */}
          <div class="lf__windows" data-windows hidden>
            <p class="lf__windows-day" data-windows-day aria-live="polite"></p>
            <div class="lf__windows-grid" data-windows-grid></div>
          </div>
          {TIMING.map((c) => (
            <button type="button" class="lf__choice lf__choice--wide" role="radio" aria-checked="false" data-choice="timing" data-value={c.value} data-label={c.label}>
              <span class="lf__choice-label">{c.label}</span>
              <span class="lf__choice-hint">Any day works — Harrison will suggest one</span>
              <span class="lf__choice-mark" aria-hidden="true"></span>
            </button>
          ))}
        </div>
        <input type="hidden" name="timing" value="" />
        <input type="hidden" name="timing_label" value="" />
      </fieldset>

      {/* ---- 4. you ---- */}
      <fieldset class="lf__step lf__step--contact" data-step="contact" hidden>
        <legend class="lf__q">Where can I reach you?</legend>
        <ul class="lf__summary" data-summary aria-label="Your answers so far"></ul>

        <div class="lf__fields">
          <div class="lf__field lf__field--wide">
            <label class="lf__label" for={`${formId}-name`}>Your name</label>
            <input class="lf__input" id={`${formId}-name`} name="name" type="text" required autocomplete="name" placeholder="First and last" />
            <p class="lf__error" data-error-for="name" hidden></p>
          </div>
          <div class="lf__field">
            <label class="lf__label" for={`${formId}-phone`}>Phone</label>
            <input class="lf__input" id={`${formId}-phone`} name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="04…" />
            <p class="lf__help">So I can call rather than trade emails for a week.</p>
            <p class="lf__error" data-error-for="phone" hidden></p>
          </div>
          <div class="lf__field">
            <label class="lf__label" for={`${formId}-email`}>Email <span class="lf__optional">optional</span></label>
            <input class="lf__input" id={`${formId}-email`} name="email" type="email" autocomplete="email" placeholder="you@…" />
            <p class="lf__error" data-error-for="email" hidden></p>
          </div>
        </div>

        <label class="lf__consent">
          <input type="checkbox" name="consent" required />
          <span>
            I agree to Harrison Saito storing these details in order to respond. See the
            <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.
          </span>
        </label>

        <button type="submit" class="lf__submit" data-submit>
          <span>{submitLabel}</span><span aria-hidden="true">→</span>
        </button>
      </fieldset>
    </div>

    {/* Honeypot — bots fill it, humans never see it. */}
    <div class="lf__pot" aria-hidden="true">
      <label for={`${formId}-website`}>Website</label>
      <input id={`${formId}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <p class="lf__formerror" data-form-error hidden role="alert"></p>
  </form>

  <div class="lf__success" data-success hidden>
    <span class="lf__success-mark" aria-hidden="true">円</span>
    <h3>{successHeading}</h3>
    <p>{successBody}</p>
    <a class="lf__wa" data-whatsapp-link href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener">
      Or message me on WhatsApp <span aria-hidden="true">→</span>
    </a>
  </div>
</div>

<style>
  /* ---- the glass ----------------------------------------------------------
     Sits in the site's deep sections. A pane of frosted glass over the ink,
     lit from the top-left, a gold breath behind the question. */
  .lf {
    --glass-bg: linear-gradient(160deg, oklch(100% 0 0 / 0.11), oklch(100% 0 0 / 0.035) 46%, oklch(100% 0 0 / 0.07));
    --glass-line: oklch(100% 0 0 / 0.14);
    --glass-tile: oklch(100% 0 0 / 0.06);
    --glass-tile-hover: oklch(100% 0 0 / 0.1);
    position: relative;
    isolation: isolate;
    color: var(--text-on-ink);
    border-radius: 24px;
    padding: clamp(1.4rem, 4vw, 2.6rem);
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(28px) saturate(1.25);
    backdrop-filter: blur(28px) saturate(1.25);
    border: 1px solid var(--glass-line);
    box-shadow:
      inset 0 1px 0 oklch(100% 0 0 / 0.18),
      inset 0 -1px 0 oklch(0% 0 0 / 0.25),
      0 30px 80px -30px oklch(0% 0 0 / 0.75);
    overflow: hidden;
  }
  .lf::before {
    content: '';
    position: absolute;
    inset: -30% -20% auto -20%;
    height: 70%;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse at 22% 18%, oklch(84% 0.11 78 / 0.22), transparent 58%);
    filter: blur(20px);
  }

  /* ---- head: back, rail, count ---- */
  .lf__head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: clamp(1.4rem, 3vw, 2rem);
  }
  .lf__back {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--glass-line);
    background: var(--glass-tile);
    color: var(--text-on-ink);
    font-size: 1.05rem;
    cursor: pointer;
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out-expo);
  }
  .lf__back:hover { background: var(--glass-tile-hover); border-color: var(--gold); transform: translateX(-2px); }
  .lf__back[hidden] { display: none; }
  .lf__head:has(.lf__back[hidden]) { grid-template-columns: 1fr auto; }

  .lf__rail {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: 0.45rem;
  }
  .lf__rail li { display: grid; gap: 0.4rem; }
  .lf__rail-bar {
    height: 3px;
    border-radius: 3px;
    background: oklch(100% 0 0 / 0.14);
    transition: background var(--dur) ease, box-shadow var(--dur) ease;
  }
  .lf__rail li.is-done .lf__rail-bar { background: var(--gold-deep); }
  .lf__rail li.is-active .lf__rail-bar { background: var(--gold); box-shadow: 0 0 12px oklch(75% 0.12 75 / 0.6); }
  .lf__rail-label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-on-ink-faint);
    transition: color var(--dur-fast) ease;
  }
  .lf__rail li.is-active .lf__rail-label, .lf__rail li.is-done .lf__rail-label { color: var(--text-on-ink-muted); }
  .lf__rail li.is-active .lf__rail-label { color: var(--gold); }
  @media (max-width: 480px) { .lf__rail-label { display: none; } }

  .lf__count {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--text-on-ink-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  /* ---- the stage: one question at a time ---- */
  .lf__stage { display: grid; }
  .lf__step {
    grid-area: 1 / 1;
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .lf__step[hidden] { display: none; }
  .lf__step.is-entering { animation: lf-in 0.5s var(--ease-out-expo) both; }
  @keyframes lf-in {
    from { opacity: 0; transform: translateX(26px); }
    to { opacity: 1; transform: none; }
  }
  .lf__step.is-entering.is-backwards { animation-name: lf-in-back; }
  @keyframes lf-in-back {
    from { opacity: 0; transform: translateX(-26px); }
    to { opacity: 1; transform: none; }
  }

  .lf__q {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.5rem, 3.2vw, 2.1rem);
    line-height: 1.15;
    letter-spacing: 0.005em;
    color: var(--text-on-ink);
    margin-bottom: clamp(1rem, 2.4vw, 1.5rem);
    text-wrap: balance;
    padding: 0;
  }

  /* ---- choices: glass tiles that answer on tap ---- */
  .lf__choices { display: grid; gap: 0.6rem; }
  .lf__choices[hidden] { display: none; }
  /* Two-up only where each tile has room for its words: in a narrow column
     (the campaign page at tablet width) a 90px tile set one word a line. */
  .lf__choices--two { grid-template-columns: repeat(auto-fit, minmax(min(100%, 11.5rem), 1fr)); }

  .lf__choice {
    position: relative;
    display: grid;
    gap: 0.15rem;
    text-align: left;
    padding: 0.95rem 3rem 0.95rem 1.1rem;
    border-radius: 14px;
    border: 1px solid var(--glass-line);
    background: var(--glass-tile);
    color: var(--text-on-ink);
    cursor: pointer;
    font: inherit;
    box-shadow: inset 0 1px 0 oklch(100% 0 0 / 0.08);
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out-expo), box-shadow var(--dur-fast) ease;
    -webkit-tap-highlight-color: transparent;
  }
  .lf__choice:hover { background: var(--glass-tile-hover); border-color: oklch(84% 0.11 78 / 0.5); transform: translateY(-1px); }
  .lf__choice:focus-visible { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px oklch(75% 0.12 75 / 0.28), inset 0 1px 0 oklch(100% 0 0 / 0.08); }
  .lf__choice-label { font-family: var(--font-display); font-size: 1.18rem; line-height: 1.2; }
  .lf__choice-hint { font-size: 0.78rem; color: var(--text-on-ink-muted); line-height: 1.4; }
  .lf__choice-mark {
    position: absolute;
    right: 0.95rem;
    top: 50%;
    width: 22px;
    height: 22px;
    margin-top: -11px;
    border-radius: 50%;
    border: 1px solid oklch(100% 0 0 / 0.22);
    transition: border-color var(--dur-fast) ease, background var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out-expo);
  }
  .lf__choice-mark::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 4px;
    width: 5px;
    height: 9px;
    border: solid var(--ink-900);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg) scale(0);
    transition: transform var(--dur-fast) var(--ease-out-expo);
  }
  .lf__choice[aria-checked='true'] {
    border-color: var(--gold);
    background: oklch(75% 0.12 75 / 0.14);
    box-shadow: 0 0 0 1px oklch(75% 0.12 75 / 0.35), 0 10px 30px -14px oklch(75% 0.12 75 / 0.7);
  }
  .lf__choice[aria-checked='true'] .lf__choice-mark { background: var(--gold); border-color: var(--gold); transform: scale(1.05); }
  .lf__choice[aria-checked='true'] .lf__choice-mark::after { transform: rotate(45deg) scale(1); }

  /* ---- when: the fourteen days, then the one that is not a day ---- */
  .lf__hint { margin: -0.4rem 0 0.9rem; font-size: 0.82rem; line-height: 1.5; color: var(--text-on-ink-muted); }
  .lf__when { display: grid; gap: 0.6rem; }
  .lf__choice--wide { grid-column: 1 / -1; }

  /* ---- the last step: the answers, then the person ---- */
  .lf__summary {
    list-style: none;
    margin: 0 0 1.2rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .lf__summary:empty { display: none; }
  /* :global — the chips are created by script and carry no scoped attribute */
  .lf__summary :global(button) {
    font: inherit;
    font-size: 0.78rem;
    color: var(--text-on-ink-muted);
    background: var(--glass-tile);
    border: 1px solid var(--glass-line);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    cursor: pointer;
    transition: color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .lf__summary :global(button:hover), .lf__summary :global(button:focus-visible) { color: var(--gold); border-color: var(--gold); outline: none; }
  .lf__summary :global(button)::after { content: ' ✎'; opacity: 0.55; }

  /* :global — the day tiles are drawn by the script and carry no scoped attribute */
  .lf__days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0.4rem; }
  .lf__windows { margin-top: 0.4rem; }
  .lf__windows[hidden] { display: none; }
  .lf__windows.is-in { animation: lfWin var(--dur-fast) var(--ease-out-expo) both; }
  @keyframes lfWin { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .lf__windows-day { margin: 0.2rem 0 0.55rem; font-family: var(--font-display); font-size: 1.15rem; color: var(--text-on-ink); }
  .lf__windows-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.45rem; }
  .lf__windows-grid :global(.lf__window) {
    padding: 0.7rem 0.4rem; border-radius: 999px; border: 1px solid var(--glass-line); background: var(--glass-tile);
    color: var(--text-on-ink); font: inherit; font-size: 0.9rem; font-variant-numeric: tabular-nums; cursor: pointer;
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out-expo);
  }
  .lf__windows-grid :global(.lf__window:hover) { border-color: oklch(84% 0.11 78 / 0.5); background: var(--glass-tile-hover); transform: translateY(-1px); }
  .lf__windows-grid :global(.lf__window:focus-visible) { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px oklch(75% 0.12 75 / 0.28); }
  .lf__windows-grid :global(.lf__window[aria-checked='true']) { border-color: transparent; background: linear-gradient(to right, #f2c275, #daa24f); color: #14100d; font-weight: 700; }
  @media (max-width: 480px) { .lf__windows-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .lf__days :global(.lf__day) {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.05rem;
    padding: 0.55rem 0.15rem 0.65rem;
    border-radius: 12px;
    border: 1px solid var(--glass-line);
    background: var(--glass-tile);
    color: var(--text-on-ink);
    cursor: pointer;
    font: inherit;
    box-shadow: inset 0 1px 0 oklch(100% 0 0 / 0.08);
    transition: background var(--dur-fast) ease, border-color var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out-expo), box-shadow var(--dur-fast) ease;
    -webkit-tap-highlight-color: transparent;
  }
  .lf__days :global(.lf__day:hover) { background: var(--glass-tile-hover); border-color: oklch(84% 0.11 78 / 0.5); transform: translateY(-1px); }
  .lf__days :global(.lf__day:focus-visible) { outline: none; border-color: var(--gold); box-shadow: 0 0 0 3px oklch(75% 0.12 75 / 0.28), inset 0 1px 0 oklch(100% 0 0 / 0.08); }
  .lf__days :global(.lf__day-wd) { font-size: 0.58rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-on-ink-muted); transition: color var(--dur-fast) ease; }
  .lf__days :global(.lf__day-n) { font-family: var(--font-display); font-size: 1.45rem; line-height: 1.05; }
  .lf__days :global(.lf__day-mo) { font-size: 0.64rem; color: var(--text-on-ink-faint); }
  .lf__days :global(.lf__day--we .lf__day-wd) { color: var(--gold-light); opacity: 0.85; }
  .lf__days :global(.lf__day[aria-checked='true']) {
    border-color: var(--gold);
    background: oklch(75% 0.12 75 / 0.14);
    box-shadow: 0 0 0 1px oklch(75% 0.12 75 / 0.35), 0 10px 30px -14px oklch(75% 0.12 75 / 0.7);
  }
  .lf__days :global(.lf__day[aria-checked='true'] .lf__day-wd) { color: var(--gold-light); }
  @media (max-width: 480px) {
    .lf__days { gap: 0.3rem; }
    .lf__days :global(.lf__day) { padding: 0.45rem 0.1rem 0.55rem; border-radius: 10px; }
    .lf__days :global(.lf__day-n) { font-size: 1.2rem; }
    .lf__days :global(.lf__day-wd) { font-size: 0.52rem; letter-spacing: 0.08em; }
  }

  .lf__fields { display: grid; gap: 1rem; }
  @media (min-width: 640px) {
    .lf__fields { grid-template-columns: 1fr 1fr; }
    .lf__field--wide { grid-column: 1 / -1; }
  }
  /* align-content: start — a help or error line under one field must not
     stretch the input beside it (the phone/email row did exactly that). */
  .lf__field { display: grid; gap: 0.45rem; align-content: start; }
  .lf__optional { font-weight: 500; letter-spacing: 0.04em; text-transform: none; color: var(--text-on-ink-faint); margin-left: 0.4em; }
  .lf__label { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-on-ink-muted); }
  .lf__input {
    width: 100%;
    padding: 0.95rem 1.05rem;
    border-radius: 12px;
    border: 1px solid var(--glass-line);
    background: var(--glass-tile);
    color: var(--text-on-ink);
    font-size: var(--step-0);
    box-shadow: inset 0 1px 0 oklch(100% 0 0 / 0.06);
    transition: border-color var(--dur-fast) ease, background var(--dur-fast) ease, box-shadow var(--dur-fast) ease;
  }
  .lf__input::placeholder { color: var(--text-on-ink-faint); }
  .lf__input:focus { outline: none; border-color: var(--gold); background: oklch(100% 0 0 / 0.09); box-shadow: 0 0 0 3px oklch(75% 0.12 75 / 0.22); }
  .lf__help { margin: 0; font-size: 0.76rem; color: var(--text-on-ink-faint); line-height: 1.5; }
  .lf__error { margin: 0; font-size: 0.78rem; font-weight: 600; color: oklch(78% 0.14 30); }
  .lf__error[hidden] { display: none; }

  .lf__consent {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    margin-top: 1.2rem;
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--text-on-ink-muted);
    cursor: pointer;
  }
  .lf__consent input { margin-top: 0.2rem; accent-color: var(--gold); flex-shrink: 0; }
  .lf__consent a { color: var(--gold); text-decoration: underline; text-underline-offset: 2px; }

  .lf__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    width: 100%;
    margin-top: 1.3rem;
    padding: 1.05rem 1.4rem;
    border-radius: 14px;
    border: 1px solid oklch(87% 0.11 80 / 0.9);
    background: linear-gradient(112deg, oklch(69% 0.135 66) 0%, var(--gold) 48%, oklch(83% 0.12 80) 100%);
    color: var(--ink-900);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.86rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: inset 0 1px 0 oklch(100% 0 0 / 0.5), 0 14px 34px -14px oklch(64% 0.13 68 / 0.9);
    transition: filter var(--dur-fast) ease, transform var(--dur-fast) var(--ease-out-expo);
  }
  .lf__submit:hover { filter: brightness(1.05); transform: translateY(-1px); }
  .lf__submit:focus-visible { outline: none; box-shadow: 0 0 0 3px oklch(75% 0.12 75 / 0.35); }
  .lf__submit[aria-busy='true'] { opacity: 0.7; pointer-events: none; }

  .lf__pot { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .lf__formerror {
    margin-top: 1rem;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    background: oklch(52% 0.19 27 / 0.14);
    border: 1px solid oklch(62% 0.17 27 / 0.5);
    font-size: var(--step--1);
    color: var(--text-on-ink);
  }
  .lf__formerror a { color: var(--gold); }
  .lf__formerror[hidden] { display: none; }

  /* ---- success ---- */
  .lf__success { text-align: center; padding: clamp(1rem, 3vw, 2rem) 0; }
  .lf__success[hidden] { display: none; }
  .lf__success-mark { display: block; font-family: var(--font-jp); font-size: 4.5rem; line-height: 1; color: var(--gold); opacity: 0.55; margin-bottom: 1.1rem; }
  .lf__success h3 { font-family: var(--font-display); font-size: var(--step-3); font-weight: 300; margin-bottom: 0.7rem; color: var(--text-on-ink); }
  .lf__success p { color: var(--text-on-ink-muted); max-width: 40ch; margin-inline: auto; line-height: 1.7; }
  .lf__wa {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 1.4rem;
    padding: 0.7rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--glass-line);
    background: var(--glass-tile);
    color: var(--text-on-ink);
    text-decoration: none;
    font-size: 0.86rem;
    transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }
  .lf__wa:hover, .lf__wa:focus-visible { border-color: var(--gold); color: var(--gold); outline: none; }

  @media (prefers-reduced-motion: reduce) {
    .lf__step.is-entering { animation: none; }
    .lf__choice, .lf__back, .lf__submit { transition: none; }
  }
</style>

<script>
  import { track, eventId } from '../scripts/tracking';

  const ENDPOINT = import.meta.env.PUBLIC_FORM_ENDPOINT || '/api/lead';
  const ADVANCE_MS = 340;

  document.querySelectorAll<HTMLElement>('[data-lead-form]').forEach((root) => {
    const form = root.querySelector('form')!;
    const formId = root.dataset.leadForm!;
    const preset = root.dataset.preset || '';
    const success = root.querySelector<HTMLElement>('[data-success]')!;
    const formError = root.querySelector<HTMLElement>('[data-form-error]')!;
    const backBtn = root.querySelector<HTMLButtonElement>('[data-step-back]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const rail = Array.from(root.querySelectorAll<HTMLElement>('[data-rail]'));
    const summary = root.querySelector<HTMLElement>('[data-summary]')!;
    const submitBtn = root.querySelector<HTMLButtonElement>('[data-submit]')!;
    const consent = form.querySelector<HTMLInputElement>('[name="consent"]')!;
    const waLink = root.querySelector<HTMLAnchorElement>('[data-whatsapp-link]');

    const all = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
    const steps = preset ? all.filter((s) => s.dataset.step !== 'about') : all;
    const labels: Record<string, string> = { about: root.dataset.presetLabel || '' };

    let current = 0;
    let startedFired = false;
    let advancing = 0;

    const hidden = (name: string) => form.querySelector<HTMLInputElement>(`input[type="hidden"][name="${name}"]`)!;

    /* ---- the stage ---------------------------------------------------- */

    const showTopics = () => {
      const about = hidden('about').value || 'other';
      root.querySelectorAll<HTMLElement>('[data-topics]').forEach((g) => {
        g.hidden = g.dataset.topics !== about && !(g.dataset.topics === 'other' && !(about in topicKeys));
      });
    };
    const topicKeys: Record<string, true> = {};
    root.querySelectorAll<HTMLElement>('[data-topics]').forEach((g) => (topicKeys[g.dataset.topics!] = true));

    const paintSummary = () => {
      summary.innerHTML = '';
      steps.slice(0, -1).forEach((s, i) => {
        const name = s.dataset.step!;
        const label = labels[name];
        if (!label) return;
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = label;
        b.setAttribute('aria-label', `Change: ${label}`);
        b.addEventListener('click', () => goTo(i, true));
        const li = document.createElement('li');
        li.appendChild(b);
        summary.appendChild(li);
      });
    };

    const goTo = (index: number, backwards = false, focus = true) => {
      current = index;
      steps.forEach((s, i) => {
        s.hidden = i !== index;
        s.classList.remove('is-entering', 'is-backwards');
      });
      const step = steps[index];
      // restart the entrance
      void step.offsetWidth;
      step.classList.add('is-entering');
      if (backwards) step.classList.add('is-backwards');

      rail.forEach((r, i) => {
        r.classList.toggle('is-done', i < index);
        r.classList.toggle('is-active', i === index);
      });
      count.textContent = `${index + 1} of ${steps.length}`;
      backBtn.hidden = index === 0;

      if (step.dataset.step === 'topic') showTopics();
      if (step.dataset.step === 'contact') paintSummary();
      // Focus follows a step change, never the page load: a ring on the first
      // tile at rest reads as an answer already given.
      if (!focus) return;
      if (step.dataset.step === 'contact') {
        window.setTimeout(() => step.querySelector<HTMLElement>('input[name="name"]')?.focus({ preventScroll: true }), 80);
      } else {
        const checked = step.querySelector<HTMLElement>('[data-choice][aria-checked="true"]:not([hidden])');
        window.setTimeout(() => (checked ?? step.querySelector<HTMLElement>('[data-choice]'))?.focus({ preventScroll: true }), 80);
      }
    };

    /* ---- the days: the next fourteen, Sydney time, drawn now -----------
       Before the taps are wired below, so each day is a choice like any
       other: its value is the date (2026-10-01), its label the day
       ("Wed 1 Oct"), and both ride to GHL as timing / "when suits". */
    (() => {
      const host = root.querySelector<HTMLElement>('[data-days]');
      if (!host) return;
      const ahead = Number(host.dataset.daysAhead) || 14;
      const parts = new Intl.DateTimeFormat('en-AU', { timeZone: 'Australia/Sydney', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date());
      const get = (t: string) => Number(parts.find((p) => p.type === t)?.value ?? 0);
      const WD = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      const WD_LONG = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
      const MO = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
      const MO_LONG = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
      const pad = (n: number) => String(n).padStart(2, '0');
      for (let i = 1; i <= ahead; i++) {
        /* noon UTC on the calendar date: the same date in Sydney whatever DST does */
        const dt = new Date(Date.UTC(get('year'), get('month') - 1, get('day') + i, 12));
        const wd = dt.getUTCDay(), d = dt.getUTCDate(), m = dt.getUTCMonth();
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'lf__day' + (wd === 0 || wd === 6 ? ' lf__day--we' : '') + (i === 1 ? ' lf__day--first' : '');
        b.setAttribute('role', 'radio');
        b.setAttribute('aria-checked', 'false');
        b.setAttribute('aria-label', `${WD_LONG[wd]} ${d} ${MO_LONG[m]}${i === 1 ? ', tomorrow' : ''}`);
        b.dataset.day = `${dt.getUTCFullYear()}-${pad(m + 1)}-${pad(d)}`;
        b.dataset.label = `${WD[wd]} ${d} ${MO[m]}`;
        b.dataset.long = `${WD_LONG[wd]} ${d} ${MO_LONG[m]}`;
        b.innerHTML = `<span class="lf__day-wd">${WD[wd]}</span><span class="lf__day-n">${d}</span><span class="lf__day-mo">${MO[m]}</span>`;
        host.appendChild(b);
      }

      /* A day opens its windows: six two-hour blocks, 8 am to 8 pm. Each
         window is the answer (value "2026-10-02 08:00-10:00", label
         "Fri 2 Oct, 8-10 am") and moves the form on like any tap. */
      const wrap = root.querySelector<HTMLElement>('[data-windows]')!;
      const grid = root.querySelector<HTMLElement>('[data-windows-grid]')!;
      const dayLine = root.querySelector<HTMLElement>('[data-windows-day]')!;
      const STARTS = [8, 10, 12, 14, 16, 18];
      const h12 = (h: number) => ((h + 11) % 12) + 1;
      const mer = (h: number) => (h >= 12 ? 'pm' : 'am');
      const win = (h: number) => (mer(h) === mer(h + 2) ? `${h12(h)}–${h12(h + 2)} ${mer(h)}` : `${h12(h)} ${mer(h)}–${h12(h + 2)} ${mer(h + 2)}`);
      host.addEventListener('click', (e) => {
        const day = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-day]');
        if (!day) return;
        host.querySelectorAll('[data-day]').forEach((b) => b.setAttribute('aria-checked', String(b === day)));
        root.querySelectorAll('[data-choice="timing"]').forEach((b) => b.setAttribute('aria-checked', 'false'));
        dayLine.textContent = day.dataset.long || '';
        grid.innerHTML = '';
        for (const h of STARTS) {
          const w = document.createElement('button');
          w.type = 'button';
          w.className = 'lf__window';
          w.setAttribute('role', 'radio');
          w.setAttribute('aria-checked', 'false');
          w.dataset.choice = 'timing';
          w.dataset.value = `${day.dataset.day} ${pad(h)}:00-${pad(h + 2)}:00`;
          w.dataset.label = `${day.dataset.label}, ${win(h)}`;
          w.textContent = win(h);
          grid.appendChild(w);
        }
        wrap.hidden = false;
        wrap.classList.remove('is-in'); void wrap.offsetWidth; wrap.classList.add('is-in');
        grid.querySelector<HTMLElement>('button')?.focus({ preventScroll: true });
      });
    })();

    /* ---- a tap answers, and moves on ---------------------------------- */

    root.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-choice]');
      if (!btn || !root.contains(btn)) return;
      {
        const name = btn.dataset.choice!;
        const group = btn.closest<HTMLElement>('.lf__choices')!;
        group.querySelectorAll<HTMLElement>('[data-choice]').forEach((b) => b.setAttribute('aria-checked', String(b === btn)));
        hidden(name).value = btn.dataset.value || '';
        hidden(`${name}_label`).value = btn.dataset.label || '';
        labels[name] = btn.dataset.label || '';

        // A new "about" makes the topic question a different question.
        if (name === 'about') {
          hidden('topic').value = '';
          hidden('topic_label').value = '';
          labels.topic = '';
          root.querySelectorAll<HTMLElement>('[data-topics] [data-choice]').forEach((b) => b.setAttribute('aria-checked', 'false'));
        }

        if (!startedFired) {
          startedFired = true;
          track('form_start', { form_id: formId, page_path: location.pathname });
        }
        track('form_step', { form_id: formId, step: current + 1, question: name, answer: btn.dataset.value, page_path: location.pathname });

        /* "flexible" clears a day that was picked */
        if (name === 'timing' && btn.dataset.value === 'flexible') {
          root.querySelectorAll('[data-day]').forEach((b) => b.setAttribute('aria-checked', 'false'));
          const w = root.querySelector<HTMLElement>('[data-windows]');
          if (w) w.hidden = true;
        }

        window.clearTimeout(advancing);
        advancing = window.setTimeout(() => {
          if (current < steps.length - 1) goTo(current + 1);
        }, ADVANCE_MS);
      }
    });

    backBtn.addEventListener('click', () => {
      window.clearTimeout(advancing);
      goTo(Math.max(current - 1, 0), true);
    });

    form.addEventListener(
      'input',
      () => {
        if (startedFired) return;
        startedFired = true;
        track('form_start', { form_id: formId, page_path: location.pathname });
      },
      { once: true }
    );

    /* ---- validation --------------------------------------------------- */

    const showError = (name: string, message: string) => {
      const slot = root.querySelector<HTMLElement>(`[data-error-for="${name}"]`);
      if (slot) {
        slot.textContent = message;
        slot.hidden = false;
      }
    };
    const clearErrors = () => {
      root.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
        el.hidden = true;
        el.textContent = '';
      });
    };
    const validate = (): boolean => {
      clearErrors();
      let ok = true;
      let first: HTMLInputElement | null = null;
      form.querySelectorAll<HTMLInputElement>('.lf__input[required]').forEach((el) => {
        let msg = '';
        if (!el.value.trim()) msg = 'This one is needed.';
        else if (el.type === 'email' && !/^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(el.value)) msg = 'That email address does not look right.';
        else if (el.type === 'tel' && el.value.replace(/\D/g, '').length < 8) msg = 'Please include a full phone number.';
        if (msg) {
          showError(el.name, msg);
          ok = false;
          first ??= el;
        }
      });
      /* email is optional (Dion, 27 Sep 2026) — but if it is there, it has to be one */
      const email = form.querySelector<HTMLInputElement>('.lf__input[type="email"]');
      if (email && email.value.trim() && !/^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(email.value)) {
        showError(email.name, 'That email address does not look right.');
        ok = false;
        first ??= email;
      }
      first?.focus();
      return ok;
    };

    /* ---- send --------------------------------------------------------- */

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      formError.hidden = true;

      if (steps[current].dataset.step !== 'contact') {
        goTo(steps.length - 1);
        return;
      }
      if (!validate()) return;
      if (!consent.checked) {
        formError.textContent = 'Please tick the consent box so I can reply.';
        formError.hidden = false;
        return;
      }

      const data = new FormData(form);
      if ((data.get('website') as string)?.trim()) {
        form.hidden = true;
        success.hidden = false;
        return;
      }

      const payload: Record<string, unknown> = {};
      data.forEach((value, key) => {
        if (key !== 'website') payload[key] = value;
      });

      const id = eventId();
      const eventName = root.dataset.event || 'lead';
      const value = root.dataset.eventValue ? Number(root.dataset.eventValue) : undefined;
      payload.form_id = formId;
      payload.event_id = id;
      payload.event_name = eventName;
      if (value) payload.value = value;
      payload.page_path = location.pathname;
      payload.page_url = location.href;
      payload.referrer = document.referrer || undefined;
      /* The "Who This Is For" set the visitor saw on the hero's pause, and the
         protector card they tapped, if any — set by FrameHero, carried here
         from whichever page they came through (src/data/badges.ts). */
      try {
        payload.fy = sessionStorage.getItem('rts-fy') || undefined;
        payload.fy_pick = sessionStorage.getItem('rts-fy-pick') || undefined;
      } catch {}
      payload.fbc = document.cookie.match(/_fbc=([^;]+)/)?.[1];
      payload.fbp = document.cookie.match(/_fbp=([^;]+)/)?.[1];

      // The answers, written for WhatsApp as well, so the direct route
      // carries the same context if they choose it.
      if (waLink) {
        const lines = [
          `Hi Harrison, I'd like to talk about ${labels.about || 'working with you'}.`,
          labels.topic ? `Specifically: ${labels.topic.toLowerCase()}.` : '',
          labels.timing ? `${labels.timing} suit me best.` : '',
          `— ${String(payload.name || '')}`,
        ].filter(Boolean);
        waLink.href = `https://wa.me/${root.dataset.whatsapp}?text=${encodeURIComponent(lines.join('\n'))}`;
      }

      submitBtn.setAttribute('aria-busy', 'true');
      submitBtn.firstElementChild!.textContent = 'Sending…';

      try {
        const res = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        track(eventName, { event_id: id, form_id: formId, value, currency: value ? 'AUD' : undefined, page_path: location.pathname });
        form.hidden = true;
        success.hidden = false;
        success.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (err) {
        formError.innerHTML =
          'Something went wrong sending that. Please email ' +
          '<a href="mailto:harrison.saito3011@gmail.com">harrison.saito3011@gmail.com</a> ' +
          'or message +61 424 657 548 and I will pick it up.';
        formError.hidden = false;
        track('form_error', { form_id: formId, message: String(err) });
      } finally {
        submitBtn.removeAttribute('aria-busy');
        submitBtn.firstElementChild!.textContent = submitBtn.dataset.label || 'Send';
      }
    });

    submitBtn.dataset.label = submitBtn.firstElementChild?.textContent?.trim() || 'Send';

    // Open on the first question, or on the second where the page has answered the first.
    goTo(0, false, false);
    if (preset) showTopics();
  });
</script>
