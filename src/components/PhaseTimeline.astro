---
/**
 * 守破離 — the Return to Self arc.
 *
 * Harrison's three phases (Separate / Return / Integrate) map almost exactly
 * onto shu-ha-ri, the classical budo model of learning: hold the form, break
 * the form, transcend the form. Since he is a 2nd Dan teaching from inside that
 * tradition, the mapping is the structure rather than an ornament laid over it.
 *
 * On desktop the section pins and the three phases travel horizontally, so the
 * reader physically moves through the twelve weeks. Below 900px it degrades to
 * a plain vertical stack — no pinning, no horizontal scroll, no trapped users.
 */
import { PHASES, RETURN_LOOP } from '../data/site';
import Picture from './Picture.astro';
import Enso from './Enso.astro';
---

<div class="phases" data-enso-scope>
  <div class="phases__viewport">
    {/* The circle closes as the twelfth week arrives. It lives inside the
        pinned element so it stays on screen behind the panels, rather than
        being stranded in the pin spacer. */}
    <div class="phases__enso" aria-hidden="true">
      <Enso opacity={0.5} strokeWidth={5} />
    </div>

    <div class="phases__track" data-phase-track>
      {
        PHASES.map((phase, i) => (
          <article class="phase" data-phase-panel data-reveal>
            <span class="phase__glyph" data-phase-glyph aria-hidden="true">
              {phase.kanji}
            </span>

            <div class="phase__body">
              <div class="phase__head">
                <span class="phase__num">{phase.number}</span>
                <span class="phase__weeks">{phase.weeks}</span>
              </div>

              <h3 class="phase__name">{phase.name}</h3>

              <p class="phase__romaji">
                <span lang="ja">{phase.kanji}</span>
                <em>{phase.romaji}</em>
                <span class="phase__meaning">— {phase.kanjiMeaning}</span>
              </p>

              <p class="phase__aim">{phase.aim}</p>
              <p class="phase__blurb">{phase.blurb}</p>

              <p class="phase__trust">{phase.selfTrust}</p>

              <ul class="phase__weeks-list">
                {phase.weekList.map((w) => (
                  <li>{w}</li>
                ))}
              </ul>
            </div>

            <div class="phase__media">
              <Picture
                slug={phase.image}
                alt={phase.imageAlt}
                sizes="(max-width: 900px) 100vw, 34vw"
                parallax={i === 1 ? 8 : 10}
              />
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="phases__loop">
    <p class="phases__loop-label">Each phase uses the same Return Loop</p>
    <ol class="phases__loop-list">
      {RETURN_LOOP.map((step) => <li>{step}</li>)}
    </ol>
  </div>
</div>

<style>
  .phases { position: relative; }

  .phases__viewport { position: relative; }

  .phases__track {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .phase {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding: clamp(1.75rem, 4vw, 3rem);
    background: oklch(21% 0.01 55 / 0.55);
    border: 1px solid oklch(100% 0 0 / 0.09);
    border-top: 2px solid oklch(75% 0.12 75 / 0.5);
    overflow: hidden;
    isolation: isolate;
  }

  .phase__glyph {
    position: absolute;
    z-index: 0;
    inset-block-start: -0.18em;
    inset-inline-end: -0.06em;
    font-family: var(--font-jp);
    font-size: clamp(11rem, 26vw, 22rem);
    line-height: 1;
    color: var(--gold);
    opacity: 0.07;
    pointer-events: none;
    user-select: none;
  }

  .phase__body { position: relative; z-index: 1; }

  .phase__head {
    display: flex;
    align-items: baseline;
    gap: 1.15rem;
    margin-bottom: 0.85rem;
  }

  .phase__num {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 300;
    line-height: 1;
    color: oklch(75% 0.12 75 / 0.6);
  }

  .phase__weeks {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--gold);
  }

  .phase__name {
    font-size: var(--step-3);
    font-weight: 300;
    line-height: 1.1;
    color: var(--text-on-ink);
    margin-bottom: 0.6rem;
  }

  .phase__romaji {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem;
    font-size: var(--step--1);
    color: var(--text-on-ink-faint);
    padding-bottom: 1.15rem;
    margin-bottom: 1.15rem;
    border-bottom: 1px solid oklch(100% 0 0 / 0.1);
  }
  .phase__romaji [lang='ja'] { font-family: var(--font-jp); font-size: 1.15rem; color: var(--gold); }
  .phase__romaji em { font-style: italic; color: var(--text-on-ink-muted); letter-spacing: 0.06em; }
  .phase__meaning { opacity: 0.75; }

  .phase__aim {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-style: italic;
    font-weight: 300;
    line-height: 1.4;
    color: var(--gold-light);
    margin-bottom: 1rem;
  }

  .phase__blurb {
    font-size: var(--step-0);
    line-height: 1.7;
    color: var(--text-on-ink-muted);
    margin-bottom: 1.15rem;
  }

  .phase__trust {
    font-size: var(--step--1);
    line-height: 1.7;
    color: var(--text-on-ink-faint);
    padding-left: 1.15rem;
    border-left: 1px solid oklch(75% 0.12 75 / 0.35);
  }

  .phase__weeks-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
  }

  .phase__weeks-list li {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-on-ink-faint);
    border: 1px solid oklch(100% 0 0 / 0.14);
    padding: 0.4rem 0.7rem;
  }

  .phase__media {
    position: relative;
    z-index: 1;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }
  .phase__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.04);
  }

  /* ---- the ensō ---- */
  .phases__enso {
    position: absolute;
    z-index: 0;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    transform: translate(-50%, -50%);
    width: clamp(18rem, 40vw, 34rem);
    pointer-events: none;
    opacity: 0.55;
  }

  .phases__track { position: relative; z-index: 1; }

  /* ---- return loop ---- */
  .phases__loop {
    position: relative;
    z-index: 1;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }

  .phases__loop-label {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1.25rem;
  }

  .phases__loop-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem clamp(0.75rem, 2vw, 1.75rem);
    list-style: none;
    padding: 0;
    counter-reset: loop;
  }

  .phases__loop-list li {
    position: relative;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 300;
    color: var(--text-on-ink-muted);
  }

  /* Arrow between steps — the loop reads as a cycle, not a checklist. */
  .phases__loop-list li:not(:last-child)::after {
    content: '→';
    margin-left: clamp(0.75rem, 2vw, 1.75rem);
    color: oklch(75% 0.12 75 / 0.5);
    font-size: 0.85em;
  }

  @media (min-width: 700px) {
    .phase { grid-template-columns: 1.5fr 1fr; align-items: start; }
    .phase__media { aspect-ratio: 3 / 4; }
  }

  /* ---- pinned horizontal mode ---- */
  @media (min-width: 901px) {
    /* The viewport is what ScrollTrigger pins, so it has to be a full screen
       tall and centre its own contents — otherwise the panels sit at the top
       and leave half a viewport of dead space for the whole pinned scroll. */
    .phases__viewport {
      overflow: hidden;
      min-height: 100svh;
      display: flex;
      align-items: center;
    }

    .phases__track {
      display: flex;
      align-items: center;
      gap: 0;
      width: max-content;
    }

    .phase {
      width: min(74vw, 60rem);
      flex-shrink: 0;
      margin-right: clamp(1.5rem, 3vw, 3rem);
    }
  }
</style>
