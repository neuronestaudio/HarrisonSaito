<script>
  (function () {
    var hero = document.querySelector<HTMLElement>('[data-frame-hero]');
    var video = hero && hero.querySelector<HTMLVideoElement>('.hero__film');
    var beatEl = hero && hero.querySelector<HTMLElement>('[data-beat]');
    var figure = hero && hero.querySelector<HTMLImageElement>('.arrive__photo');
    var panel = beatEl && beatEl.querySelector<HTMLElement>('.beat__panel');
    if (!hero || !video || !beatEl || !panel) return;
    /* The badge set this page shows: remembered for the lead form (it tags the
       enquiry fy-<id>), and reported once so sets can be compared. A protector
       tap is remembered too (fy-pick-<name>). */
    var fy = hero.dataset.fy || '';
    (window as any).dataLayer = (window as any).dataLayer || [];
    (window as any).dataLayer.push({ event: 'fy_view', fy_set: fy, page_path: location.pathname });
    /* The cards: tap what is true (any number; the protectors set takes one).
       The picks ride to the lead form, and the first one opens the gate. */
    var pickBtns = [].slice.call(hero.querySelectorAll('[data-pick]')) as HTMLButtonElement[];
    var pickOne = !!hero.querySelector('[data-picks="one"]');
    var onPick = function () {};
    function picked() { return pickBtns.filter(function (b) { return b.getAttribute('aria-pressed') === 'true'; }); }
    try {
      var had = (sessionStorage.getItem('rts-fy') === fy && sessionStorage.getItem('rts-fy-pick')) || '';
      if (had) had.split(',').forEach(function (k) { pickBtns.forEach(function (b) { if (b.dataset.pick === k) b.setAttribute('aria-pressed', 'true'); }); });
    } catch (e) {}
    pickBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (pickOne) pickBtns.forEach(function (b) { b.setAttribute('aria-pressed', b === btn ? 'true' : 'false'); });
        else btn.setAttribute('aria-pressed', btn.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        try { sessionStorage.setItem('rts-fy-pick', picked().map(function (b) { return b.dataset.pick; }).join(',')); } catch (e) {}
        onPick();
      });
    });
    try { if (fy) sessionStorage.setItem('rts-fy', fy); } catch (e) {}

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    /* The walk ends on the alcove: 15.0 s of a 19.33 s film. The still is that
       frame, so it dissolves in by film time — over the last quarter second,
       once the video shows the same picture — never by scroll alone, which
       would lay it over a frame the camera has not reached. */
    var T_END = 15.0, HOLD_FROM_T = 14.78;
    /* The beat: frame 252, the four-door room with every door shut — the
       frame RtsHero's door was held on. */
    var T_GATE = (252 + 0.5) / 30;
    var BEAT_AT = 0.3;     /* of the pause: where a caught scroll lands, panel fully up */
    var EDGE = 0.16;       /* of the pause: the panel fades in and out over this much */
    var MEET_EDGE = 0.8;   /* of the arrival: how much of it the hero takes to build —
                              the rest (~35vh) is a short hold before the page moves on */
    /* The doorway: the doors have slid open and the camera is passing
       through. The arrival starts here, not at the alcove. */
    var T_DOOR = 10.8;
    /* The way in: the room starts closing in as the doors open. */
    var V_FROM = 9.2;
    function smooth(x: number) { x = clamp(x, 0, 1); return x * x * (3 - 2 * x); }
    /* A caught scroll is held at least LOCK_MS, then until the input has been
       quiet for QUIET_MS — a trackpad's inertia keeps sending wheel events
       after the hand has gone — but never longer than MAX_LOCK_MS. */
    var LOCK_MS = 900, QUIET_MS = 260, MAX_LOCK_MS = 2500;
    var st = hero.style;
    var filmOn = false, failed = false;
    var cards = [].slice.call(beatEl.querySelectorAll('.beat__card')) as HTMLElement[];

    function clamp(v: number, a: number, b: number) { return v < a ? a : v > b ? b : v; }
    function runway() { return hero!.offsetHeight - window.innerHeight; }
    function heroTop() { return hero!.getBoundingClientRect().top + window.scrollY; }
    function progress() {
      var run = runway();
      return run > 0 ? clamp(-hero!.getBoundingClientRect().top / run, 0, 1) : 0;
    }
    function yAt(p: number) { return heroTop() + p * runway(); }
    function lenisOf(): any { return (window as any).lenis || null; }
    function snapTo(y: number) {
      var l = lenisOf();
      if (l && typeof l.scrollTo === 'function') l.scrollTo(y, { immediate: true, force: true });
      else window.scrollTo({ top: y, behavior: 'instant' as ScrollBehavior });
    }

    /* ---- the runway: three lengths read back from the CSS ---- */
    var pA = 0.34, pB = 0.57, pC = 0.79, pD = 0.66;
    function measure() {
      var cs = getComputedStyle(hero!);
      var a = parseFloat(cs.getPropertyValue('--run-in')) || 180;
      var h = parseFloat(cs.getPropertyValue('--run-pause')) || 120;
      var b = parseFloat(cs.getPropertyValue('--run-out')) || 140;
      var m = parseFloat(cs.getPropertyValue('--run-meet')) || 110;
      var total = a + h + b + m;
      pA = a / total;
      pB = (a + h) / total;
      pC = (a + h + b) / total;
      pD = pB + ((T_DOOR - T_GATE) / (T_END - T_GATE)) * (pC - pB);
      st.setProperty('--pa', pA.toFixed(4));   /* the hallway's chips time themselves off it */
      fit();
      placeFlame();
    }
    function timeFor(p: number) {
      if (p <= pA) return (p / pA) * T_GATE;
      if (p <= pB) return T_GATE;
      if (p <= pC) return T_GATE + ((p - pB) / (pC - pB)) * (T_END - T_GATE);
      return T_END;
    }
    /* The meeting: 0 until the walk has arrived, then Harrison comes in over
       the first stretch of it and stays for the rest. */
    function meetFor(p: number) {
      if (p <= pD) return 0;
      return clamp((p - pD) / ((1 - pD) * MEET_EDGE), 0, 1);
    }
    function beatFor(p: number) {
      if (p <= pA || p >= pB) return 0;
      var e = (pB - pA) * EDGE;
      return Math.min(clamp((p - pA) / e, 0, 1), clamp((pB - p) / e, 0, 1));
    }

    /* ---- the flame's box: exactly over the photograph's own picture ----
       The <img> is laid out one way on a desktop (natural ratio, 118% tall)
       and another on a phone (the whole frame, object-fit: cover, 50% 30%),
       so the picture's rectangle inside the element is worked out the way the
       browser works it out, from the layout box and object-position. Layout
       numbers only (offset*), never the transformed rect: the flame box
       carries the same scale as the photograph in CSS. */
    var flameSize = 60;
    function placeFlame() {
      if (!figure) return;
      var W = figure.offsetWidth, H = figure.offsetHeight;
      if (!W || !H) return;
      var cs = getComputedStyle(figure);
      var pos = (cs.objectPosition || '50% 50%').split(' ');
      var px = parseFloat(pos[0]) / 100, py = parseFloat(pos[1] || pos[0]) / 100;
      if (isNaN(px)) px = 0.5; if (isNaN(py)) py = 0.5;
      var k = Math.max(W / 1152, H / 2048);
      var w = 1152 * k, h = 2048 * k;
      /* on a desktop the element is shifted by translateX(-50%); offsetLeft is before that */
      var shift = cs.transform && cs.transform !== 'none' && window.matchMedia('(min-width: 761px) and (min-aspect-ratio: 4/5)').matches ? -W / 2 : 0;
      st.setProperty('--fb-x', (figure.offsetLeft + shift + (W - w) * px).toFixed(1) + 'px');
      st.setProperty('--fb-y', (figure.offsetTop + (H - h) * py).toFixed(1) + 'px');
      st.setProperty('--fb-w', w.toFixed(1) + 'px');
      st.setProperty('--fb-h', h.toFixed(1) + 'px');
      flameSize = 112 * k;                       /* the flare is ~112px wide in the 1152px picture */
      st.setProperty('--fl-size', flameSize.toFixed(1) + 'px');
    }

    /* ---- the panel: fitted between the nav and the consent bar ---- */
    function fit() {
      var nav = document.querySelector<HTMLElement>('[data-nav]');
      var top = (nav ? nav.offsetHeight : 72) + 8;
      var consent = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--consent-h')) || 0;
      var avail = window.innerHeight - top - consent - 28;
      var h = panel!.offsetHeight;   /* layout height — the scale does not change it */
      st.setProperty('--beat-top', top + 'px');
      st.setProperty('--beat-fit', (h > 0 ? clamp(avail / h, 0.5, 1) : 1).toFixed(3));
    }

    /* ---- paint: everything the page shows is a function of p ---- */
    var target = 0, eased = 0, beatOn = false, cardsIn = false, meetOn = false;
    var away = false;
    function paint(p: number) {
      st.setProperty('--p', p.toFixed(4));
      if ((p > 0.13) !== away) { away = !away; hero!.classList.toggle('hero--away', away); }
      if (filmOn) {
        var still = clamp((eased - HOLD_FROM_T) / (T_END - HOLD_FROM_T), 0, 1);
        st.setProperty('--hold', still.toFixed(3));
        st.setProperty('--push', '0');
        /* No end-of-film dim any more: --vig has been darkening the room since
           V_FROM, and a second, sudden one here was the step. */
        st.setProperty('--veil', '0');
      } else if (failed) {
        /* No film at all: the still is the hero and pushes in. */
        st.setProperty('--hold', '1');
        st.setProperty('--push', p.toFixed(4));
        st.setProperty('--veil', p.toFixed(4));
      } else {
        /* The film is not ready yet: the first frame holds, still. (It used
           to show the alcove here and then cut to the first room when the
           film armed — on a phone that read as a video playing.) */
        st.setProperty('--hold', '0');
        st.setProperty('--push', '0');
        st.setProperty('--veil', '0');
      }
      var m = meetFor(p);
      st.setProperty('--meet', m.toFixed(3));
      /* The title card: up as soon as the pause is behind him, gone as the
         arrival starts to build. */
      st.setProperty('--go', (smooth((p - pB) / 0.012) * (1 - smooth((p - (pD - 0.012)) / 0.03))).toFixed(3));
      /* How far through the doorway stretch he is, 0 → 1: the wordmark's fill
         line. A pure function of the scroll, so it reverses exactly. */
      st.setProperty('--gofill', clamp((p - pB) / Math.max(0.0001, pD - pB), 0, 1).toFixed(4));
      /* The flame, keyed to the scroll (not the clock): three sines of the
         scroll position at unrelated periods, so it never repeats on screen. */
      if (m > 0.01) {
        var sy = window.scrollY;
        var f1 = Math.sin(sy * 0.021), f2 = Math.sin(sy * 0.047 + 1.3), f3 = Math.sin(sy * 0.113 + 0.7);
        st.setProperty('--fl-i', (0.84 + 0.1 * f1 + 0.08 * f2 * f3).toFixed(3));
        st.setProperty('--fl-x', ((f2 * 0.6 + f3 * 0.4) * flameSize * 0.09).toFixed(2));
        st.setProperty('--fl-y', (-Math.abs(f1) * flameSize * 0.07).toFixed(2));
        st.setProperty('--fl-kx', (1 + 0.1 * f3).toFixed(3));
        st.setProperty('--fl-ky', (1 + 0.16 * f2).toFixed(3));
      }
      /* Half the vignette as the doors open (by where the scroll is, so it
         holds steady while the film eases), the rest as the letters come up —
         dark by the time the photograph rises. */
      var vig = 0.5 * smooth((timeFor(p) - V_FROM) / (T_DOOR - V_FROM)) + 0.5 * smooth(m / 0.3);
      st.setProperty('--vig', vig.toFixed(3));
      st.setProperty('--mp', (p <= pD ? 0 : clamp((p - pD) / (1 - pD), 0, 1)).toFixed(4));
      var meeting = m > 0.02;
      if (meeting !== meetOn) {
        meetOn = meeting;
        hero!.classList.toggle('hero--meet', meeting);
      }
      var b = beatFor(p);
      st.setProperty('--beat', b.toFixed(3));
      var on = b > 0.02;
      if (on !== beatOn) {
        beatOn = on;
        hero!.classList.toggle('hero--beat', on);
        beatEl!.setAttribute('aria-hidden', on ? 'false' : 'true');
        if (on) fit();
      }
      /* The cards draw their marks in once, the first time the panel is up. */
      if (b > 0.4 && !cardsIn) {
        cardsIn = true;
        cards.forEach(function (c) { c.classList.add('is-in'); });
      }
    }

    /* ---- the gate (Dion, 18 Sep): the walk does not pass the doors until a
       card is tapped. The catch below lands the scroll on the panel as
       before; what changes is that the hold no longer times out — it ends
       when a card is chosen (remembered for the session, so coming back to
       the page is not a second toll). Up is always free, and so is any way
       on that is plainly deliberate: a link to a section further down, focus
       moving past the hero by keyboard, or a page that opens already below
       the doors. A scroll that meets the gate nudges the instruction. ---- */
    /* 19 Sep, stricter (Dion: "they can't proceed unless they click a button…
       scrolls back and forth"): a pick no longer frees the scroll. It turns
       the instruction into the button — "Learn more" — and the button is the
       only way on. `gateOpen` is one pass through the doors: it is set by the
       button (or by one of the deliberate ways round listed above) and is
       taken back the moment the page is above the panel again, so walking
       back up and down meets the gate every time. The picks are remembered,
       so the button is ready when he returns. `rts-gate=1` in sessionStorage
       holds the gate open for the whole visit — nothing on the site sets it;
       it is there for tests that need to scroll straight through. */
    var gateOpen = false, gateFree = false, canGo = false, reported = false, bootUntil = performance.now() + 900, nudgeAt = 0;
    var onBtn = beatEl.querySelector<HTMLButtonElement>('[data-beat-on]')!;
    try { gateFree = gateOpen = sessionStorage.getItem('rts-gate') === '1'; } catch (e) {}
    function showGate() {
      canGo = picked().length > 0;
      onBtn.textContent = (canGo ? onBtn.dataset.open : onBtn.dataset.closed) || '';
      if (canGo) onBtn.removeAttribute('aria-disabled'); else onBtn.setAttribute('aria-disabled', 'true');
    }
    function openGate(how: string) {
      if (gateOpen) return;
      gateOpen = true;
      if (!reported) {
        reported = true;
        (window as any).dataLayer.push({ event: 'fy_gate_open', fy_set: fy, fy_how: how, fy_picks: picked().length });
      }
      unlock();
    }
    function nudge() {
      var now = performance.now();
      if (now - nudgeAt < 900) return;
      nudgeAt = now;
      panel!.classList.remove('is-nudge');
      void panel!.offsetWidth;
      panel!.classList.add('is-nudge');
    }
    onPick = function () {
      var was = canGo;
      showGate();
      if (canGo && !was) { panel!.classList.remove('is-open'); void panel!.offsetWidth; panel!.classList.add('is-open'); }
    };
    showGate();
    document.addEventListener('click', function (e) {
      var a = (e.target as HTMLElement).closest && (e.target as HTMLElement).closest('a[href*="#"]');
      if (a && !a.hasAttribute('data-beat-go')) openGate('anchor');
    }, true);
    document.addEventListener('focusin', function (e) {
      var el = e.target as Node;
      if (!hero!.contains(el) && (hero!.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING)) openGate('focus');
    });

    /* ---- the catch: a scroll arriving from above stops on the panel ---- */
    var armed = true, prevP = 0, quietUntil = performance.now() + 700;
    var locked = false, lockTimer = 0, lockY = 0, touchY = -1, lockedAt = 0, lastInput = 0;
    var CAPTURE: AddEventListenerOptions = { passive: false, capture: true };
    var LISTEN: AddEventListenerOptions = { passive: true, capture: true };
    var DOWN_KEYS: Record<string, number> = { ' ': 1, PageDown: 1, ArrowDown: 1, End: 1 };

    /* Capture phase, so Lenis (bubble phase, on window) never sees a blocked
       wheel. Only downward movement is held — up is always free. */
    function hold(e: Event) {
      if (e.type === 'wheel') {
        var we = e as WheelEvent;
        if (we.deltaY < 0) { unlock(); return; }
      } else if (e.type === 'touchmove') {
        var t = (e as TouchEvent).touches[0];
        if (t && touchY >= 0 && t.clientY > touchY + 8) { unlock(); return; }   /* finger down = page up */
      }
      lastInput = performance.now();
      if (!gateOpen) nudge();
      /* A touch scroll already under way cannot be cancelled (the browser
         says so in the console); the pin in watch() holds the page instead. */
      if (e.cancelable) e.preventDefault();
      e.stopImmediatePropagation();
    }
    function onTouchStart(e: TouchEvent) { touchY = e.touches[0] ? e.touches[0].clientY : -1; }
    function onKey(e: KeyboardEvent) {
      var el = e.target as HTMLElement | null;
      if (e.key === ' ' && el && el.closest('a,button,input,textarea,select')) return;
      if (DOWN_KEYS[e.key]) { lastInput = performance.now(); e.preventDefault(); if (!gateOpen) nudge(); }
    }
    function lock(y: number) {
      lockY = y;
      if (!locked) {
        locked = true;
        window.addEventListener('wheel', hold, CAPTURE);
        window.addEventListener('touchmove', hold, CAPTURE);
        window.addEventListener('touchstart', onTouchStart, LISTEN);
        window.addEventListener('keydown', onKey, true);
      }
      lockedAt = lastInput = performance.now();
      clearTimeout(lockTimer);
      lockTimer = window.setTimeout(release, LOCK_MS);
    }
    function release() {
      var now = performance.now();
      /* Shut, the gate does not time out: only a pick (or going back up) ends it. */
      if (!gateOpen) { lockTimer = window.setTimeout(release, 200); return; }
      if (now - lockedAt >= MAX_LOCK_MS || now - lastInput >= QUIET_MS) unlock();
      else lockTimer = window.setTimeout(release, 60);
    }
    function unlock() {
      if (!locked) return;
      locked = false;
      clearTimeout(lockTimer);
      window.removeEventListener('wheel', hold, CAPTURE);
      window.removeEventListener('touchmove', hold, CAPTURE);
      window.removeEventListener('touchstart', onTouchStart, LISTEN);
      window.removeEventListener('keydown', onKey, true);
    }
    function catchBeat() {
      var y = yAt(pA + (pB - pA) * BEAT_AT);
      snapTo(y);
      lock(y);
    }
    function watch(p: number) {
      if (p < pA - 0.004) armed = true;
      else if (p > pB) armed = false;
      /* p < 1: a jump to an anchor further down the page is not a walk. */
      if (armed && prevP < pA && p >= pA && p < 1 && performance.now() > quietUntil) {
        armed = false;
        catchBeat();
      }
      /* Momentum that outlives the finger: keep the page on the panel until
         the hold is over. Upward is let go. */
      if (locked) {
        if (window.scrollY > lockY + 2) { lastInput = performance.now(); snapTo(lockY); }
        else if (window.scrollY < lockY - 24) unlock();
      }
      /* The gate's backstop: whatever moved the page (a scrollbar drag, a
         key, a fling that began above the catch), it does not rest below the
         panel while the gate is shut. A page that OPENS below the doors — a
         restored scroll, a hash — is let through instead. */
      /* One pass only: above the panel again, the gate is shut again. */
      if (gateOpen && !gateFree && p < pA + (pB - pA) * BEAT_AT - 0.002 && performance.now() > quietUntil) { gateOpen = false; armed = armed || p < pA; }
      if (!gateOpen) {
        var now = performance.now();
        if (now < bootUntil) { if (p > pB) openGate('deep'); }
        else if (now > quietUntil) {
          var yL = yAt(pA + (pB - pA) * BEAT_AT);
          if (window.scrollY > yL + 2) { snapTo(yL); lock(yL); armed = false; nudge(); }
        }
      }
      prevP = p;
    }

    /* A scripted glide (Keep walking, Start here): no catch on the way. */
    function glide(y: number, seconds: number) {
      unlock();
      quietUntil = performance.now() + seconds * 1000 + 200;
      var l = lenisOf();
      if (l && typeof l.scrollTo === 'function') {
        l.scrollTo(y, { duration: seconds, force: true, easing: function (t: number) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; } });
      } else {
        window.scrollTo({ top: y, behavior: 'smooth' });
      }
    }
    onBtn.addEventListener('click', function () {
      if (!canGo) { nudge(); return; }
      openGate('button');
      armed = false;
      glide(yAt(pB + (1 - pB) * 0.12), 1.4);
    });
    hero.querySelector('[data-beat-go]')!.addEventListener('click', function (e) {
      e.preventDefault();
      armed = false;
      glide(yAt(pA + (pB - pA) * BEAT_AT), 2.4);
    });

    /* ---- the film: one seek in flight, three ways to settle ---- */
    var pending = false, watchdog = 0, ready = false, looping = false;
    function settle() { pending = false; clearTimeout(watchdog); }
    video.addEventListener('seeked', settle);
    function issueSeek(t: number) {
      pending = true;
      clearTimeout(watchdog);
      watchdog = window.setTimeout(settle, 220);
      if ('requestVideoFrameCallback' in video!) (video as any).requestVideoFrameCallback(settle);
      try { video!.currentTime = t; } catch (e) { settle(); }
    }
    /* Runs while the film is catching up with the scroll, then rests. */
    function tick() {
      if (!ready || failed) { looping = false; return; }
      eased += (target - eased) * 0.14;
      if (Math.abs(target - eased) < 0.002) eased = target;
      if (!pending && Math.abs(eased - video!.currentTime) > 1 / 48) issueSeek(eased);
      paint(progress());
      if (eased !== target || pending) requestAnimationFrame(tick);
      else looping = false;
    }
    function wake() {
      if (ready && !looping) { looping = true; requestAnimationFrame(tick); }
    }

    var raf = 0;
    function onScroll() {
      var p = progress();
      watch(p);
      target = timeFor(progress());
      /* Past the first screen the whole film is wanted. */
      if (video!.preload !== 'auto' && target > 0.15) video!.preload = 'auto';
      /* He is lazy-loaded, so ask for him while the walk is still running. */
      if (figure && p > pB && figure.loading === 'lazy') figure.loading = 'eager';
      if (ready) wake();
      else if (!raf) raf = requestAnimationFrame(function () { raf = 0; paint(progress()); });
    }
    function onResize() { measure(); onScroll(); }

    function arm() {
      if (ready || failed || !video!.duration) return;
      ready = true; filmOn = true;
      state('armed');
      st.setProperty('--film', '1');
      eased = target = timeFor(progress());
      issueSeek(eased);
      paint(progress());
      wake();
    }
    /* Nothing plays on load. Where a seek works on a film that has never
       played (desktop, Android), the first seek arms it and the scrub is ready
       before the visitor moves. iOS refuses that seek; there the film arms on
       the first scroll or touch — a muted play, paused the moment it
       resolves, which is the unlock Safari needs — still under the first-frame
       still, so nothing is seen to play. Refused outright (Low Power Mode):
       the alcove still carries the hero instead. */
    var primed = false, wantPrime = false;
    var PRIME_ON = ['scroll', 'touchstart', 'pointerdown', 'keydown', 'wheel'];
    function state(v: string) { hero!.dataset.film = v; }
    function tryArm() {
      if (ready || failed || !video!.duration) return;
      var landed = function () { video!.removeEventListener('seeked', landed); if (!ready && !failed) arm(); };
      video!.addEventListener('seeked', landed);
      try { video!.currentTime = 0.001; } catch (e) {}
      if (wantPrime) doPrime();
    }
    /* The first scroll or touch asks for the unlock; it happens once the film
       has its metadata (a play() before that can be refused for no lasting
       reason), and a refusal is only final when the browser says it will not
       play at all (NotAllowedError — iOS in Low Power Mode). Anything else, and
       the next scroll tries again. */
    function prime() {
      if (ready || failed) { PRIME_ON.forEach(function (t) { window.removeEventListener(t, prime); }); return; }
      wantPrime = true;
      if (video!.readyState >= 1) doPrime();
    }
    function doPrime() {
      if (primed || ready || failed) return;
      primed = true;
      var kick = video!.play();
      if (kick && kick.then) {
        kick.then(function () { video!.pause(); arm(); }).catch(function (err: any) {
          if (ready) return;
          if (err && err.name === 'NotAllowedError') {
            failed = true; filmOn = false;
            state('still:' + err.name);
            st.setProperty('--film', '0');
            paint(progress());
          } else {
            primed = false;
          }
        });
      } else {
        video!.pause();
        arm();
      }
    }
    PRIME_ON.forEach(function (t) { window.addEventListener(t, prime, { passive: true }); });
    /* Without the film the still carries the page: nothing to undo. */
    video.addEventListener('error', function () {
      failed = true; filmOn = false; ready = false;
      state('still:error');
      st.setProperty('--film', '0');
      paint(progress());
    });

    /* Two encodes of the same frames: a tighter one for phones. */
    var source = document.createElement('source');
    source.src = window.matchMedia('(max-width:600px)').matches ? '/video/rts-hero-v4-m.mp4' : '/video/rts-hero-v4.mp4';
    source.type = 'video/mp4';
    source.addEventListener('error', function () { video!.dispatchEvent(new Event('error')); });
    video.appendChild(source);
    video.load();
    if (video.readyState >= 1) tryArm();
    else video.addEventListener('loadedmetadata', tryArm, { once: true });

    /* Lenis (scripts/motion.ts) writes the scroll position on fine pointers
       and the browser fires a native scroll event for each write, so one
       listener serves both. ConsentBar dispatches resize when its height
       changes, which refits the panel. */
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    /* the photograph's box is only final once it has its picture */
    if (figure) figure.addEventListener('load', placeFlame);
    measure();
    prevP = progress();
    paint(prevP);
    onScroll();
    /* A link to /#for-you lands on the panel. */
    if (location.hash === '#for-you') { armed = false; snapTo(yAt(pA + (pB - pA) * BEAT_AT)); }
  })();
</script>
