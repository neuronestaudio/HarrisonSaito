---
/**
 * The hero — the walk, then the frame.
 *
 * Replaces RtsHero's three movements (the proof landing, the locked door, the
 * roll to the title card). Dion, 17 Sep 2026: keep the scroll through the
 * house, lose the door and the turn — "combine the parallax scroll with the
 * second half". Built first on the harrison-saito-morel template
 * (FrameHero.astro there); this is the same hero in this site's styles.
 *
 * Scroll scrubs the Return to Self film 0 → 15.0 s: the painted room, the
 * doors opening, the four-door room, the dolly to the alcove. A straight line
 * the whole way, no gate. It stops on the alcove frame, where the sharp still
 * dissolves in and the page arrives underneath. If the film cannot load — or
 * before it has — the still holds the screen and pushes in on scroll instead,
 * so the page is never blank and never stuck.
 *
 * The beat (Dion, 18 Sep 2026). Where the door and its VSL card used to be —
 * the four-door room with every door shut, frame 252 (8.42 s) — the walk
 * pauses and "Who this is for" comes up over the doors. It is a pause, not a
 * gate: the runway holds that frame for a stretch (--run-pause), so the film does
 * not move while the panel is up, and a scroll arriving from above is caught
 * there — snapped to the panel and held until the input goes quiet (LOCK_MS /
 * QUIET_MS, never past MAX_LOCK_MS) so a flick or a trackpad's inertia cannot
 * blow past it — then handed straight back. Scrolling on walks through; "Keep
 * walking" does the same. Nothing waits for a tap, and scrolling up is never
 * stopped. The capture-phase wheel/touchmove block is RtsHero's, not
 * lenis.stop(): .lenis-stopped puts overflow:hidden on <html>, which detaches
 * the sticky frame.
 *
 * One custom property, --p (0 at the top, 1 at the alcove), drives the copy,
 * the scrim and the rail; --beat (0–1) drives the panel. The runway is three
 * lengths in CSS (--run-in / --run-pause / --run-out, in vh) that the script reads
 * back, so the film time for a scroll position is piecewise: 0 → 8.42 s over
 * run-in, held over run-pause, 8.42 → 15.0 s over run-out. Seeks are eased with one in
 * flight and three ways to settle, and the iOS unlock is a muted play()
 * paused the moment it resolves (see RtsHero, kept in the tree).
 *
 * The panel is Morel markup (src/data/morel.ts, morel.css) inside a bare `.mo`
 * wrapper, scaled to fit whatever height is left between the nav and the
 * consent bar. Without script or with reduced motion it never shows, and
 * MorelHome renders the same block as a section instead.
 *
 * Assets (/video and /img ship with a one-year immutable cache, so a changed
 * file needs a new name):
 *   /video/rts-hero-v4.mp4, -m.mp4    — short-GOP H.264, 720p, 4.6 / 3.0 MB
 *   /img/rts-hero-poster-v3.webp      — the first frame
 *   /img/rts-still-v1-{768…2560}.webp — the 15.0 s frame, upscaled 2x
 */
import { srcset, src } from '../lib/images';
import { FOR_YOU_SECTION, FOR_YOU } from '../data/morel';
import { forYouIcon } from '../lib/morel-icons';
import '../styles/avant.css';
import '../styles/morel.css';
import '../styles/morel-overrides.css';

const STILL = 'rts-still-v1';
---

<section class="hero" id="hero" data-frame-hero data-section="hero" aria-label="Harrison Saito — Return to Self">
  <div class="hero__frame">
    <img class="hero__poster" src="/img/rts-hero-poster-v3.webp" alt="" aria-hidden="true" width="1280" height="720" fetchpriority="high" decoding="sync" />
    <video class="hero__film" muted playsinline preload="metadata"
           aria-label="A slow walk through a traditional Japanese house, arriving at an alcove with a hanging scroll."></video>
    <img
      class="hero__plate"
      src={src(STILL)}
      srcset={srcset(STILL) || undefined}
      sizes="100vw"
      alt="A traditional Japanese room, its sliding doors open onto an alcove with a hanging scroll"
      width="1920"
      height="1080"
      loading="eager"
      decoding="async"
    />
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__veil" aria-hidden="true"></div>

    <div class="hero__copy">
      <p class="hero__eyebrow">Harrison Saito · Men's coaching · Chatswood, Sydney</p>
      <h1 class="hero__title">Son of a <mark>Karate Grand Master</mark></h1>
      <p class="hero__sub">17+ Years Karate | Coach | Buddhist</p>
      <p class="hero__ctas">
        <a class="hero__btn" href="/book" data-track="cta_click" data-track-label="Hero — Book a discovery chat" data-track-section="hero">Book a discovery chat</a>
        <a class="hero__more" href="#for-you" data-beat-go>Not ready? Start here ↓</a>
      </p>
    </div>

    {/* The beat: "Who this is for", over the four shut doors. */}
    <div class="beat mo mo--bare" data-beat aria-hidden="true">
      <div class="beat__panel" role="region" aria-label={FOR_YOU_SECTION.label}>
        <header class="beat__head">
          <p class="eyebrow beat__eyebrow">{FOR_YOU_SECTION.label}</p>
          <h2 class="beat__title" set:html={FOR_YOU_SECTION.title} />
          <p class="beat__lede">{FOR_YOU_SECTION.lede}</p>
        </header>
        <div class="fy__grid beat__grid" data-stagger>
          {FOR_YOU.map((c) => (
            <article class="fy__card reveal beat__card">
              <Fragment set:html={forYouIcon(c.icon)} />
              <p>{c.text} <strong>{c.emphasis}</strong></p>
            </article>
          ))}
        </div>
        <p class="beat__foot">
          <a class="btn btn--filled btn--wide" href={FOR_YOU_SECTION.cta.href} data-track="cta_click" data-track-label="Beat — Book a discovery chat" data-track-section="hero-beat">{FOR_YOU_SECTION.cta.label}</a>
          <button class="beat__on" type="button" data-beat-on>Keep walking ↓</button>
        </p>
      </div>
    </div>

    <div class="hero__cue" aria-hidden="true"><span>Scroll to walk in</span><i></i></div>
    <div class="hero__rail" aria-hidden="true"><i></i></div>
  </div>
</section>

<style>
  /* The runway is the walk, in three lengths (vh): up to the shut doors, the
     pause on them, and on to the alcove. Same pace either side of the pause
     (about 21 vh per film second); the script reads these back. */
  .hero {
    --p: 0;
    --film: 0;                 /* 1 once the film is scrubbing; the poster yields to it */
    --run-in: 180;
    --run-pause: 120;
    --run-out: 140;
    --font-avant: 'Avant', 'ITC Avant Garde Gothic', 'Century Gothic', 'Jost', sans-serif;
    position: relative;
    height: calc((100 + var(--run-in) + var(--run-pause) + var(--run-out)) * 1vh);
    background: #14100d;
    color: #fcfaf8;
  }

  /* dvh, not svh — sized to the small viewport the frame stops short of the
     screen when Safari's toolbar collapses (RtsHero learned this on 11 Sep). */
  .hero__frame {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: #14100d;
  }

  /* Three plates on one axis. The doorway of room one and the alcove of room
     two both sit at plate x ≈ 43–44%, so one crop centre carries the whole
     walk on a portrait phone without any panning. */
  .hero__poster,
  .hero__film,
  .hero__plate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 44% 50%;
  }
  .hero__poster { z-index: 1; opacity: calc(1 - var(--film)); transition: opacity 0.5s ease; }
  .hero__film { z-index: 2; opacity: var(--film); transition: opacity 0.5s ease; }

  /* The still: the frame the walk ends on. While the film runs it fades in
     only over the last stretch (--hold), so the hand-over from the soft video
     frame to the sharp still is a dissolve, not a cut. Without the film it is
     the whole hero and pushes into the alcove on scroll. */
  .hero__plate {
    z-index: 3;
    opacity: var(--hold, 1);
    transform-origin: 44% 47%;
    transform: scale(calc(1 + var(--push, 0) * 0.34));
    will-change: transform, opacity;
  }

  /* For the nav and the copy; once they have gone the walk is lit by the
     room, with a quarter of the grade kept for grounding. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    opacity: clamp(0.25, calc(1 - var(--p) * 2.2), 1);
    background:
      linear-gradient(to bottom, rgba(20, 16, 13, 0.55) 0%, rgba(20, 16, 13, 0) 30%),
      linear-gradient(to top, rgba(20, 16, 13, 0.84) 0%, rgba(20, 16, 13, 0.4) 30%, rgba(20, 16, 13, 0) 58%);
  }
  /* Dims at the very end, as the page arrives over the alcove, and under the
     beat's panel while it is up. */
  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    background: #14100d;
    opacity: max(calc(var(--veil, 0) * 0.5), calc(var(--beat, 0) * 0.62));
    transition: opacity 0.35s ease;
  }

  .hero__copy {
    position: absolute;
    z-index: 5;
    left: clamp(1.25rem, 5vw, 5.5rem);
    right: clamp(1.25rem, 5vw, 5.5rem);
    /* --consent-h is published by ConsentBar.astro while the notice is up,
       so the buttons sit above it rather than under it. */
    bottom: calc(clamp(2.6rem, 9vh, 6.5rem) + var(--consent-h, 0px));
    max-width: 46rem;
    display: grid;
    gap: clamp(0.75rem, 2vw, 1.5rem);
    font-family: var(--font-avant);
    opacity: clamp(0, calc(1 - var(--p) * 9), 1);
    transform: translateY(calc(var(--p) * -300px));
    will-change: opacity, transform;
  }
  .hero__eyebrow {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #f2c275;
    margin: 0;
  }
  .hero__title {
    font-family: var(--font-avant);
    font-size: clamp(2.6rem, 1.4rem + 5.2vw, 5.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 0.92;
    text-transform: uppercase;
    color: #fcfaf8;
    margin: 0;
    text-wrap: balance;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.35);
  }
  .hero__title mark {
    background: linear-gradient(to bottom right, #f2c275 0%, #daa24f 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: #f2c275;
  }
  .hero__sub {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.4rem + 0.85vw, 2.15rem);
    font-weight: 500;
    line-height: 1.2;
    margin: 0;
    color: rgba(252, 250, 248, 0.92);
  }

  .hero__ctas {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(0.75rem, 2vw, 1.5rem) clamp(1rem, 2.5vw, 2rem);
    margin: clamp(0.5rem, 1.5vw, 1rem) 0 0;
  }
  /* The gold pill; the 2px ring shows on hover, drawn under a masked pseudo. */
  .hero__btn {
    position: relative;
    z-index: 1;
    display: inline-block;
    border-radius: 100px;
    padding: 0.65rem clamp(1.25rem, 4vw, 3rem) 0.5rem;
    background: linear-gradient(to right, #f2c275 0%, #daa24f 100%);
    color: #14100d;
    font-size: clamp(1rem, 0.94rem + 0.3vw, 1.25rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.6;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    transition: all 0.3s ease-in-out;
  }
  .hero__btn::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 2px;
    background: linear-gradient(to right, #f2c275 0%, #daa24f 100%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }
  .hero__btn:hover { background: #fff; color: #14100d; box-shadow: 0 5px 30px rgba(218, 162, 79, 0.4); }
  .hero__btn:hover::before { opacity: 1; }
  .hero__btn:focus-visible { outline: 2px solid #daa24f; outline-offset: 2px; }

  .hero__more {
    font-size: 1rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: underline;
    text-decoration-color: rgba(218, 162, 79, 0.6);
    text-underline-offset: 0.25em;
    white-space: nowrap;
  }
  .hero__more:hover { color: #fcfaf8; text-decoration-color: #daa24f; }

  /* The sign that the frame moves. Goes with the first scroll. */
  .hero__cue {
    position: absolute;
    z-index: 5;
    right: clamp(1.25rem, 5vw, 5.5rem);
    bottom: calc(clamp(2.6rem, 9vh, 6.5rem) + var(--consent-h, 0px));
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    font-family: var(--font-avant);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(252, 250, 248, 0.7);
    opacity: clamp(0, calc(1 - var(--p) * 30), 1);
  }
  .hero__cue i { display: block; width: 1px; height: 52px; background: rgba(255, 255, 255, 0.18); position: relative; overflow: hidden; }
  .hero__cue i::after {
    content: '';
    position: absolute;
    left: 0;
    top: -45%;
    width: 100%;
    height: 45%;
    background: #daa24f;
    animation: hero-cue 2.2s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }
  @keyframes hero-cue { 0% { top: -45%; } 60%, 100% { top: 100%; } }

  /* How far along the walk is — a hairline at the foot of the frame. */
  .hero__rail { position: absolute; z-index: 5; left: 0; right: 0; bottom: 0; height: 2px; background: rgba(255, 255, 255, 0.12); }
  .hero__rail i { display: block; height: 100%; width: calc(var(--p) * 100%); background: #daa24f; }

  /* ---- the beat -------------------------------------------------------
     Over the shut doors: Morel's "who this is for" cards on its page colour,
     in a panel the script scales (--beat-fit) to the height between the nav
     and the consent bar. Hidden until --beat rises; visibility, not opacity
     alone, so an invisible panel can never take a tap. */
  .hero .beat {
    position: absolute;
    inset: 0;
    z-index: 6;
    /* Flex, not grid: a grid track grows to a panel taller than the box and
       pins it to the top, so the fit-scale shrinks it off-centre. Flex
       centring overflows both ways, and the scale brings it back even. */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--beat-top, 84px) clamp(12px, 3vw, 40px) calc(clamp(14px, 3vh, 32px) + var(--consent-h, 0px));
    opacity: var(--beat, 0);
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }
  .hero--beat .beat { visibility: visible; pointer-events: auto; }
  .beat__panel {
    width: min(1120px, 100%);
    background: var(--bg3);
    color: var(--fg1);
    border-radius: 28px;
    padding: clamp(18px, 3vw, 40px);
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.5);
    transform: translateY(calc((1 - var(--beat, 0)) * 26px)) scale(var(--beat-fit, 1));
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .beat .beat__head { margin-bottom: clamp(14px, 2.2vw, 24px); }
  .beat .beat__eyebrow { margin: 0 0 6px; font-size: calc(var(--fs-md) * 1.02); }
  .beat__title {
    font-size: clamp(1.5rem, 0.9rem + 2.3vw, 2.9rem);
    line-height: 1;
    max-width: 24ch;
    margin: 0 0 10px;
    text-wrap: balance;
  }
  .beat__lede { margin: 0; color: var(--fg4); font-size: var(--fs-xs); max-width: 60ch; }
  .beat .beat__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .beat .beat__card {
    flex-direction: row;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
  }
  .beat__card :global(.fy__icon) { width: 36px; height: 36px; }
  .beat .beat__card p { font-size: clamp(0.88rem, 0.78rem + 0.36vw, 1.08rem); line-height: 1.22; }
  .beat__foot {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin: clamp(14px, 2.2vw, 24px) 0 0;
  }
  .beat__on {
    background: none;
    border: 0;
    padding: 6px 0;
    font: inherit;
    font-size: 1rem;
    font-weight: 500;
    color: var(--fg3);
    text-decoration: underline;
    text-decoration-color: rgba(176, 121, 50, 0.55);
    text-underline-offset: 0.25em;
    cursor: pointer;
  }
  .beat__on:hover { color: var(--fg1); text-decoration-color: var(--primary); }
  @media (max-width: 1000px) {
    .beat .beat__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .beat__panel { border-radius: 20px; }
    .beat__lede { display: none; }
    .beat .beat__grid { gap: 8px; }
    .beat .beat__card { flex-direction: column; align-items: flex-start; gap: 8px; padding: 12px; border-radius: 14px; }
    .beat__card :global(.fy__icon) { width: 28px; height: 28px; }
    .beat .beat__card p { font-size: 0.8rem; }
    .beat__foot .btn { width: 100%; }
  }

  @media (max-width: 700px) {
    .hero { --run-in: 146; --run-pause: 110; --run-out: 114; }
    .hero__copy { bottom: calc(clamp(3.2rem, 11vh, 6rem) + var(--consent-h, 0px)); }
    .hero__cue { display: none; }
    .hero__btn { width: 100%; }
  }

  /* No script, or no motion: the alcove frame only, everything on it. The
     beat's block is a section of the page instead (MorelHome). */
  :global(.no-js) .hero { height: 100svh; }
  :global(.no-js) .hero__film, :global(.no-js) .hero__poster, :global(.no-js) .beat { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .hero { height: 100svh; }
    .hero .beat { display: none; }
    .hero__film, .hero__poster, .hero__veil, .hero__rail { display: none; }
    .hero__plate { transform: none; opacity: 1; }
    .hero__copy { opacity: 1; transform: none; }
    .hero__cue { display: none; }
  }
</style>

<script>
  (function () {
    var hero = document.querySelector<HTMLElement>('[data-frame-hero]');
    var video = hero && hero.querySelector<HTMLVideoElement>('.hero__film');
    var beatEl = hero && hero.querySelector<HTMLElement>('[data-beat]');
    var panel = beatEl && beatEl.querySelector<HTMLElement>('.beat__panel');
    if (!hero || !video || !beatEl || !panel) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    /* The walk ends on the alcove: 15.0 s of a 19.33 s film. The still is that
       frame, so it dissolves in by film time — over the last quarter second,
       once the video shows the same picture — never by scroll alone, which
       would lay it over a frame the camera has not reached. */
    var T_END = 15.0, HOLD_FROM_T = 14.78;
    /* The beat: frame 252, the four-door room with every door shut — the
       frame RtsHero's door was held on. */
    var T_GATE = (252 + 0.5) / 30;
    var BEAT_AT = 0.3;     /* of the pause: where a caught scroll lands, panel fully up */
    var EDGE = 0.16;       /* of the pause: the panel fades in and out over this much */
    /* A caught scroll is held at least LOCK_MS, then until the input has been
       quiet for QUIET_MS — a trackpad's inertia keeps sending wheel events
       after the hand has gone — but never longer than MAX_LOCK_MS. */
    var LOCK_MS = 900, QUIET_MS = 260, MAX_LOCK_MS = 2500;
    var st = hero.style;
    var filmOn = false, failed = false;
    var cards = [].slice.call(beatEl.querySelectorAll('.beat__card')) as HTMLElement[];

    function clamp(v: number, a: number, b: number) { return v < a ? a : v > b ? b : v; }
    function runway() { return hero!.offsetHeight - window.innerHeight; }
    function heroTop() { return hero!.getBoundingClientRect().top + window.scrollY; }
    function progress() {
      var run = runway();
      return run > 0 ? clamp(-hero!.getBoundingClientRect().top / run, 0, 1) : 0;
    }
    function yAt(p: number) { return heroTop() + p * runway(); }
    function lenisOf(): any { return (window as any).lenis || null; }
    function snapTo(y: number) {
      var l = lenisOf();
      if (l && typeof l.scrollTo === 'function') l.scrollTo(y, { immediate: true, force: true });
      else window.scrollTo({ top: y, behavior: 'instant' as ScrollBehavior });
    }

    /* ---- the runway: three lengths read back from the CSS ---- */
    var pA = 0.41, pB = 0.68;
    function measure() {
      var cs = getComputedStyle(hero!);
      var a = parseFloat(cs.getPropertyValue('--run-in')) || 180;
      var h = parseFloat(cs.getPropertyValue('--run-pause')) || 120;
      var b = parseFloat(cs.getPropertyValue('--run-out')) || 140;
      pA = a / (a + h + b);
      pB = (a + h) / (a + h + b);
      fit();
    }
    function timeFor(p: number) {
      if (p <= pA) return (p / pA) * T_GATE;
      if (p <= pB) return T_GATE;
      return T_GATE + ((p - pB) / (1 - pB)) * (T_END - T_GATE);
    }
    function beatFor(p: number) {
      if (p <= pA || p >= pB) return 0;
      var e = (pB - pA) * EDGE;
      return Math.min(clamp((p - pA) / e, 0, 1), clamp((pB - p) / e, 0, 1));
    }

    /* ---- the panel: fitted between the nav and the consent bar ---- */
    function fit() {
      var nav = document.querySelector<HTMLElement>('[data-nav]');
      var top = (nav ? nav.offsetHeight : 72) + 8;
      var consent = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--consent-h')) || 0;
      var avail = window.innerHeight - top - consent - 28;
      var h = panel!.offsetHeight;   /* layout height — the scale does not change it */
      st.setProperty('--beat-top', top + 'px');
      st.setProperty('--beat-fit', (h > 0 ? clamp(avail / h, 0.5, 1) : 1).toFixed(3));
    }

    /* ---- paint: everything the page shows is a function of p ---- */
    var target = 0, eased = 0, beatOn = false, cardsIn = false;
    function paint(p: number) {
      st.setProperty('--p', p.toFixed(4));
      if (filmOn) {
        var still = clamp((eased - HOLD_FROM_T) / (T_END - HOLD_FROM_T), 0, 1);
        st.setProperty('--hold', still.toFixed(3));
        st.setProperty('--push', '0');
        st.setProperty('--veil', (still * still).toFixed(3));
      } else {
        st.setProperty('--hold', '1');
        st.setProperty('--push', p.toFixed(4));
        st.setProperty('--veil', p.toFixed(4));
      }
      var b = beatFor(p);
      st.setProperty('--beat', b.toFixed(3));
      var on = b > 0.02;
      if (on !== beatOn) {
        beatOn = on;
        hero!.classList.toggle('hero--beat', on);
        beatEl!.setAttribute('aria-hidden', on ? 'false' : 'true');
        if (on) fit();
      }
      /* The cards draw their marks in once, the first time the panel is up. */
      if (b > 0.4 && !cardsIn) {
        cardsIn = true;
        cards.forEach(function (c) { c.classList.add('is-in'); });
      }
    }

    /* ---- the catch: a scroll arriving from above stops on the panel ---- */
    var armed = true, prevP = 0, quietUntil = performance.now() + 700;
    var locked = false, lockTimer = 0, lockY = 0, touchY = -1, lockedAt = 0, lastInput = 0;
    var CAPTURE: AddEventListenerOptions = { passive: false, capture: true };
    var LISTEN: AddEventListenerOptions = { passive: true, capture: true };
    var DOWN_KEYS: Record<string, number> = { ' ': 1, PageDown: 1, ArrowDown: 1, End: 1 };

    /* Capture phase, so Lenis (bubble phase, on window) never sees a blocked
       wheel. Only downward movement is held — up is always free. */
    function hold(e: Event) {
      if (e.type === 'wheel') {
        var we = e as WheelEvent;
        if (we.deltaY < 0) { unlock(); return; }
      } else if (e.type === 'touchmove') {
        var t = (e as TouchEvent).touches[0];
        if (t && touchY >= 0 && t.clientY > touchY + 8) { unlock(); return; }   /* finger down = page up */
      }
      lastInput = performance.now();
      /* A touch scroll already under way cannot be cancelled (the browser
         says so in the console); the pin in watch() holds the page instead. */
      if (e.cancelable) e.preventDefault();
      e.stopImmediatePropagation();
    }
    function onTouchStart(e: TouchEvent) { touchY = e.touches[0] ? e.touches[0].clientY : -1; }
    function onKey(e: KeyboardEvent) {
      var el = e.target as HTMLElement | null;
      if (e.key === ' ' && el && el.closest('a,button,input,textarea,select')) return;
      if (DOWN_KEYS[e.key]) { lastInput = performance.now(); e.preventDefault(); }
    }
    function lock(y: number) {
      lockY = y;
      if (!locked) {
        locked = true;
        window.addEventListener('wheel', hold, CAPTURE);
        window.addEventListener('touchmove', hold, CAPTURE);
        window.addEventListener('touchstart', onTouchStart, LISTEN);
        window.addEventListener('keydown', onKey, true);
      }
      lockedAt = lastInput = performance.now();
      clearTimeout(lockTimer);
      lockTimer = window.setTimeout(release, LOCK_MS);
    }
    function release() {
      var now = performance.now();
      if (now - lockedAt >= MAX_LOCK_MS || now - lastInput >= QUIET_MS) unlock();
      else lockTimer = window.setTimeout(release, 60);
    }
    function unlock() {
      if (!locked) return;
      locked = false;
      clearTimeout(lockTimer);
      window.removeEventListener('wheel', hold, CAPTURE);
      window.removeEventListener('touchmove', hold, CAPTURE);
      window.removeEventListener('touchstart', onTouchStart, LISTEN);
      window.removeEventListener('keydown', onKey, true);
    }
    function catchBeat() {
      var y = yAt(pA + (pB - pA) * BEAT_AT);
      snapTo(y);
      lock(y);
    }
    function watch(p: number) {
      if (p < pA - 0.004) armed = true;
      else if (p > pB) armed = false;
      /* p < 1: a jump to an anchor further down the page is not a walk. */
      if (armed && prevP < pA && p >= pA && p < 1 && performance.now() > quietUntil) {
        armed = false;
        catchBeat();
      }
      /* Momentum that outlives the finger: keep the page on the panel until
         the hold is over. Upward is let go. */
      if (locked) {
        if (window.scrollY > lockY + 2) { lastInput = performance.now(); snapTo(lockY); }
        else if (window.scrollY < lockY - 24) unlock();
      }
      prevP = p;
    }

    /* A scripted glide (Keep walking, Start here): no catch on the way. */
    function glide(y: number, seconds: number) {
      unlock();
      quietUntil = performance.now() + seconds * 1000 + 200;
      var l = lenisOf();
      if (l && typeof l.scrollTo === 'function') {
        l.scrollTo(y, { duration: seconds, force: true, easing: function (t: number) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; } });
      } else {
        window.scrollTo({ top: y, behavior: 'smooth' });
      }
    }
    beatEl.querySelector('[data-beat-on]')!.addEventListener('click', function () {
      armed = false;
      glide(yAt(pB + (1 - pB) * 0.12), 1.4);
    });
    hero.querySelector('[data-beat-go]')!.addEventListener('click', function (e) {
      e.preventDefault();
      armed = false;
      glide(yAt(pA + (pB - pA) * BEAT_AT), 2.4);
    });

    /* ---- the film: one seek in flight, three ways to settle ---- */
    var pending = false, watchdog = 0, ready = false, looping = false;
    function settle() { pending = false; clearTimeout(watchdog); }
    video.addEventListener('seeked', settle);
    function issueSeek(t: number) {
      pending = true;
      clearTimeout(watchdog);
      watchdog = window.setTimeout(settle, 220);
      if ('requestVideoFrameCallback' in video!) (video as any).requestVideoFrameCallback(settle);
      try { video!.currentTime = t; } catch (e) { settle(); }
    }
    /* Runs while the film is catching up with the scroll, then rests. */
    function tick() {
      if (!ready || failed) { looping = false; return; }
      eased += (target - eased) * 0.14;
      if (Math.abs(target - eased) < 0.002) eased = target;
      if (!pending && Math.abs(eased - video!.currentTime) > 1 / 48) issueSeek(eased);
      paint(progress());
      if (eased !== target || pending) requestAnimationFrame(tick);
      else looping = false;
    }
    function wake() {
      if (ready && !looping) { looping = true; requestAnimationFrame(tick); }
    }

    var raf = 0;
    function onScroll() {
      var p = progress();
      watch(p);
      target = timeFor(progress());
      /* Past the first screen the whole film is wanted. */
      if (video!.preload !== 'auto' && target > 0.15) video!.preload = 'auto';
      if (ready) wake();
      else if (!raf) raf = requestAnimationFrame(function () { raf = 0; paint(progress()); });
    }
    function onResize() { measure(); onScroll(); }

    function arm() {
      if (ready || failed || !video!.duration) return;
      ready = true; filmOn = true;
      st.setProperty('--film', '1');
      eased = target = timeFor(progress());
      issueSeek(eased);
      paint(progress());
      wake();
    }
    /* Metadata first, THEN the iOS unlock (Safari refuses currentTime on an
       element that has never played), THEN arm the scrub. */
    function unlockThenArm() {
      var kick = video!.play();
      if (kick && kick.then) kick.then(function () { video!.pause(); arm(); }).catch(arm);
      else arm();
    }
    /* Without the film the still carries the page: nothing to undo. */
    video.addEventListener('error', function () {
      failed = true; filmOn = false; ready = false;
      st.setProperty('--film', '0');
      paint(progress());
    });

    /* Two encodes of the same frames: a tighter one for phones. */
    var source = document.createElement('source');
    source.src = window.matchMedia('(max-width:600px)').matches ? '/video/rts-hero-v4-m.mp4' : '/video/rts-hero-v4.mp4';
    source.type = 'video/mp4';
    source.addEventListener('error', function () { video!.dispatchEvent(new Event('error')); });
    video.appendChild(source);
    video.load();
    if (video.readyState >= 1) unlockThenArm();
    else video.addEventListener('loadedmetadata', unlockThenArm, { once: true });

    /* Lenis (scripts/motion.ts) writes the scroll position on fine pointers
       and the browser fires a native scroll event for each write, so one
       listener serves both. ConsentBar dispatches resize when its height
       changes, which refits the panel. */
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    measure();
    prevP = progress();
    paint(prevP);
    onScroll();
    /* A link to /#for-you lands on the panel. */
    if (location.hash === '#for-you') { armed = false; snapTo(yAt(pA + (pB - pA) * BEAT_AT)); }
  })();
</script>
