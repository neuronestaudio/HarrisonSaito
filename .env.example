# Copy to .env for local dev. In production set these in the host's dashboard
# (Cloudflare Pages > Settings > Environment variables) — never commit real IDs.
#
# Everything here is optional. With nothing set, the site builds and runs
# clean: no tags load, no consent bar renders, and the lead endpoint still
# accepts submissions.

# --- Client-side (PUBLIC_ prefix is required for Astro to expose these) -----

# Google Tag Manager container. When set, GTM becomes the container of record
# and GA4 is expected to fire through it rather than directly.
PUBLIC_GTM_ID=

# GA4 measurement ID. Only loaded directly when GTM is absent.
PUBLIC_GA4_ID=

# Meta Pixel ID. Loads on first interaction so it never competes with LCP.
PUBLIC_META_PIXEL_ID=

# Where forms POST. Defaults to /api/lead (the bundled Pages Function).
# Point it at Formspree / n8n / Make / a CRM webhook to bypass the function.
PUBLIC_FORM_ENDPOINT=

# Cal.com or Calendly embed URL. When set, /book renders the calendar instead
# of the request form.
PUBLIC_BOOKING_URL=

# --- Server-side, for functions/api/lead.ts --------------------------------
# These are NOT exposed to the browser. Set them as secrets in the host.

# Meta Conversions API — the server half of the Pixel pair. Both are needed.
META_PIXEL_ID=
META_CAPI_TOKEN=

# Optional: shows events in Meta Events Manager > Test Events. Remove for prod.
TEST_EVENT_CODE=

# Where leads are forwarded (CRM, n8n, Make, Zapier).
LEAD_WEBHOOK_URL=

# Email notification via Resend. Both are needed for email to send.
RESEND_API_KEY=
LEAD_NOTIFY_TO=hello@harrisonsaito.com.au
